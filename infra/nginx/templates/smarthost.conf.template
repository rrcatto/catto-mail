# Rendered by the official nginx entrypoint (envsubst of ${VAR}s present in the
# environment). Variables: PROXY_SERVER_NAME, PROXY_FASTCGI_ADDRESS,
# PROXY_TLS_CERT_FILE, PROXY_TLS_KEY_FILE (docs/contracts/environment.md) and
# NGINX_LOCAL_RESOLVERS (set by the image when NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1).
server_tokens off;

# Tracking URLs (/t/o/<token>.gif, /t/c/<token>/<n>), re-permission pages (/p/<token>)
# and dashboard sign-in links (/dashboard/login/verify?token=...) carry opaque secrets.
# The access log records them redacted, query string dropped (Phase 6, specification 2.11:
# tokens are never logged).
map $request_uri $smarthost_log_uri {
    ~^/t/o/                                       "/t/o/[token].gif";
    ~^/t/c/[^/?]*/(?<smarthost_link_index>[0-9]+)  "/t/c/[token]/$smarthost_link_index";
    ~^/t/                                         "/t/[redacted]";
    ~^/p/                                         "/p/[token]";
    ~^/dashboard/login/verify                     "/dashboard/login/verify?[token]";
    default                                       $request_uri;
}
log_format smarthost '$remote_addr - $remote_user [$time_local] "$request_method $smarthost_log_uri $server_protocol" '
                     '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 443 ssl;
    http2 on;
    server_name ${PROXY_SERVER_NAME};
    access_log /var/log/nginx/access.log smarthost;

    ssl_certificate     ${PROXY_TLS_CERT_FILE};
    ssl_certificate_key ${PROXY_TLS_KEY_FILE};
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Resolve the PHP-FPM container at request time so a restarted container
    # (new IP) is picked up without restarting nginx.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $smarthost_fpm ${PROXY_FASTCGI_ADDRESS};

    # The application enforces the API body limit (APP_API_MAX_REQUEST_BYTES,
    # 10 MiB, RFC 9457 413). nginx admits a little more so that the application
    # answers, and refuses anything beyond with the same problem shape.
    client_max_body_size 12m;
    error_page 413 = @payload_too_large;
    location @payload_too_large {
        default_type application/problem+json;
        return 413 '{"type":"about:blank","title":"Payload too large","status":413}';
    }

    # Every request goes to the Symfony front controller (API, health, dashboard,
    # dashboard assets and tracking endpoints). There is no separate PHP HTTP server.
    location / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /srv/app/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /srv/app/public;
        fastcgi_pass $smarthost_fpm;
        fastcgi_read_timeout 120s;
    }
}

# Container-local readiness endpoint for the health check. It binds to the
# container's loopback only and is never published.
server {
    listen 127.0.0.1:8080;
    access_log off;
    location = /nginx-health { return 200 "ok\n"; }
    location / { return 404; }
}
