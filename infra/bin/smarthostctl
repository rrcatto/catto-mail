#!/usr/bin/env bash
# smarthostctl — Smarthost rootless Podman development environment.
#
# The `smarthost` pod and its containers are persistent Podman objects (D-35):
# created once, then started and stopped like any pod in Podman Desktop. Only
# `recreate`/`remove` replace them, and only `destroy-volumes --yes` deletes data.
#
# Container operations use the normal `podman` CLI (local or podman-remote) and
# the rendered pod script (infra/.generated/podman/smarthost-pod.sh). systemd
# operations run where the Podman engine's systemd user manager lives: locally
# on a Linux host, or inside the Podman machine on WSL (entered with the
# machine's own /usr/local/bin/enterns, as `podman machine ssh` does).
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
GEN="$REPO/infra/.generated"
HELPER="$REPO/infra/bin/smarthost-machine-helper.sh"
PODSH="$GEN/podman/smarthost-pod.sh"
RENDER="python3 $REPO/infra/lib/smarthost_render.py"
IMAGES=(
  "localhost/smarthost-postfix:dev|postfix"
  "localhost/smarthost-opendkim:dev|opendkim"
  "localhost/smarthost-app:dev|.|app/Containerfile|runtime"
  "localhost/smarthost-nginx:dev|infra/nginx"
  "localhost/smarthost-validator:dev|.|validator/Containerfile|runtime"
  "localhost/smarthost-delivery:dev|.|delivery/Containerfile|runtime"
  "localhost/smarthost-fake-smtp:dev|tests/fake-smtp"
)
VOLUMES=(smarthost-postgres-data smarthost-postfix-queue smarthost-postfix-observability smarthost-dsn-spool smarthost-opendkim-keys smarthost-opendkim-tables)
DEV_DKIM_DOMAIN="smarthost-dev.test"   # RFC 2606 reserved: disposable test domain
DEV_DKIM_SELECTOR="phase1"

die() { echo "smarthostctl: $*" >&2; exit 1; }
envval() { grep -E "^$1=" "$REPO/infra/.env" | head -n1 | cut -d= -f2-; }

# Run the helper inside the engine's systemd namespace.
machine() {
  if [[ "$(podman info --format '{{.Host.ServiceIsRemote}}')" != "true" ]]; then
    "$HELPER" "$@"; return
  fi
  local wsl=/mnt/c/Windows/System32/wsl.exe uri name user
  [[ -x "$wsl" ]] || die "remote Podman engine is not a WSL Podman machine; run systemd steps on the engine host"
  uri="$(podman system connection list --format '{{if .Default}}{{.URI}}{{end}}' | grep -v '^$' | head -n1)"
  name="$(sed -E 's#.*/podman-sockets/([^/]+)/.*#\1#' <<<"$uri")"
  user="$(podman info --format '{{.Store.GraphRoot}}' | sed -E 's#^/home/([^/]+)/.*#\1#')"
  "$wsl" -d "$name" -u "$user" --cd / -- /usr/local/bin/enterns "$HELPER" "$@"
}

pod() { [[ -x "$PODSH" ]] || die "$PODSH missing: run 'smarthostctl render' (or install)"; "$PODSH" "$@"; }
unit_active() { [[ "$(machine systemctl is-active smarthost.service 2>/dev/null)" == active ]]; }

# start: ordered start of the existing pod (PostgreSQL, DB tasks, all services,
# health). Through smarthost.service when that unit is inactive, so systemd also
# stops the pod cleanly at machine shutdown; directly when the unit is already
# active (the pod was stopped outside systemd, e.g. from Podman Desktop).
cmd_start() {
  pod exists || die "pod smarthost does not exist: run 'smarthostctl install' (or 'create')"
  if unit_active; then
    pod start
  elif machine systemctl start smarthost.service; then
    machine journal -u smarthost.service -n 8 -o cat | grep 'smarthost-pod:' | tail -n 3 || true
  else
    machine journal -u smarthost.service -n 40 -o cat >&2; die "start failed"
  fi
}

# stop: `podman pod stop` through the unit's ExecStop, then directly in case the
# pod was started outside systemd. Never removes anything.
cmd_stop() {
  machine systemctl stop smarthost.service smarthost-postfix-queue-snapshot.timer smarthost-postfix-logrotate.timer 2>/dev/null || true
  pod stop
}

cmd_status() {
  echo "smarthost.service: $(machine systemctl is-active smarthost.service 2>/dev/null || true) (boot: $(machine systemctl show -p WantedBy --value smarthost.service 2>/dev/null))"
  podman pod ps --filter name='^smarthost$' --format 'pod {{.Name}} {{.Id}} {{.Status}}'
  podman ps -a --filter pod=smarthost --format '{{.Names}}\t{{.ID}}\t{{.Status}}' | sort
}

# IMAGES entries: tag|context[|containerfile|target] (paths relative to the repository).
cmd_build() {
  local tag ctx file target args
  for entry in "${IMAGES[@]}"; do
    IFS='|' read -r tag ctx file target <<<"$entry"
    args=(-q -t "$tag")
    [[ -n "$file" ]] && args+=(-f "$REPO/$file")
    [[ -n "$target" ]] && args+=(--target "$target")
    podman build "${args[@]}" "$REPO/$ctx" >/dev/null && echo "built $tag"
  done
}

cmd_secrets() {
  local tls="$GEN/tls" pf proxy
  mkdir -p "$tls"; chmod 700 "$GEN" "$tls"
  pf="$(envval POSTFIX_MYHOSTNAME)"; proxy="$(envval PROXY_SERVER_NAME)"
  # Disposable self-signed development certificates (never production material).
  podman run --rm --entrypoint sh -v "$tls:/tls" localhost/smarthost-postfix:dev -c "
    openssl req -x509 -newkey rsa:2048 -nodes -days 825 -subj '/CN=$pf' -addext 'subjectAltName=DNS:$pf,DNS:postfix' \
      -keyout /tls/postfix.key -out /tls/postfix.crt 2>/dev/null &&
    openssl req -x509 -newkey rsa:2048 -nodes -days 825 -subj '/CN=$proxy' -addext 'subjectAltName=DNS:$proxy,DNS:localhost,IP:127.0.0.1' \
      -keyout /tls/proxy.key -out /tls/proxy.crt 2>/dev/null"
  for s in postfix-tls-cert:postfix.crt postfix-tls-key:postfix.key proxy-tls-cert:proxy.crt proxy-tls-key:proxy.key; do
    podman secret rm "smarthost-${s%%:*}" >/dev/null 2>&1 || true
    podman secret create "smarthost-${s%%:*}" "$tls/${s#*:}" >/dev/null && echo "secret smarthost-${s%%:*}"
  done
}

cmd_dkim_dev_key() {
  local domain="${1:-$DEV_DKIM_DOMAIN}" selector="${2:-$DEV_DKIM_SELECTOR}"
  # Create the volumes with the project label (same as the Quadlet volume units) if missing.
  podman volume create --ignore --label project=smarthost smarthost-opendkim-keys >/dev/null
  podman volume create --ignore --label project=smarthost smarthost-opendkim-tables >/dev/null
  podman run --rm --env-file "$GEN/env/opendkim.env" \
    -v smarthost-opendkim-keys:"$(envval OPENDKIM_KEY_DIR)" -v smarthost-opendkim-tables:"$(envval OPENDKIM_TABLES_DIR)" \
    --entrypoint smarthost-dkim-dev-key localhost/smarthost-opendkim:dev "$domain" "$selector"
}

usage() {
  cat <<USAGE
usage: smarthostctl <command>
  init-env          create infra/.env with random development secrets (never overwrites)
  render            render per-service env files, the pod script and systemd units into infra/.generated/
  build             build all Smarthost images
  secrets           create disposable development TLS certificates as Podman secrets
  install           render, install the systemd units (start at boot) and create the pod if missing
  create            create the persistent pod and its containers (fails if the pod exists)
  dkim-dev-key [domain selector]   generate a DISPOSABLE dev DKIM key inside the OpenDKIM volume
  start             start the existing pod: PostgreSQL, DB tasks (roles, migrations, grants), services
  stop              stop the pod; the pod and its containers are KEPT (podman pod stop)
  restart           stop + start of the same pod and containers
  recreate          replace the pod and containers from the current images/configuration, keep the
                    volumes, start and wait for health (use after 'build' or definition changes)
  remove            stop and remove the pod and its containers; volumes are kept
  status            unit state, pod and containers (IDs and status)
  systemctl <args>  pass-through to systemctl --user on the Podman engine host
  logs <name> [n]   container log (e.g. postfix), or journal of a unit (e.g. smarthost.service)
  uninstall         remove the systemd units; the pod, containers and volumes are untouched
  destroy-volumes --yes            delete all Smarthost volumes (DATA LOSS; requires 'remove' first)
  verify [--clean]  run the Phase 1 verification suite
  test [phase2|phase3|phase4|phase5] [args]   run a suite in a throwaway, network-less pod:
                    Phase 2 (PHPUnit), Phase 3 (pytest + end to end), Phase 4/5 (the Go unit and
                    PostgreSQL integration suite: delivery, DSNs, suppression policy); without a
                    phase, all of them
  test phase4-e2e [A B C D E]      Phase 4 end to end against the RUNNING pod (Postfix,
                    OpenDKIM, Mailpit): headers/DKIM, OpenDKIM down, deferral, crash, 10,000
  test phase5-e2e [A B C D E F G]  Phase 5 end to end against the RUNNING pod: DSNs and ARF
                    complaints through Postfix :25 and the spool, global suppression across
                    clients, opt-out API, correlation, operator workflow, crash, retention
  test phase6-e2e   Phase 6 end to end against the RUNNING pod through nginx: tracking pixel and
                    click redirect from a delivered message, open-redirect attempts, dashboards
                    (login, tenant isolation, operator area, DSN/suppression actions), token-free logs
  test phase7-e2e   Phase 7 end to end against the RUNNING pod: an external client (public API and
                    signed webhooks only) with a local webhook receiver: validation, batched send,
                    tracking, bounce/complaint webhooks, retries, worker crash, polling, SSRF
  console <args>    run a Symfony console command in the running app container (as www-data),
                    e.g. console smarthost:dev:bootstrap
  migrate           re-run Doctrine migrations and then the infrastructure grants
USAGE
}

case "${1:-}" in
  init-env) $RENDER init-env ;;
  render) $RENDER render ;;
  build) cmd_build ;;
  secrets) cmd_secrets ;;
  install)
    $RENDER render && machine install
    if pod exists; then echo "pod smarthost exists (kept; use 'recreate' to replace it)"; else pod create; fi ;;
  create) $RENDER render && pod create ;;
  dkim-dev-key) shift; cmd_dkim_dev_key "$@" ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop && cmd_start ;;
  recreate) $RENDER render && cmd_stop && pod remove && pod create && cmd_start && cmd_status ;;
  remove) cmd_stop && pod remove ;;
  status) cmd_status ;;
  logs)
    case "${2:?name}" in
      *.service|*.timer) machine journal -u "$2" -n "${3:-100}" ;;
      *) podman logs --tail "${3:-100}" "smarthost-${2#smarthost-}" ;;
    esac ;;
  systemctl) shift; machine systemctl "$@" ;;
  uninstall) machine uninstall ;;
  destroy-volumes)
    [[ "${2:-}" == "--yes" ]] || die "refusing without --yes (deletes PostgreSQL, Postfix queue, spool and DKIM volumes)"
    ! podman pod exists smarthost || die "the smarthost pod still uses the volumes: run 'smarthostctl remove' first"
    for v in "${VOLUMES[@]}"; do podman volume rm "$v" >/dev/null 2>&1 && echo "removed $v" || true; done ;;
  verify) shift; exec "$REPO/infra/tests/phase1-verify.sh" "$@" ;;
  test)
    shift
    case "${1:-all}" in
      phase2) shift; exec "$REPO/infra/tests/phase2-test.sh" "$@" ;;
      phase3) shift; exec "$REPO/infra/tests/phase3-test.sh" "$@" ;;
      phase4|phase5) shift; exec "$REPO/infra/tests/phase4-test.sh" "$@" ;;
      phase4-e2e) shift; exec "$REPO/infra/tests/phase4-e2e.sh" "$@" ;;
      phase5-e2e) shift; exec "$REPO/infra/tests/phase5-e2e.sh" "$@" ;;
      phase6-e2e) shift; exec "$REPO/infra/tests/phase6-e2e.sh" "$@" ;;
      phase7-e2e) shift; exec "$REPO/infra/tests/phase7-e2e.sh" "$@" ;;
      all) "$REPO/infra/tests/phase2-test.sh" && "$REPO/infra/tests/phase3-test.sh" && exec "$REPO/infra/tests/phase4-test.sh" ;;
      *) die "test: expected phase2, phase3, phase4, phase5, phase4-e2e, phase5-e2e, phase6-e2e, phase7-e2e or nothing" ;;
    esac ;;
  console) shift; exec podman exec -i -u www-data smarthost-symfony-app php bin/console "$@" ;;
  migrate) pod tasks db-migrate db-grants ;;
  *) usage; exit 64 ;;
esac
