#!/usr/bin/env bash
# smarthostctl prod — catto-mail PRODUCTION operations (Phase 8, specification 2.9).
#
# Invoked as `infra/bin/smarthostctl prod <command>`. Every command requires
# SMARTHOST_ENV=production in the configuration; the development commands of
# smarthostctl refuse it, so the two cannot be mixed up. The topology is the
# rendered infra/.generated/podman/smarthost-production.sh (persistent containers on
# internal, ingress and egress networks; docs/production/README.md). nginx runs under
# the socket-activated <instance>-ingress.socket/.service, which keeps client
# addresses. Runbook: docs/production/runbook.md.
#
# Tool locations (not service configuration, so not in the .env): SMARTHOST_DOTENV
# (default infra/.env) and SMARTHOST_GENERATED (default infra/.generated) select
# another configuration, e.g. for the local production rehearsal.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# `sudo -iu cattomail` starts no login session: use the service user's own systemd and Podman
# runtime directory (lingering keeps them running) all the same.
if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "/run/user/$UID" ]]; then
  export XDG_RUNTIME_DIR="/run/user/$UID"
  export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
fi
export SMARTHOST_DOTENV="${SMARTHOST_DOTENV:-$REPO/infra/.env}"
export SMARTHOST_GENERATED="${SMARTHOST_GENERATED:-$REPO/infra/.generated}"
DOTENV="$SMARTHOST_DOTENV"
GEN="$SMARTHOST_GENERATED"
RENDER=(python3 "$REPO/infra/lib/smarthost_render.py")
PREFLIGHT=(python3 "$REPO/infra/lib/smarthost_preflight.py")
SEEDTEST=(python3 "$REPO/infra/lib/smarthost_seedtest.py")
AGENT=(python3 "$REPO/infra/lib/smarthost_agent.py")
TOPO="$GEN/podman/smarthost-production.sh"
HELPER="$REPO/infra/bin/smarthost-machine-helper.sh"
# image name | build context | Containerfile | target (no Mailpit/fake SMTP in production)
IMAGES=(
  "postfix|postfix||"
  "opendkim|opendkim||"
  "app|.|app/Containerfile|runtime"
  "nginx|infra/nginx||"
  "validator|.|validator/Containerfile|runtime"
  "delivery|.|delivery/Containerfile|runtime"
)
SERVICES=(postgres opendkim postfix symfony-app webhook-worker nginx validator delivery)

die() { echo "smarthostctl prod: $*" >&2; exit 1; }
say() { echo "smarthostctl prod: $*"; }
# A setting's value: the .env's, else the built-in one (docs/contracts/environment.md).
envval() { [[ -f "$DOTENV" ]] || die "$DOTENV missing (smarthostctl prod init-env)"; "${RENDER[@]}" get "$1" --env "$DOTENV"; }
I() { envval SMARTHOST_INSTANCE; }
require_production() {
  [[ "$(envval SMARTHOST_ENV)" == production ]] || die "$DOTENV is not a production configuration (SMARTHOST_ENV=$(envval SMARTHOST_ENV)); use the development commands of smarthostctl"
}
# The settings changed in the dashboard (System › Settings) from the running database, kept in
# $GEN/overrides.json; when PostgreSQL is not running the last copy is used.
fetch_overrides() {
  local out
  mkdir -p "$GEN"
  if out="$(podman exec "$(I)-postgres" psql -X -At -U "$(envval POSTGRES_USER)" -d "$(envval SMARTHOST_DB_NAME)" \
      -c "SELECT coalesce(json_object_agg(name, value), '{}') FROM setting_overrides" 2>/dev/null)" && [[ "$out" == \{* ]]; then
    printf '%s\n' "$out" > "$GEN/overrides.json"
  fi
}
render() { fetch_overrides; "${RENDER[@]}" render --env "$DOTENV" --out "$GEN" --overrides "$GEN/overrides.json" >/dev/null; }
topo() { [[ -x "$TOPO" ]] || render; "$TOPO" "$@"; }
default_instance() { [[ "$(I)" == smarthost && "$GEN" == "$REPO/infra/.generated" ]]; }
# The engine is local when Podman runs on this host. The production units (host agent, backup,
# certificate renewal) talk to the user's own API socket on purpose (CONTAINER_HOST, so the
# containers they restart do not belong to the unit's cgroup); Podman then calls itself remote,
# but that socket is this host's.
local_engine() {
  [[ -n "${XDG_RUNTIME_DIR:-}" && "${CONTAINER_HOST:-}" == "unix://$XDG_RUNTIME_DIR/podman/podman.sock" ]] && return 0
  [[ "$(podman info --format '{{.Host.ServiceIsRemote}}')" != true ]]
}
units_installed() { default_instance && local_engine && [[ -e "$HOME/.local/share/systemd/user/smarthost.service" ]]; }

# Run the machine helper in the Podman engine host's systemd namespace: directly on
# the production host, or inside the WSL Podman machine (the local rehearsal), as
# smarthostctl does for the development pod.
machine() {
  if local_engine; then "$HELPER" "$@"; return; fi
  local wsl=/mnt/c/Windows/System32/wsl.exe uri name user
  [[ -x "$wsl" ]] || die "remote Podman engine is not a WSL Podman machine; run smarthostctl prod on the engine host"
  uri="$(podman system connection list --format '{{if .Default}}{{.URI}}{{end}}' | grep -m1 -v '^$')"
  name="$(sed -E 's#.*/podman-sockets/([^/]+)/.*#\1#' <<<"$uri")"
  user="$(podman info --format '{{.Store.GraphRoot}}' | sed -E 's#^/home/([^/]+)/.*#\1#')"
  "$wsl" -d "$name" -u "$user" --cd / -- /usr/local/bin/enterns "$HELPER" "$@"
}
# The topology script starts nginx through systemd (the ingress units); on a remote
# engine it reaches the engine host's systemd through this command (tool location).
if [[ "${1:-}" != machine ]] && ! local_engine 2>/dev/null; then export SMARTHOST_HOSTCTL="$REPO/infra/bin/smarthostctl-prod"; fi

# Host bootstrap prerequisites (runbook §1), checked before containers are created
# or started: rootless binding of the ingress ports, lingering, Podman.
host_gate() {
  "${PREFLIGHT[@]}" --section host --quiet \
    || die "the host prerequisites above are not met (runbook §1); nothing was created or started"
}
console() { podman exec -i -u www-data "$(I)-symfony-app" php bin/console "$@"; }
psql_admin() { podman exec -i "$(I)-postgres" psql -X -v ON_ERROR_STOP=1 -U "$(envval POSTGRES_USER)" -d "$(envval SMARTHOST_DB_NAME)" "$@"; }

# Set KEY=VALUE in the .env in place (keeps its mode and every other line); a built-in setting
# that the file does not name yet is added at the end.
set_env() {
  local key="$1" value="$2"
  "${RENDER[@]}" get "$key" --env "$DOTENV" >/dev/null || die "$key is not a catto-mail setting"
  python3 - "$DOTENV" "$key" "$value" <<'PY'
import re, sys
path, key, value = sys.argv[1:]
text = open(path, encoding="utf-8").read()
text, n = re.subn(rf"^{re.escape(key)}=.*$", lambda m: f"{key}={value}", text, count=1, flags=re.M)
if n == 0:
    text = text.rstrip("\n") + f"\n{key}={value}\n"
open(path, "w", encoding="utf-8").write(text)
PY
}

# The operator (--operator EMAIL --note TEXT) is audited before any installation-wide control.
parse_operator() {
  OPERATOR=""; NOTE=""
  while (($#)); do
    case "$1" in
      --operator) OPERATOR="${2:-}"; shift 2 ;;
      --note) NOTE="${2:-}"; shift 2 ;;
      *) die "unexpected argument $1 (expected --operator EMAIL --note TEXT)" ;;
    esac
  done
  [[ -n "$OPERATOR" && -n "$NOTE" ]] || die "--operator <login email with SYSTEM.DELIVERY.CONTROL> and --note <why> are required"
}
audit() { console smarthost:ops:record "$1" --operator "$OPERATOR" --note "$NOTE" || die "not audited; nothing was changed"; }

# ------------------------------------------------------------------- lifecycle
cmd_build() {
  local tag name ctx file target args pg
  tag="$(envval SMARTHOST_IMAGE_TAG)"
  [[ -n "$tag" ]] || die "SMARTHOST_IMAGE_TAG is empty"
  for entry in "${IMAGES[@]}"; do
    IFS='|' read -r name ctx file target <<<"$entry"
    args=(-q -t "localhost/smarthost-$name:$tag" --label "org.catto-mail.version=$tag")
    [[ -n "$file" ]] && args+=(-f "$REPO/$file")
    [[ -n "$target" ]] && args+=(--target "$target")
    podman build "${args[@]}" "$REPO/$ctx" >/dev/null && echo "built localhost/smarthost-$name:$tag"
  done
  # The topology runs PostgreSQL from its pinned upstream image and creates every container with
  # --pull never, so a new host fetches it here, explicitly (the tag is the topology's own).
  pg="$(sed -n 's/^PG_IMAGE=//p' "$REPO/infra/podman/smarthost-production.sh.in")"
  [[ -n "$pg" ]] || die "PG_IMAGE not found in the production topology"
  if podman image exists "$pg"; then echo "present $pg"; else podman pull -q "$pg" >/dev/null && echo "pulled $pg"; fi
}

# Live delivery may only be (re)created after the activation preflight passes.
activation_gate() {
  if [[ "$(envval SMARTHOST_LIVE_DELIVERY_ENABLED)" == true ]]; then
    "${PREFLIGHT[@]}" --activation --quiet || die "the activation preflight failed: live delivery is not (re)created (fix the FAIL items, or set SMARTHOST_LIVE_DELIVERY_ENABLED=false)"
  fi
}

cmd_install() {
  require_production
  "${RENDER[@]}" check --env "$DOTENV"
  render
  host_gate
  if default_instance; then
    local_engine || die "production units are installed on the Linux production host (this Podman engine is remote)"
    "$HELPER" install
    loginctl show-user "$(id -un)" -p Linger 2>/dev/null | grep -q 'Linger=yes' \
      || echo "smarthostctl prod: WARNING: lingering is off; run 'sudo loginctl enable-linger $(id -un)' so the services start at boot"
  else
    machine instance-install "$GEN" "$(I)"
    say "instance $(I): only its own units (ingress, reputation timer) are installed (smarthost.service and the Postfix timers belong to the default instance 'smarthost')"
  fi
  if topo exists; then say "production containers exist (kept; use 'recreate' to replace them)"; else activation_gate; topo create; fi
}

cmd_start() {
  host_gate
  if units_installed && [[ "$(systemctl --user is-active smarthost.service 2>/dev/null || true)" != active ]]; then
    systemctl --user start smarthost.service || { journalctl --user -u smarthost.service -n 40 --no-pager >&2; die "start failed"; }
    journalctl --user -u smarthost.service -n 6 -o cat --no-pager | grep 'smarthost-production:' | tail -n 3 || true
  else
    topo start
  fi
}

cmd_stop() {
  if units_installed; then systemctl --user stop smarthost.service smarthost-postfix-queue-snapshot.timer smarthost-postfix-logrotate.timer 2>/dev/null || true; fi
  topo stop
}

cmd_status() {
  local i; i="$(I)"
  if units_installed; then echo "smarthost.service: $(systemctl --user is-active smarthost.service 2>/dev/null || true)"; fi
  echo "instance $i, images :$(envval SMARTHOST_IMAGE_TAG), live delivery $(envval SMARTHOST_LIVE_DELIVERY_ENABLED)"
  echo "ingress: $i-ingress.socket $(machine systemctl is-active "$i-ingress.socket" 2>/dev/null || true)" \
       "($(machine systemctl show -p Listen --value "$i-ingress.socket" 2>/dev/null | tr '\n' ' ')), nginx under $i-ingress.service $(machine systemctl is-active "$i-ingress.service" 2>/dev/null || true)"
  podman ps -a --filter "label=smarthost.instance=$i" --filter label=smarthost.topology=production \
    --format '{{.Names}}\t{{.ID}}\t{{.Status}}\t{{.Ports}}' | sort
  if [[ "$(podman container inspect --format '{{.State.Running}}' "$i-postfix" 2>/dev/null)" == true ]]; then
    # sed reads the whole output: with `head` the command can die of SIGPIPE under pipefail
    podman exec "$i-postfix" smarthost-postfix-control status | sed -n 1p
  fi
}

cmd_recreate() {
  require_production
  "${RENDER[@]}" check --env "$DOTENV"
  render
  host_gate
  activation_gate
  cmd_stop
  topo remove
  topo create
  cmd_start
  cmd_status
}

# -------------------------------------------------------------------------- TLS
# Production certificates come from the operator (any CA or ACME client); they
# become Podman secrets mounted only into nginx and Postfix.
cmd_tls() {
  local i; i="$(I)"
  case "${1:-}" in
    set)
      (($# == 5)) || die "usage: tls set <proxy-cert.pem> <proxy-key.pem> <postfix-cert.pem> <postfix-key.pem>"
      local pc="$2" pk="$3" fc="$4" fk="$5" f
      for f in "$pc" "$pk" "$fc" "$fk"; do [[ -r "$f" ]] || die "cannot read $f"; done
      [[ "$(openssl x509 -in "$pc" -noout -pubkey)" == "$(openssl pkey -in "$pk" -pubout)" ]] || die "$pc does not match $pk"
      [[ "$(openssl x509 -in "$fc" -noout -pubkey)" == "$(openssl pkey -in "$fk" -pubout)" ]] || die "$fc does not match $fk"
      for s in "proxy-tls-cert:$pc" "proxy-tls-key:$pk" "postfix-tls-cert:$fc" "postfix-tls-key:$fk"; do
        podman secret rm "$i-${s%%:*}" >/dev/null 2>&1 || true
        podman secret create --label project=smarthost "$i-${s%%:*}" "${s#*:}" >/dev/null && echo "secret $i-${s%%:*}"
      done
      if topo exists; then topo replace nginx postfix; fi ;;
    self-signed)
      [[ "$(envval SMARTHOST_EGRESS_ENABLED)" == false ]] || die "self-signed certificates are only for a rehearsal (SMARTHOST_EGRESS_ENABLED=false)"
      local dir="$GEN/tls"; mkdir -p "$dir"; chmod 700 "$dir"
      local pf proxy; pf="$(envval POSTFIX_MYHOSTNAME)"; proxy="$(envval PROXY_SERVER_NAME)"
      openssl req -x509 -newkey rsa:2048 -nodes -days 30 -subj "/CN=$pf" -addext "subjectAltName=DNS:$pf" \
        -keyout "$dir/postfix.key" -out "$dir/postfix.crt" 2>/dev/null
      openssl req -x509 -newkey rsa:2048 -nodes -days 30 -subj "/CN=$proxy" -addext "subjectAltName=DNS:$proxy" \
        -keyout "$dir/proxy.key" -out "$dir/proxy.crt" 2>/dev/null
      cmd_tls set "$dir/proxy.crt" "$dir/proxy.key" "$dir/postfix.crt" "$dir/postfix.key" ;;
    self-signed-bootstrap)
      # The installer's temporary certificate (specification 2.11): lets nginx and Postfix start
      # before DNS and Let's Encrypt are in place. Browsers warn; the TLS checks report it as
      # untrusted, and the activation preflight refuses live delivery until it is replaced.
      local dir="$GEN/tls"; mkdir -p "$dir"; chmod 700 "$dir"
      local pf proxy; pf="$(envval POSTFIX_MYHOSTNAME)"; proxy="$(envval PROXY_SERVER_NAME)"
      openssl req -x509 -newkey rsa:2048 -nodes -days 90 -subj "/CN=$proxy" -addext "subjectAltName=DNS:$proxy,DNS:$pf" \
        -keyout "$dir/bootstrap.key" -out "$dir/bootstrap.crt" 2>/dev/null
      cmd_tls set "$dir/bootstrap.crt" "$dir/bootstrap.key" "$dir/bootstrap.crt" "$dir/bootstrap.key" ;;
    acme) shift; cmd_acme "$@" ;;
    *) die "usage: tls set <proxy-cert> <proxy-key> <postfix-cert> <postfix-key> | tls acme issue|renew|ensure|status | tls self-signed-bootstrap | tls self-signed (rehearsal only)" ;;
  esac
}

# --------------------------------------------------------- Let's Encrypt (DNS-01)
# lego (installed on the host by the installer) obtains one certificate for the web and
# the mail host names with the DNS-01 challenge through ACME_DNS_PROVIDER, using the
# credentials in ACME_CREDENTIALS_FILE (NAME=value lines, mode 0600, outside the
# repository). Port 80 is never opened. The certificate is installed into nginx and
# Postfix with `tls set`. The state is in $GEN/acme (0700); the outcome is recorded for
# the host agent in $GEN/acme/status.json.
acme_status_set() {
  python3 - "$GEN/acme/status.json" "$@" <<'PY'
import json, sys
path, pairs = sys.argv[1], sys.argv[2:]
try:
    data = json.load(open(path))
except (OSError, ValueError):
    data = {}
for pair in pairs:
    k, _, v = pair.partition("=")
    data[k] = v
with open(path, "w") as f:
    json.dump(data, f, indent=1)
PY
}

cmd_acme() {
  require_production
  local action="${1:-status}" email provider creds server days web mta dir cert key before after rc out
  email="$(envval ACME_EMAIL)"; provider="$(envval ACME_DNS_PROVIDER)"; creds="$(envval ACME_CREDENTIALS_FILE)"
  server="$(envval ACME_SERVER)"; days="$(envval ACME_RENEW_DAYS)"; web="$(envval PROXY_SERVER_NAME)"; mta="$(envval POSTFIX_MYHOSTNAME)"
  dir="$GEN/acme"; mkdir -p "$dir"; chmod 700 "$dir"
  cert="$dir/certificates/$web.crt"; key="$dir/certificates/$web.key"
  if [[ "$action" == status ]]; then
    if [[ -z "$email" || -z "$provider" ]]; then echo "ACME is not configured (ACME_EMAIL, ACME_DNS_PROVIDER)"; return 0; fi
    echo "provider: $provider; server: ${server:-default}"
    if [[ -f "$cert" ]]; then openssl x509 -in "$cert" -noout -subject -enddate -ext subjectAltName 2>/dev/null; else echo "no certificate obtained yet"; fi
    [[ -f "$dir/status.json" ]] && cat "$dir/status.json"
    return 0
  fi
  if [[ -z "$email" || -z "$provider" ]]; then
    [[ "$action" == renew ]] && { say "ACME is not configured: nothing to renew"; return 0; }
    die "set ACME_EMAIL and ACME_DNS_PROVIDER (and ACME_CREDENTIALS_FILE) in $DOTENV first"
  fi
  command -v lego >/dev/null || die "the ACME client lego is not installed (sudo apt-get install lego)"
  if [[ "$provider" != manual ]]; then
    [[ -n "$creds" && -r "$creds" ]] || die "ACME_CREDENTIALS_FILE must name a readable file of NAME=value lines for the $provider provider (lego dnshelp -c $provider)"
    [[ $(( $(stat -c '%a' "$creds") % 100 )) == 0 ]] || die "$creds must not be readable by others (chmod 600 $creds)"
  fi
  case "$action" in
    ensure) [[ -f "$cert" ]] && action=renew || action=issue ;;
    issue|renew) ;;
    *) die "usage: tls acme issue|renew|ensure|status" ;;
  esac
  local args=(--accept-tos --email "$email" --dns "$provider" --domains "$web" --path "$dir")
  [[ "$mta" != "$web" ]] && args+=(--domains "$mta")
  [[ -n "$server" ]] && args+=(--server "$server")
  before="$(sha256sum "$cert" 2>/dev/null | cut -d' ' -f1)"
  acme_status_set "last_attempt_at=$(now_iso)"
  # The provider credentials are given to lego only, through its environment. The file is
  # read as plain NAME=value lines, never executed.
  local -a credenv=()
  if [[ "$provider" != manual ]]; then
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
      [[ "$line" =~ ^[A-Z][A-Z0-9_]*= ]] || die "$creds: not a NAME=value line: ${line%%=*}"
      credenv+=("$line")
    done < "$creds"
  fi
  local verb=(run)
  [[ "$action" == renew ]] && verb=(renew --days "${days:-30}")
  set +e
  out="$(env "${credenv[@]}" lego "${args[@]}" "${verb[@]}" 2>&1 | tee /dev/stderr; exit "${PIPESTATUS[0]}")"; rc=$?
  set -e
  if [[ $rc -ne 0 || ! -f "$cert" ]]; then
    acme_status_set "last_result=failed: $(tail -n 1 <<<"$out" | cut -c1-200)"
    die "lego failed (see above); the installed certificate is unchanged"
  fi
  after="$(sha256sum "$cert" | cut -d' ' -f1)"
  acme_status_set "expires_at=$(openssl x509 -in "$cert" -noout -enddate | cut -d= -f2)"
  if [[ "$before" != "$after" ]]; then
    cmd_tls set "$cert" "$key" "$cert" "$key"
    acme_status_set "last_result=ok: certificate $([[ $action == issue ]] && echo obtained || echo renewed) and installed"
    say "certificate for $web${mta:+ and $mta} installed into nginx and Postfix"
  else
    acme_status_set "last_result=ok: not due for renewal"
    say "certificate not due for renewal (renews ${days:-30} days before expiry)"
  fi
}

# ------------------------------------------------------------------------- DKIM
cmd_dkim() {
  local i; i="$(I)"
  (($#)) || die "usage: dkim generate|activate|retire|dns|pubkey|list ..."
  podman exec "$i-opendkim" smarthost-dkim-key "$@"
  case "$1" in
    activate|retire)
      podman restart --time 10 "$i-opendkim" >/dev/null && say "OpenDKIM restarted with the new tables"
      [[ "$1" == activate ]] && say "record it for the sending domain: smarthostctl prod console smarthost:domain:dkim <client-id> $2 active --selector $3"
      ;;
  esac
}

# --------------------------------------------------------- live delivery and pause
cmd_live() {
  local want="$1"; shift
  parse_operator "$@"
  require_production
  [[ "$(envval SMARTHOST_LIVE_DELIVERY_ENABLED)" != "$want" ]] || die "SMARTHOST_LIVE_DELIVERY_ENABLED is already $want"
  if [[ "$want" == true ]]; then
    "${PREFLIGHT[@]}" --activation || die "the activation preflight failed: live delivery stays disabled (fix every FAIL above)"
    audit delivery.live_enabled
  else
    audit delivery.live_disabled
  fi
  set_env SMARTHOST_LIVE_DELIVERY_ENABLED "$want"
  "${RENDER[@]}" check --env "$DOTENV" >/dev/null || { set_env SMARTHOST_LIVE_DELIVERY_ENABLED "$([[ $want == true ]] && echo false || echo true)"; die "configuration check failed; reverted"; }
  render
  topo replace postfix delivery
  say "SMARTHOST_LIVE_DELIVERY_ENABLED=$want: Postfix and the delivery daemon were recreated"
}

# The emergency stop (specification 2.11): the database flag the delivery daemon reads within
# seconds (audited by the console command with the operator) plus the Postfix queue hold.
cmd_pause() {
  local action="$1"; shift
  parse_operator "$@"
  require_production
  if [[ "$action" == pause ]]; then
    console smarthost:delivery:emergency-stop on --operator "$OPERATOR" --note "$NOTE" || die "not audited; nothing was changed"
    podman exec "$(I)-postfix" smarthost-postfix-control pause "$NOTE ($OPERATOR)"
  else
    console smarthost:delivery:emergency-stop off --operator "$OPERATOR" --note "$NOTE" || die "not audited; nothing was changed"
    podman exec "$(I)-postfix" smarthost-postfix-control resume
  fi
}

# Component names for logs: the component, not the container (prod logs app|webhook|...).
cmd_logs() {
  local what="${1:?usage: logs <app|webhook|validator|delivery|postfix|opendkim|nginx|postgres|agent> [lines|-f]}" n="${2:-100}" svc
  case "$what" in
    app|web|symfony|symfony-app) svc=symfony-app ;;
    webhook|webhooks|webhook-worker) svc=webhook-worker ;;
    validator|delivery|postfix|opendkim|nginx|postgres) svc="$what" ;;
    agent|host-agent)
      if [[ "$n" == -f ]]; then exec journalctl --user -u "$(I)-host-agent.service" -f; fi
      exec journalctl --user -u "$(I)-host-agent.service" -n "$n" --no-pager ;;
    *) die "unknown component $what (app, webhook, validator, delivery, postfix, opendkim, nginx, postgres, agent)" ;;
  esac
  # Containers log to stdout and stderr (PHP-FPM, nginx errors); both go to stdout so that
  # `prod logs app | grep …` sees every line.
  if [[ "$n" == -f ]]; then exec podman logs -f --tail 50 "$(I)-$svc" 2>&1; fi
  [[ "$n" =~ ^[0-9]+$ ]] || die "lines must be a number (or -f to follow)"
  podman logs --tail "$n" "$(I)-$svc" 2>&1
}

# --------------------------------------------------------------- backup/restore
backup_root() { local d; d="$(envval BACKUP_DIR)"; echo "${d:-$GEN/backups}"; }
STAMP_RE='^[0-9]{8}T[0-9]{6}(Z|[+-][0-9]{4})(\.tar\.enc)?$'

# Removes only what the backup tooling itself created: a scheduled backup (a timestamp name
# directly inside the backup root) or a private restore directory (restore.XXXXXX directly
# inside $GEN). Anything else is refused, so no computed path can widen a removal.
remove_owned() {
  local path="$1" parent base
  parent="$(cd "$(dirname -- "$path")" 2>/dev/null && pwd -P)" || return 0
  base="$(basename -- "$path")"
  if { [[ "$parent" == "$(cd "$(backup_root)" 2>/dev/null && pwd -P)" && "$base" =~ $STAMP_RE ]]; } \
     || { [[ "$parent" == "$(cd "$GEN" && pwd -P)" && "$base" =~ ^restore\.[A-Za-z0-9]{6}$ ]]; }; then
    rm -r -- "${parent:?}/${base:?}"
  else
    echo "smarthostctl prod: refusing to remove $path (not created by the backup tooling)" >&2
    return 1
  fi
}

# Record the outcome of a backup or restore rehearsal for the host agent (merged JSON).
backup_status_set() {
  mkdir -p "$GEN"
  python3 - "$GEN/backup-status.json" "$@" <<'PY'
import json, sys
path, pairs = sys.argv[1], sys.argv[2:]
try:
    data = json.load(open(path))
except (OSError, ValueError):
    data = {}
for pair in pairs:
    k, _, v = pair.partition("=")
    data[k] = {"true": True, "false": False}.get(v, v)
with open(path, "w") as f:
    json.dump(data, f, indent=1)
PY
}

cmd_backup_status() {
  local f="$GEN/backup-status.json"
  [[ -f "$f" ]] || { echo "no backup recorded yet (smarthostctl prod backup --scheduled)"; return 0; }
  python3 -c 'import json,sys; [print(f"{k}: {v}") for k, v in sorted(json.load(open(sys.argv[1])).items())]' "$f"
}

# Dates in the installation's time zone (SMARTHOST_TIMEZONE), whatever the host's own zone is.
zdate() { local z; z="$(envval SMARTHOST_TIMEZONE)"; if [[ -n "$z" ]]; then TZ="$z" date "$@"; else date "$@"; fi; }
now_iso() { zdate +%Y-%m-%dT%H:%M:%S%:z; }

# A scheduled backup (specification 2.11): back up into BACKUP_DIR, encrypt when a passphrase
# file is configured, keep the newest BACKUP_KEEP, copy off the host, record the outcome.
cmd_backup_scheduled() {
  require_production
  local root stamp dir out keep target pf key encrypted=false offhost=false offhost_err="" old
  root="$(backup_root)"; mkdir -p "$root"; chmod 700 "$root"
  stamp="$(zdate +%Y%m%dT%H%M%S%z)"; dir="$root/$stamp"
  backup_status_set "last_attempt_at=$(now_iso)" "schedule=$(envval BACKUP_SCHEDULE)" "keep=$(envval BACKUP_KEEP)"
  if ! (cmd_backup "$dir"); then
    backup_status_set "last_result=failed: the backup command failed (see the backup timer's journal)"
    die "backup failed"
  fi
  out="$dir"
  pf="$(envval BACKUP_ENCRYPTION_PASSPHRASE_FILE)"
  if [[ -n "$pf" ]]; then
    [[ -r "$pf" ]] || { backup_status_set "last_result=failed: cannot read BACKUP_ENCRYPTION_PASSPHRASE_FILE"; die "cannot read $pf"; }
    (umask 077; tar -C "$root" -cf - "$stamp" | openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass "file:$pf" -out "$dir.tar.enc") \
      || { backup_status_set "last_result=failed: encryption failed"; die "encryption failed"; }
    remove_owned "$dir"; out="$dir.tar.enc"; encrypted=true
  fi
  keep="$(envval BACKUP_KEEP)"; keep="${keep:-14}"
  # Only scheduled backups (timestamp names) are pruned; explicit backup directories are never touched.
  while read -r old; do
    [[ -n "$old" ]] && remove_owned "$root/$old"
  done < <(find "$root" -mindepth 1 -maxdepth 1 -printf '%f\n' | grep -E "$STAMP_RE" | sort -r | tail -n +"$((keep + 1))")
  target="$(envval BACKUP_OFFHOST_TARGET)"
  if [[ -n "$target" ]]; then
    local rsh="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
    key="$(envval BACKUP_OFFHOST_SSH_KEY)"; [[ -n "$key" ]] && rsh+=" -i $key"
    if offhost_err="$(rsync -a -e "$rsh" "$out" "$target" 2>&1)"; then offhost=true; offhost_err=""; fi
  fi
  backup_status_set "last_success_at=$(now_iso)" "last_result=ok" "last_path=$out" \
    "encrypted=$encrypted" "offhost_configured=$([[ -n "$target" ]] && echo true || echo false)" "offhost=$offhost" \
    "offhost_target=$target" "offhost_error=${offhost_err:0:300}" \
    "contents=database, infra/.env (secrets), DKIM keys and tables, TLS certificates, manifest"
  say "scheduled backup: $out ($([[ $encrypted == true ]] && echo encrypted || echo 'not encrypted')); off-host: $([[ -z $target ]] && echo 'not configured' || { [[ $offhost == true ]] && echo "copied to $target" || echo "FAILED: ${offhost_err:0:200}"; })"
  [[ -z "$target" || "$offhost" == true ]]
}

# Unpack a backup for restore: a directory as is, or an encrypted archive into a private
# restore.XXXXXX directory under $GEN (the caller removes it with remove_owned).
backup_open() {
  local src="$1" pf tmp
  if [[ -d "$src" ]]; then echo "$src"; return 0; fi
  [[ -f "$src" && "$src" == *.tar.enc ]] || die "$src is not a backup directory or an encrypted backup (.tar.enc)"
  pf="$(envval BACKUP_ENCRYPTION_PASSPHRASE_FILE)"
  [[ -n "$pf" && -r "$pf" ]] || die "an encrypted backup needs BACKUP_ENCRYPTION_PASSPHRASE_FILE"
  tmp="$(mktemp -d "$GEN/restore.XXXXXX")"; chmod 700 "$tmp"
  if ! openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass "file:$pf" -in "$src" | tar -C "$tmp" -xf -; then
    remove_owned "$tmp"; die "cannot decrypt $src (wrong passphrase?)"
  fi
  echo "$tmp/$(find "$tmp" -mindepth 1 -maxdepth 1 -printf '%f\n' -quit)"
}

newest_backup() {
  local root; root="$(backup_root)"
  find "$root" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | grep -E "$STAMP_RE" | sort | tail -n 1 | sed "s#^#$root/#"
}

# Restore rehearsal (specification 2.11): the newest (or a given) backup is verified, its
# database restored into a temporary database next to the real one, checked, and dropped.
# The production database is never touched.
cmd_restore_rehearsal() {
  require_production
  local src="${1:-$(newest_backup)}" dir tables="" migs="" expected db rdb user unpacked="" fail=""
  if [[ -z "$src" ]]; then
    backup_status_set "restore_rehearsal_at=$(now_iso)" "restore_rehearsal_result=failed: no backup to rehearse"
    die "no backup found in $(backup_root)"
  fi
  dir="$(backup_open "$src")"; [[ "$dir" == "$src" ]] || unpacked="$(dirname "$dir")"
  (cd "$dir" && sed -n 's/^  \([0-9a-f]\{64\}\)  /\1  /p' MANIFEST | sha256sum -c --quiet) || fail="checksum mismatch"
  for f in db.dump opendkim-keys.tar opendkim-tables.tar env; do [[ -n "$fail" || -s "$dir/$f" ]] || fail="$f missing"; done
  user="$(envval POSTGRES_USER)"; db="$(envval SMARTHOST_DB_NAME)"; rdb="${db}_restore_rehearsal"
  if [[ -z "$fail" ]]; then
    podman exec "$(I)-postgres" dropdb -U "$user" --if-exists "$rdb" >/dev/null 2>&1 || true
    podman exec "$(I)-postgres" createdb -U "$user" "$rdb" || fail="cannot create the temporary database"
  fi
  if [[ -z "$fail" ]] && ! podman exec -i "$(I)-postgres" pg_restore -U "$user" -d "$rdb" --no-owner --exit-on-error < "$dir/db.dump" >/dev/null 2>&1; then
    fail="pg_restore failed"
  fi
  if [[ -z "$fail" ]]; then
    tables="$(podman exec "$(I)-postgres" psql -X -At -U "$user" -d "$rdb" -c "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'public'")"
    migs="$(podman exec "$(I)-postgres" psql -X -At -U "$user" -d "$rdb" -c "SELECT count(*) FROM doctrine_migration_versions")"
    expected="$(sed -n '/^migrations:/,/^sha256:/p' "$dir/MANIFEST" | grep -c '^  ' || true)"
    [[ "$migs" == "$expected" ]] || fail="the restored database has $migs migrations, the manifest $expected"
  fi
  podman exec "$(I)-postgres" dropdb -U "$user" --if-exists "$rdb" >/dev/null 2>&1 || true
  [[ -z "$unpacked" ]] || remove_owned "$unpacked"
  if [[ -n "$fail" ]]; then
    backup_status_set "restore_rehearsal_at=$(now_iso)" "restore_rehearsal_result=failed: $fail ($(basename "$src"))"
    die "restore rehearsal FAILED: $fail"
  fi
  backup_status_set "restore_rehearsal_at=$(now_iso)" "restore_rehearsal_result=ok: $tables tables, $migs migrations from $(basename "$src")"
  say "restore rehearsal passed: $(basename "$src") restored into a temporary database ($tables tables, $migs migrations), then removed"
}

cmd_backup() {
  require_production
  local i dir with_queue=false; i="$(I)"
  if [[ "${1:-}" == --scheduled ]]; then shift; cmd_backup_scheduled "$@"; return; fi
  dir="$GEN/backups/$(zdate +%Y%m%dT%H%M%S%z)"
  while (($#)); do
    case "$1" in --with-queue) with_queue=true; shift ;; *) dir="$1"; shift ;; esac
  done
  [[ ! -e "$dir" ]] || die "$dir exists"
  mkdir -p "$dir"; chmod 700 "$dir"
  local db; db="$(envval SMARTHOST_DB_NAME)"
  podman exec "$i-postgres" pg_dump -U "$(envval POSTGRES_USER)" -d "$db" -Fc > "$dir/db.dump"
  podman volume export "$i-opendkim-keys" -o "$dir/opendkim-keys.tar"
  podman volume export "$i-opendkim-tables" -o "$dir/opendkim-tables.tar"
  install -m 600 "$DOTENV" "$dir/env"
  local s tls_note="included"
  for s in proxy-tls-cert proxy-tls-key postfix-tls-cert postfix-tls-key; do
    if ! podman secret inspect --showsecret --format '{{.SecretData}}' "$i-$s" > "$dir/$s.pem" 2>/dev/null; then
      rm -f "$dir/$s.pem"; tls_note="not exported by this Podman version: keep the certificate source files (CA/ACME) safe"
    fi
  done
  if [[ "$with_queue" == true ]]; then
    podman volume export "$i-postfix-queue" -o "$dir/postfix-queue.tar"
    podman volume export "$i-dsn-spool" -o "$dir/dsn-spool.tar"
  fi
  chmod 600 "$dir"/*
  {
    echo "catto-mail production backup"
    echo "created: $(now_iso)"
    echo "instance: $i"
    echo "image tag: $(envval SMARTHOST_IMAGE_TAG)"
    echo "live delivery: $(envval SMARTHOST_LIVE_DELIVERY_ENABLED)"
    echo "tls secrets: $tls_note"
    echo "postfix queue and dsn spool: $([[ $with_queue == true ]] && echo included || echo 'not included (transient; see the runbook)')"
    echo "migrations:"; psql_admin -At -c "SELECT version FROM doctrine_migration_versions ORDER BY version" | sed 's/^/  /'
    echo "sha256:"; (cd "$dir" && sha256sum ./* | grep -v ' ./MANIFEST' | sed 's/^/  /')
  } > "$dir/MANIFEST"
  chmod 600 "$dir/MANIFEST"
  say "backup written to $dir (contains secrets: encrypt it and copy it off the host)"
}

cmd_restore() {
  require_production
  local dir="${1:-}" yes="${2:-}" i; i="$(I)"
  [[ "$yes" == --yes ]] || die "restore replaces the database and the DKIM keys: add --yes"
  if [[ -f "$dir" ]]; then dir="$(backup_open "$dir")"; fi   # an encrypted scheduled backup (.tar.enc)
  [[ -n "$dir" && -f "$dir/db.dump" && -f "$dir/MANIFEST" ]] || die "usage: restore <backup-dir or .tar.enc> --yes (written by 'backup')"
  topo exists || die "create the topology first (prod install), then restore into it"
  (cd "$dir" && sed -n 's/^  \([0-9a-f]\{64\}\)  /\1  /p' MANIFEST | sha256sum -c --quiet) || die "checksum mismatch in $dir"
  cmd_stop
  podman start "$i-postgres" >/dev/null
  local user db; user="$(envval POSTGRES_USER)"; db="$(envval SMARTHOST_DB_NAME)"
  for _ in $(seq 1 60); do podman exec "$i-postgres" pg_isready -q -U "$user" -d postgres && break; sleep 1; done
  podman exec "$i-postgres" dropdb -U "$user" --if-exists --force "$db"
  podman exec "$i-postgres" createdb -U "$user" "$db"
  podman exec -i "$i-postgres" pg_restore -U "$user" -d "$db" --exit-on-error < "$dir/db.dump"
  podman volume import "$i-opendkim-keys" "$dir/opendkim-keys.tar"
  podman volume import "$i-opendkim-tables" "$dir/opendkim-tables.tar"
  if [[ -f "$dir/postfix-queue.tar" ]]; then podman volume import "$i-postfix-queue" "$dir/postfix-queue.tar"; fi
  if [[ -f "$dir/dsn-spool.tar" ]]; then podman volume import "$i-dsn-spool" "$dir/dsn-spool.tar"; fi
  cmp -s "$dir/env" "$DOTENV" || echo "smarthostctl prod: NOTE: $DOTENV differs from the backup's env (secrets, keyring): restore it deliberately if this is a new host"
  cmd_start
  say "restored from $dir"
}

# ------------------------------------------------------------------- settings
# Apply the settings changed in the dashboard: render with them, then replace only the
# containers whose configuration changed (every container when the topology script changed,
# e.g. a new time zone) and reinstall the units when a timer changed (backup schedule).
cmd_settings_apply() {
  require_production
  "${RENDER[@]}" check --env "$DOTENV"
  local before="$GEN/.settings-before" consumer service changed=()
  rm -rf "$before"; mkdir -p "$before"
  [[ -d "$GEN/env" ]] && cp -p "$GEN"/env/*.env "$before/" 2>/dev/null || true
  [[ -f "$GEN/podman/smarthost-production.sh" ]] && cp -p "$GEN/podman/smarthost-production.sh" "$before/topology.sh"
  [[ -d "$GEN/systemd" ]] && cp -rp "$GEN/systemd" "$before/systemd"
  render   # warnings about ignored dashboard values go to stderr
  if ! diff -rq "$before/systemd" "$GEN/systemd" >/dev/null 2>&1 && default_instance && local_engine; then
    "$HELPER" install >/dev/null && say "systemd units reinstalled (a timer changed)"
  fi
  if ! cmp -s "$before/topology.sh" "$GEN/podman/smarthost-production.sh"; then
    say "the topology changed (time zone): recreating every service"
    cmd_stop; topo remove; topo create; cmd_start
    rm -rf "$before"; say "settings applied: every service was recreated"; return
  fi
  for consumer in app webhook-worker validator delivery postfix opendkim proxy postgres; do
    cmp -s "$before/$consumer.env" "$GEN/env/$consumer.env" && continue
    case "$consumer" in app) service=symfony-app ;; proxy) service=nginx ;; *) service="$consumer" ;; esac
    changed+=("$service")
  done
  rm -rf "$before"
  if ((${#changed[@]})); then topo replace "${changed[@]}"; say "settings applied: restarted ${changed[*]}"
  else say "settings applied: no service needed a restart"; fi
}

# --------------------------------------------------------------- upgrade/rollback
cmd_upgrade() {
  require_production
  local tag="${1:-}" backup=true old; old="$(envval SMARTHOST_IMAGE_TAG)"
  [[ -n "$tag" ]] || die "usage: upgrade <new-image-tag> [--no-backup] (check out the new release first)"
  [[ "${2:-}" == --no-backup ]] && backup=false
  [[ "$tag" != "$old" ]] || die "already on $tag"
  # The new release's .env layout (renamed settings, built-in values); the old file is kept as
  # infra/.env.v<old>-<timestamp>, which a rollback to <old> restores.
  "${RENDER[@]}" migrate-env --env "$DOTENV" --version "$old"
  "${PREFLIGHT[@]}" --section runtime --pre-upgrade --quiet || die "the runtime preflight failed; fix it before upgrading"
  [[ "$backup" == true ]] && cmd_backup
  set_env SMARTHOST_IMAGE_TAG "$tag"
  cmd_build
  cmd_recreate   # start runs the new migrations, then the grants
  "${PREFLIGHT[@]}" --section runtime || die "upgraded to $tag but the runtime preflight fails; see the runbook (rollback)"
  say "upgraded $old -> $tag"
}

cmd_rollback() {
  require_production
  local tag="${1:-}" dir="${2:-}" i; i="$(I)"
  [[ -n "$tag" && -n "$dir" ]] || die "usage: rollback <previous-image-tag> <backup-dir taken before the upgrade> (released migrations are not reversed in place)"
  for s in opendkim postfix app nginx validator delivery; do podman image exists "localhost/smarthost-$s:$tag" || die "image localhost/smarthost-$s:$tag is gone; check out that release and run 'prod build' with SMARTHOST_IMAGE_TAG=$tag"; done
  # The configuration the upgrade kept for that release (infra/.env.v<tag>-<timestamp>), if any.
  local kept; kept="$(ls -1t "$DOTENV.v${tag#v}-"* 2>/dev/null | head -n1 || true)"
  if [[ -n "$kept" ]]; then
    cp -p "$DOTENV" "$DOTENV.v$(envval SMARTHOST_IMAGE_TAG)-$(zdate +%Y%m%dT%H%M%S)"
    cp -p "$kept" "$DOTENV"
    say "restored the configuration kept for $tag ($kept)"
  fi
  set_env SMARTHOST_IMAGE_TAG "$tag"
  render
  cmd_stop
  topo remove
  topo create
  cmd_restore "$dir" --yes
  say "rolled back to $tag with the database of $dir"
}

usage() {
  cat <<USAGE
usage: smarthostctl prod <command>     (catto-mail production; runbook: docs/production/runbook.md)
 configuration
  init-env              create infra/.env from infra/production.env.example with secrets generated here
  env-migrate           rewrite an older infra/.env in the current grouped layout, keeping every value;
                        the old file stays as infra/.env.v<version>-<timestamp> (upgrade runs this)
  settings-apply        apply the settings changed in the dashboard (System › Settings): render with them
                        and restart the services whose settings changed (the host agent runs this)
  check                 validate infra/.env against the contract and the production safety rules
  render                check, then render env files, the production topology and the systemd units
 install and lifecycle
  build                 build the production images, tagged SMARTHOST_IMAGE_TAG; fetch the pinned PostgreSQL image
  tls set <proxy-crt> <proxy-key> <postfix-crt> <postfix-key>   install/renew the TLS certificates
  tls acme issue|renew|ensure|status   Let's Encrypt with DNS-01 (lego; ACME_* in infra/.env); renew runs daily
  tls self-signed-bootstrap   a temporary certificate so the services start before DNS/Let's Encrypt
  tls self-signed       disposable certificates for a rehearsal (SMARTHOST_EGRESS_ENABLED=false only)
  install               render, install the systemd units (start at boot), create the containers
  start | stop | restart | status
  recreate              replace the containers from the current images/configuration (volumes kept)
  replace <svc...>      replace single containers (${SERVICES[*]})
  migrate               run the Doctrine migrations and the grants
  logs <component> [n|-f]   app, webhook, validator, delivery, postfix, opendkim, nginx, postgres, agent
  admin-link [--email E]    print a single-use ADMIN sign-in link (15 minutes; first sign-in, recovery)
  agent run|once|facts      the host agent (normally the <instance>-host-agent service)
  console <args...>     Symfony console in the application container
 checks
  preflight [--activation] [--section S] [--json] [--smtp-egress-probe DOMAIN]
                        PASS/WARN/FAIL for host, runtime, exposure, ingress, TLS, DNS identity, DKIM,
                        Postfix, delivery
  ingress-check         prove on this host that nginx and Postfix see each client's own address
                        (two loopback source addresses through 443 and 25; = preflight --section ingress)
  dns-checklist         the DNS records to create (A, PTR, MX, SPF, DKIM, DMARC) for this configuration
  firewall              an nftables ruleset for the host (review, then apply with sudo)
 mail identity
  dkim generate <domain> <selector> [bits] | activate <domain> <selector> | retire <domain> <selector>
       | dns <domain> [selector] | list      production DKIM keys (OpenDKIM only)
 delivery controls (audited: --operator EMAIL --note TEXT, permission SYSTEM.DELIVERY.CONTROL)
  live-enable           activation preflight, then live delivery (Postfix and the delivery daemon recreated)
  live-disable          back to held mode
  pause | resume        emergency stop / resume of ALL outbound mail (the database stop the daemon reads within
                        seconds, and the Postfix queue hold; also the dashboard's STOP SENDING EMAIL NOW)
  pause-status          pause flag, transports and Postfix queue depth
  client-status <client-id> <status> --operator <email> --note <reason>
                        audited client lifecycle change (approve, throttle, suspend, reactivate, close)
  ops-status [--json]   backlogs, delivery state, queue, rates, suppressions, DSNs, webhooks
  queue                 the Postfix queue (postqueue -p)
 backup and upgrade
  backup [dir] [--with-queue]    database, DKIM keys and tables, configuration and TLS secrets
  backup --scheduled             into BACKUP_DIR, encrypted if configured, pruned, copied off-host (the timer)
  backup-status                  the last backup, off-host copy and restore rehearsal
  restore-rehearsal [backup]     restore the newest backup into a temporary database, verify, drop it
  restore <dir|.tar.enc> --yes   restore a backup into the existing topology
  upgrade <tag> [--no-backup]    backup, build <tag>, recreate (migrations, grants), verify
  rollback <tag> <backup-dir>    previous images plus the database taken before the upgrade
 seed testing (operator-chosen addresses only)
  seed-test send|status ...      see: smarthostctl prod seed-test --help
USAGE
}

cmd="${1:-}"; shift || true
case "$cmd" in
  init-env) "${RENDER[@]}" init-env --production ;;
  env-migrate) "${RENDER[@]}" migrate-env --env "$DOTENV" ;;
  check) "${RENDER[@]}" check --env "$DOTENV" ;;
  render) require_production; fetch_overrides; "${RENDER[@]}" render --env "$DOTENV" --out "$GEN" --overrides "$GEN/overrides.json" ;;
  settings-apply) cmd_settings_apply ;;
  build) require_production; cmd_build ;;
  tls) require_production; cmd_tls "$@" ;;
  install) cmd_install ;;
  create) require_production; render; host_gate; activation_gate; topo create ;;
  start) require_production; cmd_start ;;
  stop) require_production; cmd_stop ;;
  restart) require_production; cmd_stop; cmd_start ;;
  status) require_production; cmd_status ;;
  recreate) cmd_recreate ;;
  replace) require_production; render; host_gate; topo replace "$@" ;;
  remove) require_production; cmd_stop; topo remove ;;
  migrate) require_production; topo tasks db-migrate db-grants ;;
  logs) require_production; cmd_logs "$@" ;;
  admin-link) require_production; console smarthost:admin:login-link "$@" ;;
  agent) require_production; exec "${AGENT[@]}" "$@" ;;
  backup-status) require_production; cmd_backup_status ;;
  restore-rehearsal) cmd_restore_rehearsal "$@" ;;
  console) require_production; console "$@" ;;
  preflight) require_production; exec "${PREFLIGHT[@]}" "$@" ;;
  ingress-check) require_production; exec "${PREFLIGHT[@]}" --section ingress "$@" ;;
  dns-checklist) require_production; exec "${PREFLIGHT[@]}" --checklist ;;
  firewall) require_production; exec "${PREFLIGHT[@]}" --firewall ;;
  dkim) require_production; cmd_dkim "$@" ;;
  live-enable) cmd_live true "$@" ;;
  live-disable) cmd_live false "$@" ;;
  pause) cmd_pause pause "$@" ;;
  resume) cmd_pause resume "$@" ;;
  pause-status) require_production; podman exec "$(I)-postfix" smarthost-postfix-control status ;;
  client-status) require_production; console smarthost:client:set-status "${1:?client-id}" "${2:?status}" "${@:3}" ;;
  ops-status) require_production; console smarthost:ops:status "$@" ;;
  queue) require_production; podman exec "$(I)-postfix" postqueue -p | tail -n "${1:-60}" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  upgrade) cmd_upgrade "$@" ;;
  rollback) cmd_rollback "$@" ;;
  seed-test) require_production; exec "${SEEDTEST[@]}" "$@" ;;
  uninstall) require_production; if default_instance; then "$HELPER" uninstall; else machine instance-uninstall "$(I)"; fi ;;
  machine) machine "$@" ;;   # internal: systemd commands in the engine host (SMARTHOST_HOSTCTL)
  ""|help|-h|--help) usage ;;
  *) usage; exit 64 ;;
esac
