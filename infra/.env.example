# OpenDKIM (`opendkim`)
# ----------------------------------------------------------------------
# consumers: opendkim | phase 1
OPENDKIM_KEY_DIR=/run/secrets/opendkim
# consumers: opendkim | phase 1
OPENDKIM_TABLES_DIR=/etc/opendkim/tables
