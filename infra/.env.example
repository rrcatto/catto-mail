# Smarthost environment template — SAFE TO COMMIT, CONTAINS NO SECRETS.
#
# Contract: docs/contracts/environment.md (normative; consumers, phases, meanings).
# Generated by: python3 infra/lib/smarthost_render.py env-example
# For development run `infra/bin/smarthostctl init-env`, which copies this file to
# infra/.env (gitignored) and fills the empty secrets with random development values.
# Production uses infra/production.env.example (`smarthostctl prod init-env`).
# Empty APP_RETENTION_* values mean 'no automatic deletion' until the
# operator's compliance specification sets the production policy.
# Each container receives only the variables listed as its consumers (rendered
# per service into infra/.generated/env/ by `smarthostctl render`).

# ----------------------------------------------------------------------
# Shared
# ----------------------------------------------------------------------
# consumers: app, webhook-worker, validator, delivery, postfix, opendkim | phase 1
SMARTHOST_ENV=development
# consumers: app, delivery | phase 2
SMARTHOST_PUBLIC_BASE_URL=https://localhost:8443
# consumers: app, webhook-worker, validator, delivery | phase 1
SMARTHOST_LOG_LEVEL=info
# consumers: app, webhook-worker, validator, delivery | phase 1
SMARTHOST_LOG_FORMAT=json
# consumers: postfix, delivery | phase 1
SMARTHOST_LIVE_DELIVERY_ENABLED=false
# consumers: app, delivery | phase 2
SMARTHOST_ALLOW_UNVERIFIED_SENDING_DOMAINS=false
# consumers: delivery, postfix | phase 4
SMARTHOST_BOUNCE_DOMAIN=bounce.smarthost.localhost
# consumers: delivery, postfix | phase 4
SMARTHOST_VERP_LOCAL_PART=bounce
# consumers: delivery, postfix | phase 4
SMARTHOST_VERP_DELIMITER=+
# consumers: delivery, postfix | phase 4
SMARTHOST_SUBMISSION_USERNAME=smarthost-delivery
# consumers: delivery, postfix | phase 4 | SECRET — leave empty here
SMARTHOST_SUBMISSION_PASSWORD=
# consumers: postfix, delivery | phase 1
SMARTHOST_POSTFIX_OBSERVABILITY_DIR=/var/lib/smarthost/postfix-observability
# consumers: postfix, delivery | phase 1
SMARTHOST_DSN_SPOOL_DIR=/var/lib/smarthost/dsn-spool
# consumers: postfix, delivery | phase 1
SMARTHOST_SPOOL_GID=5000
# consumers: postfix, delivery | phase 1
SMARTHOST_DELIVERY_UID=5001
# consumers: postfix, opendkim | phase 1
SMARTHOST_OPENDKIM_MILTER_ADDRESS=inet:opendkim:8891
# ----------------------------------------------------------------------
# Production deployment (`deployment`)
# ----------------------------------------------------------------------
# consumers: deployment | phase 8
SMARTHOST_INSTANCE=smarthost
# consumers: deployment | phase 8
SMARTHOST_IMAGE_TAG=dev
# consumers: deployment | phase 8
SMARTHOST_INTERNAL_SUBNET=10.89.20.0/24
# consumers: deployment | phase 8
SMARTHOST_EGRESS_SUBNET=10.89.21.0/24
# consumers: deployment | phase 8
SMARTHOST_INGRESS_SUBNET=10.89.22.0/24
# consumers: deployment | phase 8
SMARTHOST_EGRESS_ENABLED=false
# consumers: deployment | phase 8
SMARTHOST_PUBLIC_IPV4=
# consumers: deployment, proxy | phase 8
POSTFIX_SMTP_BIND=
# consumers: deployment | phase 8
SMARTHOST_SSH_PORT=22
# ----------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------
# consumers: app, webhook-worker, validator, delivery, bootstrap | phase 1
SMARTHOST_DB_HOST=postgres
# consumers: app, webhook-worker, validator, delivery, bootstrap | phase 1
SMARTHOST_DB_PORT=5432
# consumers: app, webhook-worker, validator, delivery, bootstrap | phase 1
SMARTHOST_DB_NAME=smarthost
# consumers: app, webhook-worker, validator, delivery, bootstrap | phase 1
SMARTHOST_DB_SSLMODE=disable
# consumers: postgres, bootstrap | phase 1
POSTGRES_USER=postgres
# consumers: postgres, bootstrap | phase 1 | SECRET — leave empty here
POSTGRES_PASSWORD=
# consumers: postgres | phase 1
POSTGRES_DB=smarthost
# consumers: app, bootstrap | phase 1
SMARTHOST_DB_OWNER_USER=smarthost_owner
# consumers: app, bootstrap | phase 1 | SECRET — leave empty here
SMARTHOST_DB_OWNER_PASSWORD=
# consumers: app, bootstrap | phase 1
APP_DB_USER=smarthost_app
# consumers: app, bootstrap | phase 1 | SECRET — leave empty here
APP_DB_PASSWORD=
# consumers: webhook-worker, bootstrap | phase 1
APP_WEBHOOK_DB_USER=smarthost_webhook
# consumers: webhook-worker, bootstrap | phase 1 | SECRET — leave empty here
APP_WEBHOOK_DB_PASSWORD=
# consumers: validator, bootstrap | phase 1
VALIDATOR_DB_USER=smarthost_validator
# consumers: validator, bootstrap | phase 1 | SECRET — leave empty here
VALIDATOR_DB_PASSWORD=
# consumers: delivery, bootstrap | phase 1
DELIVERY_DB_USER=smarthost_delivery
# consumers: delivery, bootstrap | phase 1 | SECRET — leave empty here
DELIVERY_DB_PASSWORD=
