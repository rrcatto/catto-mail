# catto-mail configuration, production. This template is safe to commit: it has no secrets.
# `smarthostctl prod init-env` copies it to infra/.env (mode 0600) and generates the secrets
# on the host. Replace every example.com and 203.0.113.x placeholder, then run
# `smarthostctl prod check`. Each setting is explained in docs/contracts/environment.md;
# settings that are not listed here are built in. Settings changed in the dashboard
# (System > Settings) take precedence over this file without changing it.

# === Installation ===
SMARTHOST_ENV=production
SMARTHOST_TIMEZONE=Africa/Johannesburg
SMARTHOST_LOG_LEVEL=info

# === Set by smarthostctl (live-enable, upgrade, rollback); do not edit by hand ===
SMARTHOST_LIVE_DELIVERY_ENABLED=false
SMARTHOST_IMAGE_TAG=0.2.3

# === Server ===
SMARTHOST_PUBLIC_IPV4=203.0.113.10
SMARTHOST_SSH_PORT=22
SMARTHOST_EGRESS_ENABLED=true

# === Web address ===
SMARTHOST_PUBLIC_BASE_URL=https://smarthost.example.com
PROXY_SERVER_NAME=smarthost.example.com
PROXY_HTTPS_BIND=0.0.0.0:443

# === Mail server and domains ===
POSTFIX_MYHOSTNAME=smarthost.example.com
SMARTHOST_BOUNCE_DOMAIN=bounce.example.com
POSTFIX_SMTP_BIND=0.0.0.0:25
POSTFIX_MESSAGE_SIZE_LIMIT=10240000

# === Dashboard sign-in ===
APP_ADMIN_EMAIL=admin@example.com
APP_MAIL_FROM=no-reply@example.com
APP_LOGIN_LINK_TTL_SECONDS=900

# === Delivery pacing ===
DELIVERY_GLOBAL_CONCURRENCY=2
DELIVERY_PER_DOMAIN_CONCURRENCY=1
DELIVERY_PER_DOMAIN_RATE_PER_MINUTE=10
DELIVERY_GLOBAL_RATE_PER_MINUTE=5
DELIVERY_THROTTLED_CLIENT_RATE_PER_MINUTE=2
DELIVERY_DEFERRAL_BACKOFF_SECONDS=1800
DELIVERY_POLL_INTERVAL_SECONDS=5
DELIVERY_LEASE_SECONDS=300
DELIVERY_DSN_NOTIFY=FAILURE,DELAY
DELIVERY_DSN_RET=HDRS

# === Bounces and reconciliation ===
DELIVERY_SOFT_BOUNCE_SUPPRESSION_THRESHOLD=3
DELIVERY_SOFT_BOUNCE_SUPPRESSION_WINDOW_DAYS=30
DELIVERY_FILE_POLL_INTERVAL_SECONDS=2
DELIVERY_RECONCILE_INTERVAL_SECONDS=300
DELIVERY_RECONCILE_GRACE_SECONDS=3600
DELIVERY_RECONCILE_MIN_SNAPSHOTS=2
POSTFIX_QUEUE_SNAPSHOT_INTERVAL_SECONDS=60
POSTFIX_QUEUE_SNAPSHOT_RETENTION_COUNT=60

# === Email validation ===
VALIDATOR_CHUNK_SIZE=250
VALIDATOR_LEASE_SECONDS=300
VALIDATOR_POLL_INTERVAL_SECONDS=10
VALIDATOR_GLOBAL_CONCURRENCY=20
VALIDATOR_PER_DOMAIN_CONCURRENCY=2
VALIDATOR_PER_MX_CONCURRENCY=2
VALIDATOR_MAX_ATTEMPTS=4
VALIDATOR_RETRY_BASE_SECONDS=300
VALIDATOR_RETRY_MAX_SECONDS=7200
VALIDATOR_DNS_RESOLVERS=
VALIDATOR_DNS_TIMEOUT_SECONDS=5
VALIDATOR_SMTP_PROBE_ENABLED=false
VALIDATOR_SMTP_HELO_HOSTNAME=smarthost.example.com
VALIDATOR_SMTP_MAIL_FROM=validator@bounce.example.com
VALIDATOR_SMTP_CONNECT_TIMEOUT_SECONDS=10
VALIDATOR_SMTP_COMMAND_TIMEOUT_SECONDS=30

# === API and client limits ===
APP_API_RATE_LIMIT_PER_MINUTE=600
APP_THROTTLED_CLIENT_API_RATE_PER_MINUTE=60
APP_API_MAX_REQUEST_BYTES=10485760
APP_SEND_JOB_MAX_RECIPIENTS=10000
APP_SEND_JOB_MAX_RECIPIENTS_PER_BATCH=500
APP_CLIENT_API_KEY_LIMIT=10
APP_CLIENT_WEBHOOK_ENDPOINT_LIMIT=10
APP_CLIENT_SENDING_DOMAIN_LIMIT=25
APP_DOMAIN_VERIFICATION_RECHECK_HOURS=24
APP_ACCEPTABLE_USE_POLICY_VERSION=
APP_REPERMISSION_RESPONSE_DAYS=60

# === Webhooks ===
APP_WEBHOOK_MAX_ATTEMPTS=12
APP_WEBHOOK_TIMEOUT_SECONDS=10
APP_WEBHOOK_CONNECT_TIMEOUT_SECONDS=5
APP_WEBHOOK_POLL_INTERVAL_SECONDS=5
APP_WEBHOOK_LEASE_SECONDS=60
APP_WEBHOOK_RETRY_BASE_SECONDS=60
APP_WEBHOOK_RETRY_MAX_SECONDS=21600
APP_WEBHOOK_SECRET_OVERLAP_HOURS=24

# === Reputation alerts ===
APP_REPUTATION_MIN_MESSAGES=100
APP_REPUTATION_HARD_BOUNCE_WARNING_PERCENT=2
APP_REPUTATION_HARD_BOUNCE_CRITICAL_PERCENT=5
APP_REPUTATION_COMPLAINT_WARNING_PERCENT=0.1
APP_REPUTATION_COMPLAINT_CRITICAL_PERCENT=0.3
APP_REPUTATION_DEFERRAL_WARNING_PERCENT=15
APP_REPUTATION_DEFERRAL_CRITICAL_PERCENT=30
APP_REPUTATION_VOLUME_INCREASE_WARNING_FACTOR=3
APP_REPUTATION_VOLUME_INCREASE_CRITICAL_FACTOR=10

# === Data retention ===
APP_RETENTION_STAGED_CONTENT_DAYS=7
APP_RETENTION_TRACKING_DAYS=
DELIVERY_DSN_RETENTION_DAYS=7
POSTFIX_LOG_RETENTION_DAYS=14

# === Certificates (Let's Encrypt) ===
ACME_EMAIL=
ACME_DNS_PROVIDER=
ACME_CREDENTIALS_FILE=
ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
ACME_RENEW_DAYS=30

# === Backups ===
BACKUP_DIR=
BACKUP_KEEP=14
BACKUP_SCHEDULE=*-*-* 03:15:00
BACKUP_OFFHOST_TARGET=
BACKUP_OFFHOST_SSH_KEY=
BACKUP_ENCRYPTION_PASSPHRASE_FILE=

# === Secrets: generated by init-env; never share, copy or commit them ===
POSTGRES_PASSWORD=
SMARTHOST_DB_OWNER_PASSWORD=
APP_DB_PASSWORD=
APP_WEBHOOK_DB_PASSWORD=
VALIDATOR_DB_PASSWORD=
DELIVERY_DB_PASSWORD=
APP_SECRET=
APP_ENCRYPTION_KEYS=
SMARTHOST_SUBMISSION_PASSWORD=
APP_MAIL_SUBMISSION_PASSWORD=
