# Smarthost pod: every Smarthost container runs in this pod and shares its
# network namespace. The pod alone joins the Internal=true network, carries the
# service aliases used by the environment contract, and publishes the only two
# loopback ports (nginx HTTPS, Mailpit UI).
[Unit]
Description=Smarthost pod (all Smarthost containers)
PartOf=smarthost.target

[Pod]
PodName=smarthost
Network=smarthost-internal.network
NetworkAlias=postgres
NetworkAlias=symfony-app
NetworkAlias=postfix
NetworkAlias=opendkim
NetworkAlias=mailpit
NetworkAlias=fake-smtp
PublishPort=${PROXY_HTTPS_BIND}:443
PublishPort=${MAILPIT_UI_BIND}:8025
Label=project=smarthost

[Install]
WantedBy=smarthost.target
