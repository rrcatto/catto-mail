[Unit]
Description=Smarthost Symfony webhook worker (placeholder process until Phase 7)
PartOf=smarthost.target
Wants=smarthost-db-grants.service
After=smarthost-db-grants.service

[Container]
ContainerName=smarthost-webhook-worker
Image=localhost/smarthost-app:dev
Pull=never
Pod=smarthost.pod
EnvironmentFile=@GENERATED@/env/webhook-worker.env
User=www-data
Exec=php /srv/probe/webhook-worker.php
HealthCmd=test -s /tmp/smarthost-worker-ok
HealthInterval=30s
HealthStartPeriod=20s
HealthRetries=3

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=smarthost.target
