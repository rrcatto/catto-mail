[Unit]
Description=Smarthost Python validator (Phase 1 probe process; unprivileged)
PartOf=smarthost.target
Wants=smarthost-db-grants.service
After=smarthost-db-grants.service

[Container]
ContainerName=smarthost-validator
Image=localhost/smarthost-validator:dev
Pull=never
Pod=smarthost.pod
EnvironmentFile=@GENERATED@/env/validator.env
HealthCmd=python /opt/smarthost/phase1_probe.py check-db
HealthInterval=60s
HealthStartPeriod=20s
HealthRetries=3

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=smarthost.target
