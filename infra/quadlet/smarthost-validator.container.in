[Unit]
Description=Smarthost Python validation worker (unprivileged; no public API)
PartOf=smarthost.target
Wants=smarthost-db-grants.service
After=smarthost-db-grants.service

[Container]
ContainerName=smarthost-validator
Image=localhost/smarthost-validator:dev
Pull=never
Pod=smarthost.pod
EnvironmentFile=@GENERATED@/env/validator.env
HealthCmd=python -m smarthost_validator health
HealthInterval=30s
HealthStartPeriod=20s
HealthRetries=3

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=smarthost.target
