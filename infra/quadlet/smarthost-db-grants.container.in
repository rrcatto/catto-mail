[Unit]
Description=Smarthost table grants after migrations (infrastructure, D-15)
PartOf=smarthost.target
Requires=smarthost-db-migrate.service
After=smarthost-db-migrate.service

[Container]
ContainerName=smarthost-db-grants
Image=docker.io/library/postgres:16.15-trixie
Pull=never
Pod=smarthost.pod
EnvironmentFile=@GENERATED@/env/bootstrap.env
Volume=@REPO@/infra/postgres:/bootstrap:ro
Entrypoint=/bootstrap/grants.sh

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=180

[Install]
WantedBy=smarthost.target
