[Unit]
Description=Smarthost Mailpit (development mail capture; never relays)
PartOf=smarthost.target

[Container]
ContainerName=smarthost-mailpit
Image=docker.io/axllent/mailpit:v1.31.0
Pull=never
Pod=smarthost.pod
# Image settings derived from contract variables (rendered from infra/.env).
Environment=MP_SMTP_BIND_ADDR=0.0.0.0:${MAILPIT_SMTP_PORT}
Environment=MP_UI_BIND_ADDR=0.0.0.0:8025
HealthCmd=/mailpit readyz
HealthInterval=15s
HealthStartPeriod=5s
HealthRetries=4
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=smarthost.target
