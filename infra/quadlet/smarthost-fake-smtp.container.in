[Unit]
Description=Smarthost deterministic fake SMTP service (development/test)
PartOf=smarthost.target

[Container]
ContainerName=smarthost-fake-smtp
Image=localhost/smarthost-fake-smtp:dev
Pull=never
Network=smarthost-internal.network
NetworkAlias=fake-smtp
EnvironmentFile=@GENERATED@/env/fake-smtp.env
HealthCmd=python /opt/fake-smtp/fake_smtp.py --check
HealthInterval=15s
HealthStartPeriod=5s
HealthRetries=4
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=60

[Install]
WantedBy=smarthost.target
