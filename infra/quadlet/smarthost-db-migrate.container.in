[Unit]
Description=Smarthost Doctrine migrations (schema owner smarthost_owner; D-15)
PartOf=smarthost.target
Requires=smarthost-db-bootstrap.service
After=smarthost-db-bootstrap.service

[Container]
ContainerName=smarthost-db-migrate
Image=localhost/smarthost-app:dev
Pull=never
Pod=smarthost.pod
EnvironmentFile=@GENERATED@/env/app.env
User=www-data
Exec=php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=smarthost.target
