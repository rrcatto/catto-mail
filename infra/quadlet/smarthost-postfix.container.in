[Unit]
Description=Smarthost Postfix (capture mode unless SMARTHOST_LIVE_DELIVERY_ENABLED=true in production)
PartOf=smarthost.target
Wants=smarthost-opendkim.service smarthost-mailpit.service
After=smarthost-opendkim.service smarthost-mailpit.service

[Container]
ContainerName=smarthost-postfix
Image=localhost/smarthost-postfix:dev
Pull=never
Network=smarthost-internal.network
NetworkAlias=postfix
EnvironmentFile=@GENERATED@/env/postfix.env
Secret=smarthost-postfix-tls-cert,type=mount,target=${POSTFIX_TLS_CERT_FILE}
Secret=smarthost-postfix-tls-key,type=mount,target=${POSTFIX_TLS_KEY_FILE}
Volume=smarthost-postfix-queue.volume:/var/spool/postfix
Volume=smarthost-postfix-observability.volume:${SMARTHOST_POSTFIX_OBSERVABILITY_DIR}
Volume=smarthost-dsn-spool.volume:${SMARTHOST_DSN_SPOOL_DIR}
HealthCmd=smarthost-postfix-healthcheck
HealthInterval=15s
HealthStartPeriod=15s
HealthRetries=4
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=180

[Install]
WantedBy=smarthost.target
