[Unit]
Description=Smarthost OpenDKIM milter (reachable from Postfix only; holds DKIM keys)
PartOf=smarthost.target

[Container]
ContainerName=smarthost-opendkim
Image=localhost/smarthost-opendkim:dev
Pull=never
Network=smarthost-internal.network
NetworkAlias=opendkim
EnvironmentFile=@GENERATED@/env/opendkim.env
Volume=smarthost-opendkim-keys.volume:${OPENDKIM_KEY_DIR}
Volume=smarthost-opendkim-tables.volume:${OPENDKIM_TABLES_DIR}
HealthCmd=nc -z 127.0.0.1 8891
HealthInterval=15s
HealthStartPeriod=5s
HealthRetries=4
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=smarthost.target
