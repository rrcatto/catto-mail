# Starts and stops the persistent Smarthost topology (D-35) with the engine
# host's user manager, i.e. when the Podman machine (development) or the
# production host (Phase 8, lingering user) boots and shuts down. It drives the
# rendered topology script: smarthost-pod.sh (the development pod) or
# smarthost-production.sh (the production containers and networks). It never
# creates or removes containers: ExecStop only stops them, and there is
# deliberately no ExecStopPost. In development the pod may equally be stopped and
# started from Podman Desktop or with `podman pod stop|start smarthost`; this
# unit then keeps its last state and does not interfere.
#
# The script talks to the user's Podman API socket (CONTAINER_HOST), so the
# containers' conmon processes belong to podman.service exactly as when Podman
# Desktop starts the pod, not to this unit's cgroup; KillMode=process keeps a
# failed or stopped unit from killing anything but its own script.
[Unit]
Description=Smarthost persistent topology (@TOPOLOGY@ start/stop; never removes containers)
Wants=podman.socket smarthost-postfix-queue-snapshot.timer smarthost-postfix-logrotate.timer
After=podman.socket

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=CONTAINER_HOST=unix://%t/podman/podman.sock
KillMode=process
ExecStart=@GENERATED@/podman/@TOPOLOGY@ start
ExecStop=@GENERATED@/podman/@TOPOLOGY@ stop
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=default.target
