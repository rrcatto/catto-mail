# catto-mail production ingress sockets (specification 2.9, Phase 8 networking).
# Rendered by `smarthostctl prod render` as <instance>-ingress.socket; do not edit
# the rendered copy. Production only: the development pod publishes its ports.
#
# The service user's systemd binds the public HTTPS and SMTP listeners in the host's
# network namespace and hands both sockets to nginx (<instance>-ingress.service).
# nginx accepts every connection on them itself, so it sees the client's real
# address. Rootless port forwarding (rootlessport, pasta) would show nginx and Postfix
# one internal address for every client instead.
#
# Ports below 1024 need net.ipv4.ip_unprivileged_port_start=25 on the host
# (runbook §1; `smarthostctl prod preflight --section host` checks it). The topology
# script starts this socket and its service with the other containers and stops both
# on `stop`. It is not started on its own at boot.
[Unit]
Description=catto-mail ingress sockets ${SMARTHOST_INSTANCE}: HTTPS ${PROXY_HTTPS_BIND}, SMTP ${POSTFIX_SMTP_BIND}

[Socket]
# Inherited as fd 3 (HTTPS) and fd 4 (SMTP). nginx matches inherited sockets to its
# listen directives by address, so it listens on exactly these two addresses.
ListenStream=${PROXY_HTTPS_BIND}
ListenStream=${POSTFIX_SMTP_BIND}
Service=${SMARTHOST_INSTANCE}-ingress.service
