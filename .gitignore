# Filled-in environment files and secrets must never be committed.
.env
.env.*
!.env.example
infra/.env
infra/*.env
!infra/.env.example
secrets/
*.pem
*.key

# Phase 1 generated per-service env files, rendered units and dev TLS material.
infra/.generated/

# Python generated files (bytecode, test/coverage/linter caches).
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Per-user Claude Code permissions (never committed).
.claude/settings.local.json

# Third-party design references used for mockups (not ours to publish).
docs/designs/

# The operator's own TLS certificate files (private key inside): never in the repository.
SSL_certificate/
