{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Unmatched bounces{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>Unmatched bounces</h1>
        <p class="lead">Bounce reports (DSNs) that name no message of this installation.{{ ui.tip('They change no message and create no suppression until an operator requests a match and the delivery daemon applies it, or dismisses them.') }}</p>
    </div>
    <div class="actions">{{ ui.help('bounces', 'Help: bounces') }}</div>
</div>

<nav class="chips" aria-label="Views of the unmatched bounces">
    {% for value, text in label_options('dsn_status')|merge({'': 'Everything'}) %}<a class="chip-link" href="{{ path('dashboard_operator_dsns', {status: value}|merge(filters.classification ? {classification: filters.classification} : {})) }}"{% if filters.status == value %} aria-current="page"{% endif %}>{{ value == 'match_requested' ? 'Match requested' : text }}</a>{% endfor %}
</nav>
<details class="morefilters"{% if filters.classification %} open{% endif %}>
    <summary>More filters: classification</summary>
    <form method="get" class="filters" role="search" aria-label="Filter unmatched bounces">
        <input type="hidden" name="status" value="{{ filters.status }}">
        {{ ui.select('classification', 'Classification', {hard_bounce: 'Hard bounce', soft_bounce: 'Soft bounce', deferred: 'Deferred', connection_failure: 'Connection failure', complaint: 'Complaint', malformed_or_unmatched_dsn: 'Malformed or unmatched'}, filters.classification) }}
        <input type="hidden" name="dir" value="{{ listing.dir }}">
        <button type="submit">Apply</button>
    </form>
</details>

<section class="card card-flush" aria-labelledby="dsn-list-h">
    <div class="card-head"><h2 id="dsn-list-h">{{ filters.status ? filters.status|label('dsn_status')|split(' (')|first : 'Every unmatched bounce' }}</h2></div>
    {% if page.rows is empty %}<p class="empty">Nothing here.</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">{{ ui.sort(listing, 'received', 'Received') }}</th><th scope="col">Recipient</th><th scope="col">Kind</th><th scope="col">Code</th><th scope="col" class="num">Candidates</th>{% if not filters.status %}<th scope="col">Status</th>{% endif %}</tr></thead>
        <tbody>{% for d in page.rows %}
            <tr><td class="nowrap"><a href="{{ path('dashboard_operator_dsn', {id: d.id}) }}" title="{{ d.received_at|ts }}">{{ d.received_at|when }}</a></td>
                <td class="url">{{ d.final_recipient ?? d.original_recipient ?? '—' }}</td><td>{{ d.classification|replace({'_': ' '})|capitalize }}</td>
                <td>{{ d.enhanced_status_code ?? '—' }}{% if d.reporting_mta %} {{ ui.tip('Reported by ' ~ d.reporting_mta) }}{% endif %}</td><td class="num">{{ d.candidates }}</td>
                {% if not filters.status %}<td>{{ ui.status(d.status, 'dsn_status') }}</td>{% endif %}</tr>
        {% endfor %}</tbody>
    </table></div>
    {% endif %}
</section>
{{ ui.pager(page, 'bounces') }}
{% endblock %}
