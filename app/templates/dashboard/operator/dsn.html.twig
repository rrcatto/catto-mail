{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Unmatched DSN{% endblock %}
{% block body %}
<p class="crumbs"><a href="{{ path('dashboard_operator_dsns') }}">Unmatched DSNs</a> › DSN</p>
<h1>Unmatched DSN received {{ dsn.receivedAt|ts }}</h1>
<div class="cards">
    <section class="card">
        <h2>Parsed evidence</h2>
        <dl>
            <dt>Status</dt><dd>{{ ui.status(dsn.status.value, 'dsn_status') }}</dd>
            <dt>Classification</dt><dd>{{ dsn.classification.value|replace({'_': ' '})|capitalize }}</dd>
            <dt>Original recipient</dt><dd>{{ dsn.originalRecipient ?? '—' }}</dd>
            <dt>Final recipient</dt><dd>{{ dsn.finalRecipient ?? '—' }}</dd>
            <dt>Enhanced status code</dt><dd>{{ dsn.enhancedStatusCode ?? '—' }}</dd>
            <dt>Reporting MTA</dt><dd>{{ dsn.reportingMta ?? '—' }}</dd>
            <dt>Postfix queue id</dt><dd>{{ dsn.postfixQueueId ?? '—' }}</dd>
            <dt>VERP token present</dt><dd>{{ dsn.verpToken ? 'Yes (names no message)' : 'No' }}</dd>
            {% for k, v in detail %}<dt>{{ k|replace({'_': ' '})|capitalize }}</dt><dd>{{ v is iterable ? v|json_encode : v }}</dd>{% endfor %}
        </dl>
    </section>
    <section class="card">
        <h2>Resolution</h2>
        <dl>
            <dt>Requested by</dt><dd>{{ dsn.resolutionRequestedBy ? dsn.resolutionRequestedBy.email : '—' }}</dd>
            <dt>Requested at</dt><dd>{{ dsn.resolutionRequestedAt|ts }}</dd>
            <dt>Resolved at</dt><dd>{{ dsn.resolvedAt|ts }}</dd>
            <dt>Note / reason</dt><dd>{{ dsn.resolutionNote ?? '—' }}</dd>
            <dt>Matched message</dt><dd>{% if matched %}<a href="{{ path('dashboard_client_message', {clientId: matched.client_id, messageId: matched.id}) }}">{{ matched.recipient_address }}</a> ({{ matched.current_status|label('message_status') }}){% else %}—{% endif %}</dd>
        </dl>
        {% if failures is not empty %}
            <h3>Earlier match attempts the daemon could not apply</h3>
            <ul>{% for f in failures %}<li>{{ f is iterable ? f|json_encode : f }}</li>{% endfor %}</ul>
        {% endif %}
    </section>
</div>

<h2>Candidate messages</h2>
<p class="muted">Recent messages to the same recipient, recorded by the delivery daemon as hints only. A recipient address (even with a matching sender) is never enough to apply a DSN automatically.</p>
{% if candidates is empty %}<p class="empty">No candidates were recorded.</p>{% else %}
<table>
    <thead><tr><th scope="col">Message</th><th scope="col">Client</th><th scope="col">Sender</th><th scope="col">Status</th><th scope="col">Queue id</th><th scope="col">Created</th></tr></thead>
    <tbody>{% for m in candidates %}
        <tr><td><code>{{ m.id }}</code><br><small>{{ m.recipient_address }}</small></td><td>{{ m.company_name }}</td><td>{{ m.sender_email }}</td><td>{{ m.current_status|label('message_status') }}</td><td>{{ m.postfix_queue_id ?? '—' }}</td><td>{{ m.created_at|ts }}</td></tr>
    {% endfor %}</tbody>
</table>
{% endif %}

{% if dsn.status.value == 'open' and is_granted('PLATFORM.DSN.MANAGE') %}
<div class="cards">
    <section class="card">
        <h2>Request a match</h2>
        <form method="post" action="{{ path('dashboard_operator_dsn_match', {id: dsn.id.toRfc4122}) }}" class="stack" data-controller="confirm" data-confirm-message-value="Request this match? The delivery daemon will apply the DSN to that message, which may create a suppression.">
            {{ ui.csrf() }}
            <label>Message id <input type="text" name="message_id" required pattern="[0-9a-fA-F-]{36}" list="candidate-ids" autocomplete="off"></label>
            <datalist id="candidate-ids">{% for m in candidates %}<option value="{{ m.id }}">{{ m.company_name }} – {{ m.recipient_address }}</option>{% endfor %}</datalist>
            <label>Note (optional) <input type="text" name="note"></label>
            <button type="submit">Request match</button>
        </form>
        <p class="muted">The request is queued for the delivery daemon, which re-reads the stored DSN and records the outcome. This page never creates message events.</p>
    </section>
    <section class="card">
        <h2>Dismiss</h2>
        <form method="post" action="{{ path('dashboard_operator_dsn_dismiss', {id: dsn.id.toRfc4122}) }}" class="stack">
            {{ ui.csrf() }}
            <label>Reason (required) <textarea name="reason" required minlength="3" rows="3"></textarea></label>
            <button type="submit">Dismiss DSN</button>
        </form>
    </section>
</div>
{% endif %}

<details>
    <summary>Raw DSN as received</summary>
    <pre class="raw">{{ dsn.rawMessage }}</pre>
</details>
{% endblock %}
