{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Abuse and reputation{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>Abuse &amp; reputation</h1>
        <p class="lead">Clients whose bounces, complaints or volume crossed a threshold. Last evaluated {{ computed_at ? computed_at|ago : 'never' }}.{{ ui.tip('Metrics are transport facts counted by event time in a window; rates are of the messages submitted in that window. Alerts come from the APP_REPUTATION_* thresholds and never act on a client by themselves: throttle or suspend on the client\'s page. Evaluated every 15 minutes in production.') }}</p>
    </div>
    <form method="post" action="{{ path('dashboard_operator_alerts_evaluate') }}">{{ ui.csrf() }}<button type="submit" class="secondary">Evaluate now</button></form>
</div>

<nav class="chips" aria-label="Views of the alerts">
    {% for key, label in {'': 'Open', resolved: 'Resolved', all: 'Every alert'} %}<a class="chip-link" href="{{ path('dashboard_operator_alerts', (key ? {state: key} : {})|merge(filters.client ? {client: filters.client} : {})) }}"{% if filters.state == key %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
</nav>
<details class="morefilters"{% if filters.severity or filters.metric %} open{% endif %}>
    <summary>More filters: severity, metric</summary>
    <form method="get" class="filters" role="search" aria-label="Filter alerts">
        <input type="hidden" name="state" value="{{ filters.state }}">
        {{ ui.select('severity', 'Severity', label_options('alert_severity'), filters.severity) }}
        {{ ui.select('metric', 'Metric', label_options('alert_metric'), filters.metric) }}
        {% if filters.client %}<input type="hidden" name="client" value="{{ filters.client }}">{% endif %}
        <button type="submit">Apply</button>
    </form>
</details>

<section class="card card-flush" aria-labelledby="alerts-h">
    <div class="card-head"><h2 id="alerts-h">{{ {resolved: 'Resolved alerts', all: 'Every alert'}[filters.state] ?? 'Open alerts' }}</h2></div>
    {% if page.rows is empty %}<p class="empty">{{ filters.state ? 'No alerts match.' : 'No open alerts: every client is within its thresholds.' }}</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">Client</th><th scope="col">Alert</th><th scope="col">Severity</th><th scope="col" class="num">Value / threshold</th><th scope="col">{{ ui.sort(listing, 'observed', 'Last seen') }}</th><th scope="col">State</th></tr></thead>
        <tbody>{% for a in page.rows %}
            {% set u = a.metric == 'volume_increase' ? '×' : ' %' %}
            <tr><td><a href="{{ path('dashboard_operator_client', {id: a.client_id, tab: 'reputation'}) }}">{{ a.company_name }}</a>{% if a.client_status != 'active' %} {{ ui.status(a.client_status, 'client_status') }}{% endif %}</td>
                <td>{{ a.metric|label('alert_metric') }} <span class="muted">({{ a.window_hours == 24 ? '24 h' : '7 d' }})</span></td>
                <td><span class="st st-sev-{{ a.severity }}">{{ a.severity|label('alert_severity') }}</span></td>
                <td class="num">{{ a.value }}{{ u }} / {{ a.threshold }}{{ u }} {{ ui.tip(a.numerator ~ ' of ' ~ a.denominator ~ ' · first seen ' ~ (a.first_observed_at|ts)) }}</td>
                <td class="nowrap" title="{{ a.last_observed_at|ts }}">{{ a.last_observed_at|when }}</td>
                <td>{% if a.resolved_at %}Resolved {{ a.resolved_at|when }}{% elseif a.acknowledged_at %}Acknowledged {{ ui.tip(a.acknowledged_by ~ ': ' ~ a.acknowledgement_note) }}{% else %}
                    {% if is_granted('PLATFORM.ABUSE.MANAGE') %}
                    <details class="actionform rowaction"><summary class="btn btn-secondary">Acknowledge</summary>
                    <form method="post" action="{{ path('dashboard_operator_alert_ack', {id: a.id}) }}" class="stack">{{ ui.csrf() }}
                        <label>What you found or did <input type="text" name="note" required minlength="3" maxlength="1000"></label><button type="submit">Acknowledge</button></form></details>
                    {% else %}<span class="st st-open">Open</span>{% endif %}{% endif %}</td></tr>
        {% endfor %}</tbody>
    </table></div>
    {% endif %}
</section>
{{ ui.pager(page, 'alerts') }}

<section class="card card-flush" aria-labelledby="metrics-h">
    <div class="card-head">
        <h2 id="metrics-h">Clients, riskiest first</h2>{{ ui.tip('Complaint rate first, then hard-bounce rate, over the window.') }}
        <nav class="seg" aria-label="Window">
            <a href="{{ path('dashboard_operator_alerts', {window: 24}) }}"{% if window == 24 %} aria-current="page"{% endif %}>24 hours</a>
            <a href="{{ path('dashboard_operator_alerts', {window: 168}) }}"{% if window != 24 %} aria-current="page"{% endif %}>7 days</a>
        </nav>
    </div>
    {% if reputation is empty %}<p class="empty">No client had traffic in the window, or no evaluation has run.</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">Client</th><th scope="col" class="num">Submitted</th><th scope="col" class="num">Hard bounces</th><th scope="col" class="num">Complaints</th><th scope="col" class="num">Open alerts</th><th scope="col"><span class="sr">Details</span></th></tr></thead>
        <tbody>{% for m in reputation|slice(0, 10) %}<tr>
            <td><a href="{{ path('dashboard_operator_client', {id: m.client_id, tab: 'reputation'}) }}">{{ m.company_name }}</a>{% if m.client_status != 'active' %} {{ ui.status(m.client_status, 'client_status') }}{% endif %}</td>
            <td class="num">{{ m.messages_submitted|number_format }}</td>
            <td class="num">{{ m.hard_bounce_rate is not null ? m.hard_bounce_rate ~ ' %' : '—' }}</td>
            <td class="num">{{ m.complaint_rate is not null ? m.complaint_rate ~ ' %' : '—' }}</td>
            <td class="num">{% if m.open_alerts > 0 %}<strong class="text-bad">{{ m.open_alerts }}</strong>{% else %}0{% endif %}</td>
            <td class="tipcell">{{ ui.tip('Validation ' ~ m.validation_addresses ~ ' · hard bounces ' ~ m.hard_bounces ~ ' · complaints ' ~ m.complaints ~ ' · deferred ' ~ m.deferrals ~ ' · provider policy ' ~ m.provider_policy_failures ~ ' · suppressed ' ~ m.suppressed ~ ' · outcome unknown ' ~ m.outcome_unknown ~ ' · webhook failures ' ~ m.webhook_failures) }}</td></tr>{% endfor %}</tbody>
    </table></div>
    {% endif %}
</section>
{% endblock %}
