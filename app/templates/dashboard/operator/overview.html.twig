{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% import 'dashboard/_icons.html.twig' as icon %}
{% block title %}Overview{% endblock %}
{% block body %}
{% set ds = delivery_status() %}
{% set mode_words = {HELD: 'nothing goes to the Internet yet', LIVE: 'mail goes out to the Internet', PAUSED: 'the emergency stop is in force', STOPPED: 'the delivery daemon is not running'} %}
<div class="pagehead">
    <div>
        <h1>Overview</h1>
        <p class="lead">Delivery is <strong class="mode-word mode-word-{{ ds.mode }}">{{ ds.mode }}</strong>: {{ mode_words[ds.mode] ?? ds.explanation }}.
            {% if attention is empty %}Nothing needs you.{% else %}<a href="#attention">{{ attention|length }} thing{{ attention|length == 1 ? '' : 's' }} need{{ attention|length == 1 ? 's' : '' }} you.</a>{% endif %}</p>
    </div>
    <nav class="seg" aria-label="Period">
        {% for key, label in periods %}<a href="{{ path('dashboard_operator_overview', {period: key}) }}"{% if key == period.key %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
    </nav>
</div>

{% if attention is not empty %}
<section class="card" id="attention" aria-labelledby="att-h">
    <h2 id="att-h">Needs attention</h2>
    <ul class="att-tiles">
        {% for a in attention %}
        <li>{% if a.href %}<a class="att-tile att-tile-{{ a.tone }}" href="{{ a.href }}">{% else %}<div class="att-tile att-tile-{{ a.tone }}">{% endif %}
            <span class="att-mark att-{{ a.tone }}" aria-hidden="true">{{ icon.i(a.icon, 18) }}</span>
            <span class="att-text"><span class="att-title">{{ a.title }}</span><span class="att-meta">{{ a.meta }}</span></span>
            {% if a.href %}{{ icon.i('chevron', 16) }}</a>{% else %}</div>{% endif %}</li>
        {% endfor %}
    </ul>
</section>
{% endif %}

{% include 'dashboard/_kpis.html.twig' %}

{% include 'dashboard/_flow_card.html.twig' with {flow_title: 'Messages per ' ~ period.unit, more: is_granted('PLATFORM.SYSTEM.VIEW') ? {label: 'Delivery details', href: path('dashboard_operator_system')} : null} %}

<div class="grid">
    <section class="card g-col-4 lg:g-col-2" aria-labelledby="cl-h">
        <div class="card-head">
            <h2 id="cl-h">Clients to watch</h2>
            {% if is_granted('PLATFORM.CLIENT.VIEW') %}<a class="more" href="{{ path('dashboard_operator_clients') }}">All clients</a>{% endif %}
        </div>
        {% if rates is empty %}<p class="empty">No client sent anything in the last {{ period.label }}.</p>{% else %}
        <div class="scroll"><table class="list">
            <thead><tr><th scope="col">Client</th><th scope="col" class="num">Messages</th><th scope="col" class="num">Hard bounces</th><th scope="col" class="num">Complaints</th></tr></thead>
            <tbody>{% for r in rates|slice(0, 5) %}
                <tr>
                    <td><a href="{{ path('dashboard_operator_client', {id: r.client_id}) }}">{{ r.company_name }}</a>{% if r.client_status != 'active' %} {{ ui.status(r.client_status, 'client_status') }}{% endif %}</td>
                    <td class="num">{{ r.reached_postfix|number_format }}</td>
                    <td class="num rate-{{ r.hard_meter.tone ?? 'ok' }}">{{ r.hard_bounce_rate ?? '—' }}{{ r.hard_bounce_rate is not null ? ' %' : '' }}</td>
                    <td class="num rate-{{ r.complaint_meter.tone ?? 'ok' }}">{{ r.complaint_rate ?? '—' }}{{ r.complaint_rate is not null ? ' %' : '' }}</td>
                </tr>
            {% endfor %}</tbody>
        </table></div>
        <p class="card-note">Worst first, last {{ period.label }}. Warning at {{ thresholds.hard.warning }} % hard bounces and {{ thresholds.complaint.warning }} % complaints.</p>
        {% endif %}
    </section>

    {% if health %}
    <section class="card g-col-4 lg:g-col-2" aria-labelledby="hl-h">
        <div class="card-head"><h2 id="hl-h">System health</h2><a class="more" href="{{ path('dashboard_operator_diagnostics') }}">Diagnostics</a></div>
        {% set not_checked = health.rows|filter(r => r.result in ['none', 'skipped'])|length %}
        {% set problems = health.rows|filter(r => r.result in ['warn', 'fail']) %}
        {% if health.last %}
        <p class="health-line"><strong>{{ health.pass }} of {{ health.total }}</strong> components pass{% if problems|length %} · <span class="text-warn">{{ problems|length }} need{{ problems|length == 1 ? 's' : '' }} you</span>{% endif %}{% if not_checked %} · {{ not_checked }} not checked{% endif %}</p>
        {% if problems is empty %}<p class="muted">Every checked component passes. Checked {{ health.last|ago }}.</p>{% else %}
        <ul class="plainlist">{% for r in problems %}<li>{{ ui.result(r.result) }} {{ r.label }}</li>{% endfor %}</ul>
        <p class="card-note">Checked {{ health.last|ago }}.</p>{% endif %}
        {% else %}<p class="empty">No check has run yet.</p>{% endif %}
    </section>
    {% endif %}
</div>
{% endblock %}
