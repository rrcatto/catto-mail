{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Users{% endblock %}
{% block body %}
{% set manage = is_granted('PLATFORM.USER.MANAGE') %}
<div class="pagehead">
    <div>
        <h1>Users</h1>
        <p class="lead">Everyone who can sign in to the dashboard.{{ ui.tip('Everyone signs in with an emailed single-use link; there are no passwords. Installation-wide access comes from roles; access to a client\'s own pages comes from a client membership.') }}</p>
    </div>
    {% if manage %}
    <details class="actionform" id="add-user"><summary class="btn">Add a user</summary>
        <form method="post" action="{{ path('dashboard_operator_user_create') }}" class="stack">
            {{ ui.csrf() }}
            <label>Email <input type="email" name="email" required maxlength="320"></label>
            <label>Name (optional) <input type="text" name="display_name" maxlength="200"></label>
            <label>Role (optional)
                <select name="role_id"><option value="">None</option>{% for r in roles %}{% if r.roleKey != 'ADMIN' or is_granted('SYSTEM.ROLE.MANAGE') %}<option value="{{ r.id.toRfc4122 }}">{{ r.roleKey }} – {{ r.name }}</option>{% endif %}{% endfor %}</select>
            </label>
            <label>Client (optional)
                <select name="client_id"><option value="">None</option>{% for c in clients %}<option value="{{ c.id }}">{{ c.company_name }}</option>{% endfor %}</select>
            </label>
            <label>Client role
                <select name="membership_role">{% for m in membership_roles %}<option value="{{ m.value }}">{{ m.value|capitalize }}</option>{% endfor %}</select>
            </label>
            <label class="checkline"><input type="checkbox" name="send_link" value="1" checked> Email them a sign-in link now</label>
            <button type="submit">Add user</button>
        </form>
    </details>
    {% endif %}
</div>
<form method="get" class="searchline" role="search" aria-label="Find a user">
    <label class="sr" for="user-q">Email or name contains</label>
    <input id="user-q" type="search" name="q" value="{{ filters.q }}" placeholder="Find a user by email or name">
    <button type="submit">Find</button>
</form>
<nav class="chips" aria-label="Views of the users">
    {% for key, label in {'': 'Everyone', active: 'Active', disabled: 'Disabled'} %}<a class="chip-link" href="{{ path('dashboard_operator_users', key ? {status: key} : {}) }}"{% if not filters.q and not filters.role and filters.status == key %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
    {% for r in roles %}<a class="chip-link" href="{{ path('dashboard_operator_users', {role: r.roleKey}) }}"{% if filters.role == r.roleKey %} aria-current="page"{% endif %}>{{ r.roleKey|lower|capitalize }}</a>{% endfor %}
</nav>
<section class="card card-flush" aria-labelledby="users-h">
    <div class="card-head"><h2 id="users-h">{{ filters.q ? 'Users matching “' ~ filters.q ~ '”' : 'People' }}</h2></div>
    {% if page.rows is empty %}<p class="empty">No users match.</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">{{ ui.sort(listing, 'email', 'User') }}</th><th scope="col">Status</th><th scope="col">Roles</th><th scope="col">Last sign-in</th><th scope="col"><span class="sr">Details</span></th></tr></thead>
        <tbody>{% for u in page.rows %}
            <tr><td><a href="{{ path('dashboard_operator_user', {id: u.id}) }}">{{ u.email }}</a>{% if u.display_name %} <span class="muted">{{ u.display_name }}</span>{% endif %}</td>
                <td>{{ ui.status(u.status, 'none') }}</td><td>{% if u.roles %}{% for r in u.roles|split(',') %}<span class="tag">{{ r|trim }}</span>{% endfor %}{% else %}<span class="muted">none</span>{% endif %}</td>
                <td>{{ u.last_login_at ? u.last_login_at|when : 'never' }}</td>
                <td class="tipcell">{{ ui.tip(u.memberships ~ ' client membership' ~ (u.memberships == 1 ? '' : 's') ~ ' · created ' ~ (u.created_at|ts)) }}</td></tr>
        {% endfor %}</tbody>
    </table></div>
    {% endif %}
</section>
{{ ui.pager(page, 'users') }}
{% endblock %}
