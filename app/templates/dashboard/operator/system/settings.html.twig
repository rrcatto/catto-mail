{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Settings{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>Settings</h1>
        <p class="lead">{% if state is null %}<strong class="text-warn">The settings in force are not visible yet</strong>: run <code>infra/bin/smarthostctl {{ environment == 'production' ? 'prod ' : '' }}recreate</code> once on the server.
            {% elseif pending > 0 %}<strong class="text-warn">{{ pending }} {{ pending == 1 ? 'change is' : 'changes are' }} waiting to be applied.</strong>
            {% else %}Every setting is in force.{% endif %}
            {{ ui.tip('A value set here takes precedence over the configuration file (infra/.env) without changing it; empty a field to use the file\'s value again. Applying restarts the services that use the changed settings (a time zone change restarts every service). Secrets, the database, networks, certificates, host names and the live-delivery switch are set only in the file.' ~ (state ? ' Last rendered ' ~ (state.rendered_at|ts) ~ '.' : '') ~ (last_apply ? ' Last apply request: ' ~ last_apply.status ~ ', ' ~ (last_apply.requested_at|ts) ~ (last_apply.result_summary ? ': ' ~ last_apply.result_summary : '') ~ '.' : '')) }}</p>
        {% if state and state.errors is not empty %}<p class="warn"><strong>The last render ignored every dashboard value:</strong> {{ state.errors|join(' ') }}</p>{% endif %}
        {% if pending > 0 and environment != 'production' %}<p class="muted small">In development, apply them with <code>infra/bin/smarthostctl settings-apply</code>.</p>{% endif %}
        {% if can_manage and environment == 'production' and pending > 0 and agent_age is null %}<p class="warn">The host agent has never reported, so nothing is applied until it runs (<code>smarthostctl prod install</code>).</p>{% endif %}
    </div>
    <div class="actions">
        {{ ui.help('settings', 'Help: settings') }}
        {% if can_manage and environment == 'production' and pending > 0 %}
        <form method="post" action="{{ path('dashboard_operator_settings_apply') }}">{{ ui.csrf() }}<button type="submit">Apply changes</button></form>
        {% endif %}
    </div>
</div>

<nav class="chips" aria-label="Groups of settings">
    {% for g in groups %}{% set waiting = g.rows|filter(r => r.pending)|length %}<a class="chip-link" href="{{ path('dashboard_operator_settings', {group: g.slug}) }}"{% if g.slug == current %} aria-current="page"{% endif %}>{{ g.title }}{% if waiting %} <span class="count count-warn">{{ waiting }}</span>{% endif %}</a>{% endfor %}
</nav>

{% for g in groups|filter(g => g.slug == current) %}
<section class="card card-flush" id="{{ g.slug }}" aria-labelledby="{{ g.slug }}-h">
    <div class="card-head"><h2 id="{{ g.slug }}-h">{{ g.title }}</h2></div>
    <div class="scroll"><table class="list table-settings">
        <thead><tr><th scope="col">Setting</th><th scope="col">In force</th><th scope="col">{{ can_manage ? 'Change it' : 'Set in the dashboard' }}</th><th scope="col"><span class="sr">Details</span></th></tr></thead>
        <tbody>{% for name, s in g.rows %}<tr>
            <td><label for="v-{{ name }}">{{ s.label }}</label></td>
            <td><strong>{{ s.in_force is null ? '—' : (s.in_force is same as('') ? 'empty' : s.in_force) }}</strong>
                {% if s.pending %} <span class="tag tag-warn">waiting to be applied</span>{% endif %}
                {% if s.ignored %} <span class="tag tag-bad">ignored: {{ s.ignored }}</span>{% endif %}</td>
            <td>{% if can_manage %}
                {% if s.kind == 'choice' %}
                    <select id="v-{{ name }}" name="value[{{ name }}]" form="f-{{ g.slug }}"><option value="">Use infra/.env</option>{% for c in s.choices %}<option value="{{ c }}"{% if s.override and s.override.value == c %} selected{% endif %}>{{ c }}</option>{% endfor %}</select>
                {% else %}
                    <input id="v-{{ name }}" name="value[{{ name }}]" form="f-{{ g.slug }}" type="text" value="{{ s.override.value ?? '' }}" placeholder="{{ s.config ?? '' }}"
                        {% if s.kind == 'integer' %}inputmode="numeric"{% elseif s.kind == 'decimal' %}inputmode="decimal"{% endif %} autocomplete="off" spellcheck="false">
                {% endif %}
            {% else %}{{ s.override.value ?? '—' }}{% endif %}</td>
            <td class="tipcell">{{ ui.tip(name ~ ' · in infra/.env: ' ~ (s.config is null ? '—' : (s.config is same as('') ? 'empty' : s.config)) ~ (s.min is defined ? ' · ' ~ s.min ~ ' to ' ~ s.max ~ (s.empty|default(false) ? ', or empty' : '') : '') ~ (s.override ? ' · set by ' ~ (s.override.updated_by ?? 'system') ~ ', ' ~ (s.override.updated_at|ts) ~ ': ' ~ s.override.reason : '')) }}</td>
        </tr>{% endfor %}</tbody>
    </table></div>
    {% if can_manage %}
    <form method="post" action="{{ path('dashboard_operator_settings_save') }}" id="f-{{ g.slug }}" class="card-foot form-grid">{{ ui.csrf() }}
        <input type="hidden" name="group" value="{{ g.title }}">
        <label>Why? (kept in the audit log) <input type="text" name="reason" minlength="3" maxlength="1000"></label>
        <div class="form-actions"><button type="submit">Save {{ g.title|lower }}</button></div>
    </form>{% endif %}
</section>
{% endfor %}
{% endblock %}
