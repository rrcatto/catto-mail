{# Delivery mode and its controls (specification 2.11). Variables: delivery (DeliveryControl::status). #}
{% import 'dashboard/_macros.html.twig' as ui %}
{% set d = delivery %}
<section class="card mode-card" aria-labelledby="delivery-h">
    <div class="mode-hero">
        <span class="mode-orb mode-orb-{{ d.mode }}" aria-hidden="true"><span class="dot mode-{{ d.mode }}"></span></span>
        <div>
            <h2 id="delivery-h">Delivery mode: <span class="mode mode-{{ d.mode }}">{{ d.mode }}</span></h2>
            <p>{{ d.explanation }}</p>
        </div>
    </div>
    <ol class="modetrack" aria-label="The four delivery modes">
        {% for m in ['HELD', 'LIVE', 'PAUSED', 'STOPPED'] %}<li{% if m == d.mode %} class="is-current" aria-current="step"{% endif %}><span class="dot mode-{{ m }}" aria-hidden="true"></span>{{ m }}</li>{% endfor %}
    </ol>
    <dl class="facts">
        <div><dt>Emergency stop</dt><dd>{% if d.emergency_stop %}<strong>IN FORCE</strong> since {{ d.stop_changed_at|ts }} — {{ d.stop_note }}{% else %}not in force{% endif %}</dd></div>
        <div><dt>Delivery daemon heartbeat</dt><dd>{{ d.heartbeat_age is null ? 'never' : (d.heartbeat_age|duration ~ ' ago') }}</dd></div>
        <div><dt>Installation-wide rate ceiling</dt><dd>{{ d.global_rate_per_minute ?? '—' }} messages per minute <small>(DELIVERY_GLOBAL_RATE_PER_MINUTE)</small></dd></div>
        <div><dt>Postfix queue</dt><dd>{% if d.queue %}{{ d.queue.active }} active, {{ d.queue.deferred }} deferred, {{ d.queue.hold }} held, {{ d.queue.incoming }} incoming <small>(snapshot {{ d.queue_snapshot_age|duration }} old)</small>{% else %}no snapshot yet{% endif %}</dd></div>
    </dl>
    {% if is_granted('SYSTEM.DELIVERY.CONTROL') %}
    <div class="controls">
        {% if d.emergency_stop %}
        <form method="post" action="{{ path('dashboard_operator_resume') }}" class="control stack">
            <h3>Resume sending</h3>
            {{ ui.csrf() }}
            <label>Why it is safe to resume (kept in the audit log) <input name="note" required minlength="3" maxlength="1000"></label>
            <label>Type <code>RESUME SENDING</code> to confirm <input name="confirm" required autocomplete="off"></label>
            <button type="submit">Resume sending</button>
        </form>
        {% else %}
        <form method="post" action="{{ path('dashboard_operator_stop') }}" class="control control-danger stack" data-controller="confirm" data-confirm-message-value="Stop sending all email now?">
            <h3>Stop sending email now</h3>
            <p class="small">Nothing new is submitted and the Postfix queue is held until an administrator resumes. Nothing is lost.</p>
            {{ ui.csrf() }}
            <label>Reason (kept in the audit log) <input name="note" required minlength="3" maxlength="1000"></label>
            <button type="submit" class="danger">STOP SENDING EMAIL NOW</button>
        </form>
        {% endif %}
        {% if d.live_delivery %}
        <form method="post" action="{{ path('dashboard_operator_live') }}" class="control stack">
            <h3>Live delivery</h3>
            <p class="small">Return to HELD: send jobs are accepted and wait; nothing goes to the Internet except dashboard sign-in mail.</p>
            {{ ui.csrf() }}<input type="hidden" name="to" value="disable">
            <label>Reason <input name="note" required minlength="3" maxlength="1000"></label>
            <button type="submit" class="secondary">Return to HELD mode</button>
        </form>
        {% else %}
        <form method="post" action="{{ path('dashboard_operator_live') }}" class="control control-go stack">
            <h3>Live delivery</h3>
            <p class="small">Enabling live delivery asks the host agent to run the <strong>activation preflight</strong> (every check live delivery depends on: TLS, DNS, PTR, SPF, DKIM, DMARC, outbound port 25, the ingress, relay protection). If anything fails, nothing changes and the request shows why. Do it only after the setup wizard's seed and bounce tests.</p>
            {{ ui.csrf() }}<input type="hidden" name="to" value="enable">
            <label>Reason (e.g. "seed and bounce tests passed on 2026-10-07") <input name="note" required minlength="3" maxlength="1000"></label>
            <label>Type <code>ENABLE LIVE DELIVERY</code> to confirm <input name="confirm" required autocomplete="off"></label>
            <button type="submit">Request live delivery</button>
        </form>
        {% endif %}
    </div>
    {% endif %}
</section>
