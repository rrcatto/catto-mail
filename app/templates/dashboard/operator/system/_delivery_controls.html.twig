{# Delivery mode and its controls (specification 2.11). Variables: delivery (DeliveryControl::status); optional span
   (its page-grid columns, default the full width). What each mode means sits behind ⓘ; each action opens its own form. #}
{% import 'dashboard/_macros.html.twig' as ui %}
{% set d = delivery %}
<section class="card mode-card {{ span ?? 'g-col-4' }}" aria-labelledby="delivery-h">
    <div class="card-head"><h2 id="delivery-h">Delivery mode</h2>{{ ui.tip('HELD: send jobs are accepted and wait; nothing goes to the Internet except dashboard sign-in mail. LIVE: mail goes to recipients\' servers within the rate limits. PAUSED: the emergency stop holds everything; nothing is lost. STOPPED: the delivery daemon is not running.', 'What the four modes mean') }}{{ ui.help('emergency-pause', 'Help: the delivery modes') }}</div>
    <ol class="modetrack" aria-label="The four delivery modes">
        {% for m in ['HELD', 'LIVE', 'PAUSED', 'STOPPED'] %}<li{% if m == d.mode %} class="is-current" aria-current="step"{% endif %}><span class="dot mode-{{ m }}" aria-hidden="true"></span>{{ m }}</li>{% endfor %}
    </ol>
    <p>{{ d.explanation }}</p>
    <dl class="facts">
        <div><dt>Emergency stop</dt><dd>{% if d.emergency_stop %}<strong class="text-bad">In force</strong> since {{ d.stop_changed_at|when }}{% if d.stop_note %} {{ ui.tip(d.stop_note) }}{% endif %}{% else %}not in force{% endif %}</dd></div>
        <div><dt>Delivery daemon</dt><dd>{{ d.heartbeat_age is null ? 'never reported' : 'seen ' ~ (d.heartbeat_age|duration) ~ ' ago' }}</dd></div>
        <div><dt>Rate ceiling</dt><dd>{{ d.global_rate_per_minute ? d.global_rate_per_minute ~ ' per minute' : 'none' }}</dd></div>
        <div><dt>Postfix queue</dt><dd>{% if d.queue %}{{ (d.queue.active + d.queue.deferred + d.queue.hold + d.queue.incoming)|number_format }} messages{% else %}no snapshot yet{% endif %}</dd></div>
    </dl>
    {% if is_granted('SYSTEM.DELIVERY.CONTROL') %}
    <div class="actionrow">
        {% if d.emergency_stop %}
        <details class="actionform"><summary class="btn">Resume sending</summary>
            <form method="post" action="{{ path('dashboard_operator_resume') }}" class="stack">
                {{ ui.csrf() }}
                <label>Why it is safe to resume (kept in the audit log) <input name="note" required minlength="3" maxlength="1000"></label>
                <label>Type <code>RESUME SENDING</code> to confirm <input name="confirm" required autocomplete="off"></label>
                <button type="submit">Resume sending</button>
            </form>
        </details>
        {% else %}
        <details class="actionform"><summary class="btn btn-stop">Stop sending email now</summary>
            <form method="post" action="{{ path('dashboard_operator_stop') }}" class="stack" data-controller="confirm" data-confirm-message-value="Stop sending all email now?">
                <p class="small">Nothing new is submitted and the Postfix queue is held until an administrator resumes. Nothing is lost.</p>
                {{ ui.csrf() }}
                <label>Why? (kept in the audit log) <input name="note" required minlength="3" maxlength="1000"></label>
                <button type="submit" class="danger">STOP SENDING EMAIL NOW</button>
            </form>
        </details>
        {% endif %}
        {% if d.live_delivery %}
        <details class="actionform"><summary class="btn btn-secondary">Return to HELD</summary>
            <form method="post" action="{{ path('dashboard_operator_live') }}" class="stack">
                {{ ui.csrf() }}<input type="hidden" name="to" value="disable">
                <label>Why? (kept in the audit log) <input name="note" required minlength="3" maxlength="1000"></label>
                <button type="submit">Return to HELD mode</button>
            </form>
        </details>
        {% else %}
        <details class="actionform"><summary class="btn btn-secondary">Request live delivery</summary>
            <form method="post" action="{{ path('dashboard_operator_live') }}" class="stack">
                <p class="small">The host agent first runs the activation preflight (TLS, DNS, PTR, SPF, DKIM, DMARC, outbound port 25, the ingress, relay protection). If anything fails, nothing changes and the request shows why. Do it after the seed and bounce tests.</p>
                {{ ui.csrf() }}<input type="hidden" name="to" value="enable">
                <label>Why? (e.g. "seed and bounce tests passed") <input name="note" required minlength="3" maxlength="1000"></label>
                <label>Type <code>ENABLE LIVE DELIVERY</code> to confirm <input name="confirm" required autocomplete="off"></label>
                <button type="submit">Request live delivery</button>
            </form>
        </details>
        {% endif %}
    </div>
    {% endif %}
</section>
