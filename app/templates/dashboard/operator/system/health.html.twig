{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Delivery{% endblock %}
{% block body %}
{% set d = delivery %}
{% set mode_words = {HELD: 'nothing goes to the Internet yet', LIVE: 'mail goes out to the Internet', PAUSED: 'the emergency stop is in force', STOPPED: 'the delivery daemon is not running'} %}
<div class="pagehead">
    <div>
        <h1>Delivery</h1>
        <p class="lead">Delivery is <strong class="mode-word mode-word-{{ d.mode }}">{{ d.mode }}</strong>: {{ mode_words[d.mode] ?? d.explanation }}.{% if daemon %} Delivery daemon {{ daemon.version }}, {{ daemon.alive ? 'running' : 'not running' }}.{% endif %}</p>
    </div>
</div>
{% if not setup_complete and is_granted('SYSTEM.SETUP.MANAGE') %}<p class="warn">The setup is not complete. <a href="{{ path('dashboard_operator_setup') }}">Continue the System setup</a>.</p>{% endif %}

{% include 'dashboard/operator/system/_delivery_controls.html.twig' %}

{% set v = o.validation %}{% set s = o.sending %}{% set w = o.webhooks %}{% set q = d.queue %}
<section class="card" aria-labelledby="wq-h">
    <div class="card-head"><h2 id="wq-h">Workers and queues</h2>{{ ui.tip('From the database as this page loads: work queues, worker leases and the newest results the workers wrote. A worker that is down shows up as stalled work, not as an error.') }}</div>
    <div class="panels">
        <div class="panel">
            <p class="panel-head"><span>Validation</span><span class="live live-{{ v.active_workers > 0 ? 'on' : (v.pending > 0 ? 'bad' : 'off') }}">{{ v.active_workers }} worker{{ v.active_workers == 1 ? '' : 's' }}</span></p>
            <p class="panel-value">{{ v.pending|number_format }} <span>addresses waiting</span></p>
            <p class="small muted">{{ v.active_jobs|number_format }} job{{ v.active_jobs == 1 ? '' : 's' }} in progress · last completed {{ v.last_completed|ago }}</p>
        </div>
        <div class="panel">
            <p class="panel-head"><span>Send jobs</span><span class="live live-{{ s.active_workers > 0 ? 'on' : (s.queued_jobs + s.processing_jobs > 0 ? 'bad' : 'off') }}">{{ s.active_workers }} worker{{ s.active_workers == 1 ? '' : 's' }}</span></p>
            <p class="panel-value">{{ s.queued_jobs|number_format }} <span>queued</span></p>
            <p class="small muted">{{ s.processing_jobs|number_format }} processing · {{ s.dispatched_jobs|number_format }} awaiting outcomes</p>
        </div>
        <div class="panel" id="queue-h">
            <p class="panel-head"><span>Postfix queue</span><span class="live live-{{ q and d.queue_snapshot_age is not null and d.queue_snapshot_age <= 300 ? 'on' : 'bad' }}">{{ d.queue_snapshot_age is null ? 'no snapshot' : 'snapshot ' ~ (d.queue_snapshot_age|duration) ~ ' old' }}</span></p>
            {% if q %}
            <p class="panel-value">{{ (q.active + q.deferred + q.hold + q.incoming)|number_format }} <span>messages</span></p>
            <p class="small muted">{{ q.active|number_format }} active · {{ q.deferred|number_format }} deferred · {{ q.hold|number_format }} held · {{ q.incoming|number_format }} incoming</p>
            {% else %}<p class="panel-value">— <span>no snapshot yet</span></p>{% endif %}
        </div>
        <div class="panel">
            <p class="panel-head"><span>Webhooks</span><span class="live live-{{ w.workers > 0 ? 'on' : (w.events_awaiting_fanout > 0 ? 'bad' : 'off') }}">{{ w.workers }} worker{{ w.workers == 1 ? '' : 's' }}</span></p>
            <p class="panel-value">{{ ((w.deliveries.pending ?? 0) + (w.deliveries.retrying ?? 0))|number_format }} <span>pending or retrying</span></p>
            <p class="small muted">24 h: {{ (w.deliveries.delivered ?? 0)|number_format }} delivered · {% if (w.deliveries.failed ?? 0) > 0 %}<strong class="text-bad">{{ w.deliveries.failed|number_format }} failed</strong>{% else %}0 failed{% endif %}</p>
        </div>
    </div>
    <p class="inflight"><strong>Messages in flight</strong>
        {% for key in ['created', 'queued', 'submitted', 'deferred', 'outcome_unknown'] %}<span class="chip-sm">{{ key|label('message_status') }} <strong>{{ (o.statuses[key] ?? 0)|number_format }}</strong></span>{% endfor %}</p>
</section>

{% include 'dashboard/operator/_submission_rate.html.twig' with {period_route: 'dashboard_operator_system', span: 'g-col-4'} %}

<section class="card card-flush" aria-labelledby="req-h">
    <div class="card-head"><h2 id="req-h">Host requests</h2>{{ ui.tip('The web application never runs commands on the server: actions are recorded here and carried out by the host agent' ~ (agent_age is null ? ', which has never reported.' : ', which last reported ' ~ (agent_age|duration) ~ ' ago.') ~ ' ' ~ pending_requests ~ ' waiting.') }}<a class="more" href="{{ path('dashboard_operator_system_requests') }}">Every request</a></div>
    {% if requests is empty %}<p class="empty">No request yet.</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">When</th><th scope="col">What</th><th scope="col">Result</th><th scope="col">By</th><th scope="col"><span class="sr">Details</span></th></tr></thead>
        <tbody>{% for r in requests|slice(0, 5) %}<tr>
            <td class="nowrap" title="{{ r.requested_at|ts }}">{{ r.requested_at|when }}</td><td>{% set what = ('system.request.' ~ r.action)|audit_label|replace({'Host asked to ': ''}) %}{{ what|first|upper ~ what|slice(1) }}</td>
            <td>{{ ui.result(r.status == 'succeeded' ? 'pass' : (r.status == 'failed' ? 'fail' : (r.status == 'cancelled' ? 'skipped' : 'waiting'))) }}</td>
            <td>{{ r.requested_by ?? 'the system' }}</td><td class="tipcell">{% if r.note or r.result_summary %}{{ ui.tip((r.note ? r.note ~ ' · ' : '') ~ (r.result_summary ?? '')) }}{% endif %}</td>
        </tr>{% endfor %}</tbody>
    </table></div>
    {% endif %}
</section>
{% endblock %}
