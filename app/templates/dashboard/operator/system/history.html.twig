{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Test-result history{% endblock %}
{% block crumb_tail %}History{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>Diagnostics history</h1>
        <p class="lead">Earlier results of the checks.{{ ui.tip('Kept: every run an administrator asked for, every change of result, and one scheduled result per check and day. Results never contain secrets.') }}</p>
    </div>
</div>
<nav class="chips" aria-label="Views of the history">
    {% for key, label in {fail: 'Failures', warn: 'Warnings', '': 'Every result'} %}<a class="chip-link" href="{{ path('dashboard_operator_diagnostics_history', key ? {result: key} : {}) }}"{% if filters.result == key and not filters.check and not filters.component %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
</nav>
<details class="morefilters"{% if filters.check or filters.component %} open{% endif %}>
    <summary>More filters: check, component</summary>
    <form method="get" class="filters" aria-label="Filter the runs">
        <label>Check <input name="check" value="{{ filters.check }}" size="30"></label>
        <label>Component <select name="component"><option value="">Any</option>{% for c in components %}<option{% if filters.component == c %} selected{% endif %}>{{ c }}</option>{% endfor %}</select></label>
        <label>Result <select name="result"><option value="">Any</option>{% for r in ['pass', 'warn', 'fail', 'skipped', 'info'] %}<option{% if filters.result == r %} selected{% endif %}>{{ r }}</option>{% endfor %}</select></label>
        <button type="submit">Show</button>
    </form>
</details>
<section class="card card-flush" aria-labelledby="runs-h">
    <div class="card-head"><h2 id="runs-h">{{ filters.check ? 'Runs of ' ~ filters.check : 'Runs' }}</h2></div>
    {% if runs is empty %}<p class="empty">Nothing matches.</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">When</th><th scope="col">Check</th><th scope="col">Result</th><th scope="col">Finding</th><th scope="col"><span class="sr">Details</span></th></tr></thead>
        <tbody>{% for r in runs %}<tr><td class="nowrap" title="{{ r.ran_at|ts }}">{{ r.ran_at|when }}</td><td><a href="{{ path('dashboard_operator_diagnostics_history', {check: r.check_key}) }}">{{ r.title }}</a></td><td>{{ ui.result(r.result) }}</td>
            <td>{{ r.summary }}</td><td class="tipcell">{{ ui.tip(r.check_key ~ ' · kept because: ' ~ r.run_trigger ~ ' · ' ~ (r.duration_ms is null ? 'no duration' : r.duration_ms ~ ' ms')) }}</td></tr>
        {% endfor %}</tbody>
    </table></div>
    <p class="card-note card-foot">The latest {{ runs|length }}; narrow the view to see older results.</p>
    {% endif %}
</section>
<details class="morefilters">
    <summary>Last run of each check ({{ last_runs|length }})</summary>
    <div class="card card-flush"><div class="scroll"><table class="list">
        <thead><tr><th scope="col">Check</th><th scope="col">Last run</th><th scope="col">Result</th><th scope="col">Finding</th></tr></thead>
        <tbody>{% for r in last_runs %}<tr>
            <td><a href="{{ path('dashboard_operator_diagnostics_history', {check: r.check_key}) }}">{{ r.component|capitalize }} / {{ r.title }}</a></td>
            <td class="nowrap" title="{{ r.ran_at|ts }}">{{ r.ran_at|when }}</td><td>{{ ui.result(r.result) }}</td><td>{{ r.summary }}</td>
        </tr>{% endfor %}</tbody>
    </table></div></div>
</details>
{% endblock %}
