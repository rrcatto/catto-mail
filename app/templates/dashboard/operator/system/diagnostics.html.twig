{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Diagnostics{% endblock %}
{% block body %}
{% set counts = {pass: 0, warn: 0, fail: 0} %}
{% for comp, s in by_component %}{% if s.result in ['pass', 'warn', 'fail'] %}{% set counts = counts|merge({(s.result): counts[s.result] + 1}) %}{% endif %}{% endfor %}
{% set problems = [] %}{% for comp, checks in grouped %}{% for c in checks %}{% if c.result in ['fail', 'warn'] %}{% set problems = problems|merge([c]) %}{% endif %}{% endfor %}{% endfor %}
{% set problems = problems|sort((a, b) => (a.result == 'fail' ? 0 : 1) <=> (b.result == 'fail' ? 0 : 1)) %}
<div class="pagehead">
    <div>
        <h1>Diagnostics</h1>
        <p class="lead">{% if by_component is empty %}No check has run yet.{% else %}<strong>{{ counts.pass }} of {{ by_component|length }}</strong> components pass{% if counts.warn %} · <span class="text-warn">{{ counts.warn }} warn</span>{% endif %}{% if counts.fail %} · <strong class="text-bad">{{ counts.fail }} fail</strong>{% endif %}.{% endif %}
            {{ ui.tip('PASS works; WARN works but needs attention; FAIL does not work or is unsafe; SKIPPED did not run (a prerequisite is missing or it does not apply); INFO is a fact. The application checks run at once; the host agent runs its checks within a minute' ~ (agent_age is null ? ' (it has never reported)' : '') ~ (last_run ? '. Last host run: ' ~ last_run.status ~ ' ' ~ (last_run.finished_at|ts) : '') ~ '.', 'What the results mean') }}</p>
    </div>
    <div class="actions">
        {{ ui.help('troubleshooting', 'Help: troubleshooting') }}
        {% if is_granted('SYSTEM.DIAGNOSTICS.RUN') %}
        <form method="post" action="{{ path('dashboard_operator_diagnostics_run') }}">{{ ui.csrf() }}<button type="submit">Run every check now</button></form>
        {% endif %}
    </div>
</div>

{% if problems is not empty %}
<section class="card card-flush" aria-labelledby="needs-h">
    <div class="card-head"><h2 id="needs-h">Needs you</h2></div>
    {{ ui.checks(problems) }}
</section>
{% endif %}

<section class="card card-flush" aria-labelledby="comp-h">
    <div class="card-head"><h2 id="comp-h">Every component</h2>{{ ui.tip('Open a component to see each of its checks.') }}</div>
    {% for comp, checks in grouped %}
    <details class="setup-step setup-{{ (by_component[comp].result ?? 'none') in ['pass', 'info'] ? 'done' : 'todo' }}" id="c-{{ comp }}">
        <summary>
            {{ ui.result(by_component[comp].result ?? 'none') }}
            <span class="setup-text"><span class="setup-title">{{ comp|capitalize }}</span>
                <span class="setup-line">{% set bad = checks|filter(x => x.result in ['fail', 'warn']) %}{% if bad is not empty %}{{ (bad|first).summary }}{% else %}{{ checks|length }} check{{ checks|length == 1 ? '' : 's' }}{% endif %}</span></span>
        </summary>
        <div class="setup-body setup-body-flush">{{ ui.checks(checks) }}</div>
    </details>
    {% else %}
    <p class="empty">No check has run yet.{% if is_granted('SYSTEM.DIAGNOSTICS.RUN') %} Use "Run every check now".{% endif %}</p>
    {% endfor %}
</section>
{% endblock %}
