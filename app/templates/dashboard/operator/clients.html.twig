{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}{{ view == '' ? 'Clients' : 'Clients: ' ~ view_label|lower }}{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>Clients</h1>
        <p class="lead">The organisations that send through this installation, each with its own account.{{ ui.tip('A client\'s page shows its status, plan and limits, domains, keys and members, and its history. Status changes happen there, always with a reason.') }}</p>
    </div>
    {% if is_granted('PLATFORM.CLIENT.APPROVE') %}
    <div class="actions">
        <a class="btn" href="{{ path('dashboard_operator_client_new') }}">New client</a>
        <a class="btn btn-secondary" href="{{ path('dashboard_operator_invitation_new') }}">Invite someone</a>
    </div>
    {% endif %}
</div>

<nav class="chips" aria-label="Views of the clients">
    {% for key, v in views %}<a class="chip-link" href="{{ key == '' ? path('dashboard_operator_clients') : path('dashboard_operator_clients_view', {view: key}) }}"{% if key == view and not filters.q %} aria-current="page"{% endif %}>{{ v[0] }}</a>{% endfor %}
</nav>
<form method="get" class="searchline" role="search" aria-label="Find a client">
    <label class="sr" for="client-q">Name or address contains</label>
    <input id="client-q" type="search" name="q" value="{{ filters.q }}" placeholder="Find a client by name or address">
    <button type="submit">Find</button>
</form>

<section class="card card-flush" aria-labelledby="list-h">
    <div class="card-head"><h2 id="list-h">{{ filters.q ? 'Clients matching “' ~ filters.q ~ '”' : view_label }}</h2></div>
    {% if page.rows is empty %}<p class="empty">{{ filters.q ? 'No client matches.' : 'None.' }}{% if view == '' and is_granted('PLATFORM.CLIENT.APPROVE') %} <a href="{{ path('dashboard_operator_client_new') }}">Open the first account</a>.{% endif %}</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">{{ ui.sort(listing, 'name', 'Organisation') }}</th><th scope="col">Status</th><th scope="col">Plan</th><th scope="col">Open alerts</th><th scope="col" class="num">Domains that can send</th><th scope="col">{{ ui.sort(listing, 'created', 'Opened') }}</th></tr></thead>
        <tbody>{% for c in page.rows %}
            <tr>
                <td><a href="{{ path('dashboard_operator_client', {id: c.id}) }}">{{ c.company_name }}</a>
                    {% if c.origin == 'system' %} <span class="tag internal-tag" title="The installation's own client for its built-in system tests (System › Diagnostics). It is made again whenever it is missing.">internal: self-tests</span>
                    {% elseif c.origin == 'public_application' %} <span class="tag">sign-up</span>{% elseif c.origin == 'invitation' %} <span class="tag">invitation</span>{% endif %}
                    <span class="muted small">{{ c.contact_email }}</span></td>
                <td>{{ ui.status(c.status, 'client_status') }}{% if c.status == 'pending_approval' and c.opens_on_policy_acceptance %} <span class="muted small">opens when its manager accepts the policy</span>{% endif %}</td>
                <td>{{ c.plan_name ?? c.plan }}</td>
                <td>{% if c.open_alerts > 0 %}<span class="st st-sev-{{ c.worst_alert }}"><strong>{{ c.open_alerts }}</strong>&nbsp;{{ c.worst_alert|label('alert_severity')|lower }}</span>{% else %}<span class="muted">none</span>{% endif %}</td>
                <td class="num">{{ c.verified_domains }}</td>
                <td class="nowrap" title="{{ c.created_at|ts }}">{{ c.created_at|when }}</td>
            </tr>
        {% endfor %}</tbody>
    </table></div>
    {% endif %}
</section>
{{ ui.pager(page, 'clients') }}
{% endblock %}
