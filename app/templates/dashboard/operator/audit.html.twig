{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% import 'dashboard/_icons.html.twig' as icon %}
{% block title %}Audit log{% endblock %}
{% block body %}
{% set narrowed = filters.action or filters.actor or filters.actor_type or filters.target_type or filters.target_id or filters.from or filters.to %}
<div class="pagehead">
    <div>
        <h1>Audit log</h1>
        <p class="sub">Who changed what, and when.</p>
    </div>
</div>
<nav class="chips" aria-label="Views of the audit log">
    {% for key, v in views %}<a class="chip-link" href="{{ path('dashboard_operator_audit', key ? {view: key} : {}) }}"{% if filters.view == key %} aria-current="page"{% endif %}>{{ v[0] }}</a>{% endfor %}
</nav>
<details class="morefilters"{% if narrowed %} open{% endif %}>
    <summary>More filters: who, what, when</summary>
    <form method="get" class="filters" role="search" aria-label="Filter the audit log">
        {% if filters.view %}<input type="hidden" name="view" value="{{ filters.view }}">{% endif %}
        <label>Action <select name="action"><option value="">Any</option>{% for a in actions %}<option value="{{ a }}"{% if filters.action == a %} selected{% endif %}>{{ a|audit_label }} ({{ a }})</option>{% endfor %}</select></label>
        {{ ui.select('actor_type', 'Who', {user: 'A user', api_key: 'An API key', system: 'The system'}, filters.actor_type) }}
        <label>Actor id <input type="text" name="actor" value="{{ filters.actor }}"></label>
        <label>Target type <input type="text" name="target_type" value="{{ filters.target_type }}"></label>
        <label>Target id <input type="text" name="target_id" value="{{ filters.target_id }}"></label>
        <label>From <input type="date" name="from" value="{{ filters.from }}"></label>
        <label>to <input type="date" name="to" value="{{ filters.to }}"></label>
        <input type="hidden" name="dir" value="{{ listing.dir }}">
        <button type="submit">Apply</button>
        <a href="{{ path('dashboard_operator_audit', filters.view ? {view: filters.view} : {}) }}">Clear</a>
    </form>
</details>
<section class="card card-flush" aria-labelledby="audit-h">
    <div class="card-head"><h2 id="audit-h">{{ views[filters.view][0] }}</h2></div>
    {% if page.rows is empty %}<p class="empty">Nothing recorded in this view{{ narrowed ? ' with these filters' : '' }}.</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">{{ ui.sort(listing, 'occurred', 'When') }}</th><th scope="col">What</th><th scope="col">Who</th><th scope="col"><span class="sr">Details</span></th></tr></thead>
        <tbody>{% for a in page.rows %}
            <tr><td class="nowrap"><time datetime="{{ a.occurred_at }}" title="{{ a.occurred_at|ts }}">{{ a.occurred_at|when }}</time></td>
                <td><strong>{{ a.action|audit_label }}</strong></td>
                <td>{% if a.actor_email %}{{ a.actor_email }}{% elseif a.actor_type == 'system' %}the system{% if a.actor_id %} ({{ a.actor_id }}){% endif %}{% elseif a.actor_type == 'api_key' %}an API key{% else %}{{ a.actor_type }}{% endif %}</td>
                <td class="tipcell">{% set tid = 'audit-' ~ a.id %}<span class="tip"><button type="button" class="tip-btn" aria-describedby="{{ tid }}">{{ icon.i('info', 18) }}<span class="sr">Details</span></button><span class="tip-body" role="tooltip" id="{{ tid }}">
                    <code>{{ a.action }}</code><br>{{ a.occurred_at|ts }}<br>Target: {{ a.target_type ?: '—' }}{% if a.target_id %} <span class="token">{{ a.target_id }}</span>{% endif %}
                    {% if a.detail is not empty %}<span class="tip-dl">{% for k, v in a.detail %}<span>{{ k }}: {{ v is iterable ? v|json_encode : (v is same as(true) ? 'true' : (v is same as(false) ? 'false' : (v ?? 'null'))) }}</span>{% endfor %}</span>{% endif %}
                </span></span></td></tr>
        {% endfor %}</tbody>
    </table></div>
    {% endif %}
</section>
{{ ui.pager(page, 'entries') }}
{% endblock %}
