{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Roles &amp; permissions{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>Roles &amp; permissions</h1>
        <p class="lead">What each role may do.{{ ui.tip('A user\'s permissions are those of all their roles. ADMIN always holds every permission. Changes apply at each holder\'s next request.') }}</p>
    </div>
    {% if is_granted('SYSTEM.ROLE.MANAGE') %}
    <details class="actionform" id="create-role"><summary class="btn">Create a role</summary>
        <form method="post" action="{{ path('dashboard_operator_role_create') }}" class="stack">
            {{ ui.csrf() }}
            <label>Key (e.g. SUPPORT) <input type="text" name="role_key" required pattern="[A-Za-z][A-Za-z0-9_]{1,63}" maxlength="64"></label>
            <label>Name <input type="text" name="name" required maxlength="100"></label>
            <label>Description <input type="text" name="description" maxlength="300"></label>
            <button type="submit">Create role</button>
        </form>
    </details>
    {% endif %}
</div>
<section class="card card-flush" aria-labelledby="roles-h">
    <div class="card-head"><h2 id="roles-h">Roles</h2></div>
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">Role</th><th scope="col">Name</th><th scope="col" class="num">Permissions</th><th scope="col" class="num">Users</th></tr></thead>
        <tbody>{% for r in roles %}
            <tr><td><a href="{{ path('dashboard_operator_role', {id: r.id.toRfc4122}) }}"><code>{{ r.roleKey }}</code></a>{% if not r.builtin %} <span class="tag">custom</span>{% endif %}</td><td>{{ r.name }}{% if r.description %} {{ ui.tip(r.description) }}{% endif %}</td>
                <td class="num">{{ permission_counts[r.id.toRfc4122] }} of {{ permission_total }}</td><td class="num">{{ user_counts[r.id.toRfc4122] ?? 0 }}</td></tr>
        {% endfor %}</tbody>
    </table></div>
</section>
{% endblock %}
