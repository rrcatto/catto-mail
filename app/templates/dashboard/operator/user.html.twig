{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}User {{ u.email }}{% endblock %}
{% block crumb_tail %}{{ u.email }}{% endblock %}
{% block body %}
{% set manage = is_granted('PLATFORM.USER.MANAGE') %}
<div class="pagehead">
    <div>
        <div class="titleline"><h1>{{ u.displayName ?? u.email }}</h1>{{ ui.status(u.status.value, 'none') }}</div>
        <p class="lead">{{ u.email }} · last sign-in {{ u.lastLoginAt ? u.lastLoginAt|when : 'never' }} · created {{ u.createdAt|when }}{% if is_configured_admin %}{{ ui.tip('This is the configured administrator address (APP_ADMIN_EMAIL): it receives the ADMIN role every time it signs in.') }}{% endif %}</p>
    </div>
    {% if manage %}
    <div class="actionrow">
        <details class="actionform"><summary class="btn btn-secondary">Edit name or status</summary>
            <form method="post" action="{{ path('dashboard_operator_user_profile', {id: u.id.toRfc4122}) }}" class="stack">
                {{ ui.csrf() }}
                <label>Name <input type="text" name="display_name" value="{{ u.displayName }}" maxlength="200"></label>
                <label>Status
                    <select name="status"{% if is_self %} disabled{% endif %}>
                        <option value="active"{% if u.status.value == 'active' %} selected{% endif %}>Active</option>
                        <option value="disabled"{% if u.status.value == 'disabled' %} selected{% endif %}>Disabled (cannot sign in; signed out at once)</option>
                    </select>
                </label>
                <button type="submit">Save</button>
            </form>
        </details>
        <form method="post" action="{{ path('dashboard_operator_user_login_link', {id: u.id.toRfc4122}) }}">
            {{ ui.csrf() }}<button type="submit" class="secondary"{% if u.disabled %} disabled{% endif %}>Email a sign-in link</button>
        </form>
    </div>
    {% endif %}
</div>

<div class="grid">
    <section class="card g-col-4 xl:g-col-1" aria-labelledby="roles-h">
        <div class="card-head"><h2 id="roles-h">Roles</h2>{{ ui.tip('ADMIN holds every permission. Only an administrator can grant or revoke ADMIN.') }}</div>
        {% if held is empty %}<p class="muted">No installation role.</p>{% else %}<p>{% for r in held %}<span class="tag">{{ r }}</span>{% endfor %}</p>{% endif %}
        {% if manage %}
        <details class="actionform"><summary class="btn btn-secondary">Change roles</summary>
            <div class="stack">{% for r in roles %}{% set has = r.roleKey in held %}
                {% if r.roleKey != 'ADMIN' or is_granted('SYSTEM.ROLE.MANAGE') %}
                <form method="post" action="{{ path('dashboard_operator_user_role', {id: u.id.toRfc4122}) }}" class="formrow">
                    {{ ui.csrf() }}<input type="hidden" name="role_id" value="{{ r.id.toRfc4122 }}"><input type="hidden" name="action" value="{{ has ? 'revoke' : 'grant' }}">
                    <button type="submit"{% if has %} class="secondary"{% endif %}>{{ has ? 'Revoke' : 'Grant' }} {{ r.roleKey }}</button>
                </form>{% endif %}
            {% endfor %}</div>
        </details>
        {% endif %}
    </section>
    <section class="card card-flush g-col-4 xl:g-col-3" aria-labelledby="memberships-h">
        <div class="card-head"><h2 id="memberships-h">Client memberships</h2>{{ ui.tip('Viewer: read the client\'s pages. Member: also run sending-domain checks. Admin: also lift the client\'s own global opt-outs.') }}</div>
        {% if memberships is empty %}<p class="empty">No client memberships.</p>{% else %}
        <div class="scroll"><table class="list">
            <thead><tr><th scope="col">Client</th><th scope="col">Role</th><th scope="col">Since</th>{% if manage %}<th scope="col"><span class="sr">Remove</span></th>{% endif %}</tr></thead>
            <tbody>{% for m in memberships %}
                <tr><td><a href="{{ path('dashboard_client_overview', {clientId: m.client_id}) }}">{{ m.company_name }}</a>{% if m.client_status != 'active' %} {{ ui.status(m.client_status, 'client_status') }}{% endif %}</td>
                    <td>{{ m.role|capitalize }}</td><td>{{ m.created_at|when }}</td>
                {% if manage %}<td><form method="post" action="{{ path('dashboard_operator_user_membership', {id: u.id.toRfc4122}) }}" data-controller="confirm" data-confirm-message-value="Remove {{ u.email }} from {{ m.company_name }}?">
                    {{ ui.csrf() }}<input type="hidden" name="client_id" value="{{ m.client_id }}"><input type="hidden" name="action" value="remove"><button type="submit" class="secondary">Remove</button></form></td>{% endif %}</tr>
            {% endfor %}</tbody>
        </table></div>
        {% endif %}
        {% if manage %}
        <details class="actionform card-foot"><summary class="btn btn-secondary">Add or change a membership</summary>
            <form method="post" action="{{ path('dashboard_operator_user_membership', {id: u.id.toRfc4122}) }}" class="stack">
                {{ ui.csrf() }}
                <label>Client <select name="client_id" required><option value="">Choose…</option>{% for c in clients %}<option value="{{ c.id }}">{{ c.company_name }}</option>{% endfor %}</select></label>
                <label>Role <select name="membership_role">{% for m in membership_roles %}<option value="{{ m.value }}">{{ m.value|capitalize }}</option>{% endfor %}</select></label>
                <button type="submit">Save membership</button>
            </form>
        </details>
        {% endif %}
    </section>
</div>
{% endblock %}
