{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}User {{ u.email }}{% endblock %}
{% block body %}
{% set manage = is_granted('PLATFORM.USER.MANAGE') %}
<p class="crumbs"><a href="{{ path('dashboard_operator_users') }}">Users</a> › {{ u.email }}</p>
<div class="pagehead">
    <div class="entity">
        <span class="avatar av-{{ u.email|tone_slot }}" aria-hidden="true">{{ (u.displayName ?? (u.email|split('@')|first))|initials }}</span>
        <div>
            <div class="titleline"><h1>{{ u.displayName ?? u.email }}</h1>{{ ui.status(u.status.value, 'none') }}</div>
            <p class="sub">{{ u.email }} · last sign-in {{ u.lastLoginAt|ts }}</p>
        </div>
    </div>
</div>
{% if is_configured_admin %}<p class="caveat">This is the configured administrator address (<code>APP_ADMIN_EMAIL</code>): it receives the ADMIN role every time it signs in.</p>{% endif %}

<div class="row-2">
    <section class="card" aria-labelledby="account-h">
        <h2 id="account-h">Account</h2>
        <dl class="rows">
            <dt>Email</dt><dd>{{ u.email }}</dd>
            <dt>Status</dt><dd>{{ ui.status(u.status.value, 'none') }}</dd>
            <dt>Created</dt><dd>{{ u.createdAt|ts }}</dd>
            <dt>Last sign-in</dt><dd>{{ u.lastLoginAt|ts }}</dd>
        </dl>
        {% if manage %}
        <form method="post" action="{{ path('dashboard_operator_user_profile', {id: u.id.toRfc4122}) }}" class="stack">
            {{ ui.csrf() }}
            <label>Name <input type="text" name="display_name" value="{{ u.displayName }}" maxlength="200"></label>
            <label>Status
                <select name="status"{% if is_self %} disabled{% endif %}>
                    <option value="active"{% if u.status.value == 'active' %} selected{% endif %}>Active</option>
                    <option value="disabled"{% if u.status.value == 'disabled' %} selected{% endif %}>Disabled (cannot sign in; signed out at once)</option>
                </select>
            </label>
            <button type="submit">Save</button>
        </form>
        <form method="post" action="{{ path('dashboard_operator_user_login_link', {id: u.id.toRfc4122}) }}" class="form-actions">
            {{ ui.csrf() }}<button type="submit" class="secondary"{% if u.disabled %} disabled{% endif %}>Email a sign-in link</button>
        </form>
        {% endif %}
    </section>
    <section class="card" aria-labelledby="roles-h">
        <h2 id="roles-h">Roles</h2>
        <table class="kv"><tbody>
        {% for r in roles %}
            {% set has = r.roleKey in held %}
            <tr>
                <th scope="row"><code>{{ r.roleKey }}</code><br><small>{{ r.name }}</small></th>
                <td>{% if has %}<span class="st st-active">Held</span>{% else %}—{% endif %}</td>
                <td class="num">{% if manage and (r.roleKey != 'ADMIN' or is_granted('SYSTEM.ROLE.MANAGE')) %}
                    <form method="post" action="{{ path('dashboard_operator_user_role', {id: u.id.toRfc4122}) }}">
                        {{ ui.csrf() }}<input type="hidden" name="role_id" value="{{ r.id.toRfc4122 }}"><input type="hidden" name="action" value="{{ has ? 'revoke' : 'grant' }}">
                        <button type="submit"{% if has %} class="secondary"{% endif %}>{{ has ? 'Revoke' : 'Grant' }}</button>
                    </form>
                {% endif %}</td>
            </tr>
        {% endfor %}
        </tbody></table>
        <p class="muted small">ADMIN holds every permission. Only an administrator can grant or revoke ADMIN.</p>
    </section>
</div>

<section class="card card-flush" aria-labelledby="memberships-h">
    <div class="card-head"><h2 id="memberships-h">Client memberships</h2><span class="count count-dark">{{ memberships|length }}</span></div>
    {% if memberships is empty %}<p class="empty">No client memberships.</p>{% else %}
    <div class="scroll"><table>
        <thead><tr><th scope="col">Client</th><th scope="col">Client status</th><th scope="col">Role</th><th scope="col">Since</th>{% if manage %}<th scope="col">Remove</th>{% endif %}</tr></thead>
        <tbody>{% for m in memberships %}
            <tr><td><a class="client-name" href="{{ path('dashboard_client_overview', {clientId: m.client_id}) }}"><span class="avatar av-{{ m.company_name|tone_slot }}" aria-hidden="true">{{ m.company_name|initials }}</span>{{ m.company_name }}</a></td>
                <td>{{ ui.status(m.client_status, 'client_status') }}</td><td>{{ m.role|capitalize }}</td><td>{{ m.created_at|ts }}</td>
            {% if manage %}<td><form method="post" action="{{ path('dashboard_operator_user_membership', {id: u.id.toRfc4122}) }}" data-controller="confirm" data-confirm-message-value="Remove {{ u.email }} from {{ m.company_name }}?">
                {{ ui.csrf() }}<input type="hidden" name="client_id" value="{{ m.client_id }}"><input type="hidden" name="action" value="remove"><button type="submit" class="secondary">Remove</button></form></td>{% endif %}</tr>
        {% endfor %}</tbody>
    </table></div>
    {% endif %}
</section>
{% if manage %}
<section class="card" aria-labelledby="membership-add-h">
    <h2 id="membership-add-h">Add or change a membership</h2>
    <form method="post" action="{{ path('dashboard_operator_user_membership', {id: u.id.toRfc4122}) }}" class="form-grid">
        {{ ui.csrf() }}
        <label>Client <select name="client_id" required><option value="">Choose…</option>{% for c in clients %}<option value="{{ c.id }}">{{ c.company_name }}</option>{% endfor %}</select></label>
        <label>Role <select name="membership_role">{% for m in membership_roles %}<option value="{{ m.value }}">{{ m.value|capitalize }}</option>{% endfor %}</select></label>
        <div class="form-actions span-all"><button type="submit">Add or change membership</button></div>
    </form>
    <p class="muted small">Viewer: read the client's pages. Member: also run sending-domain checks. Admin: also lift the client's own global opt-outs.</p>
</section>
{% endif %}
{% endblock %}
