{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% import 'dashboard/_icons.html.twig' as icon %}
{% block title %}Client {{ c.company_name }}{% endblock %}
{% block crumb_tail %}{{ c.company_name }}{% endblock %}
{% block body %}
{% set usable_keys = api_keys|filter(k => k.usable)|length %}
{% set verified_domains = c.domains|filter(d => d.status == 'verified')|length %}
{% set open_alerts = reputation.alerts|filter(a => not a.resolved_at)|length %}
{% set tabs = {summary: 'Summary', limits: 'Limits & usage', reputation: 'Reputation', sending: 'Domains & webhooks', access: 'Keys & members', policy: 'Policy & opt-outs', history: 'History'} %}
{% set tab = app.request.query.get('tab') in tabs|keys ? app.request.query.get('tab') : 'summary' %}
<div class="pagehead">
    <div>
        <div class="titleline"><h1>{{ c.company_name }}</h1>{{ ui.status(c.status, 'client_status') }}</div>
        <p class="lead">{{ c.status|label('client_status') }} since {{ c.status_changed_at|when }} · {{ c.plan }} plan · {{ c.origin|label('client_origin') }}</p>
    </div>
    <div class="actions"><a class="btn btn-secondary" href="{{ path('dashboard_client_overview', {clientId: c.id}) }}">Open the client's workspace</a></div>
</div>
<nav class="chips" aria-label="Parts of this client">
    {% for key, label in tabs %}<a class="chip-link" href="{{ path('dashboard_operator_client', key == 'summary' ? {id: c.id} : {id: c.id, tab: key}) }}"{% if key == tab %} aria-current="page"{% endif %}>{{ label }}{% if key == 'reputation' and open_alerts %} <span class="count count-bad">{{ open_alerts }}</span>{% endif %}</a>{% endfor %}
</nav>

{% if tab == 'summary' %}
<div class="kpis">
    <section class="card kpi"><div class="kpi-head"><h2>Messages this month</h2></div><p class="kpi-value">{{ (usage.current_month.message_submitted.quantity|default(0))|number_format }}</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Open reputation alerts</h2></div><p class="kpi-value{{ open_alerts ? ' text-bad' : '' }}">{{ open_alerts }}</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Verified sending domains</h2></div><p class="kpi-value">{{ verified_domains }} <small class="muted">of {{ c.domains|length }}</small></p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Usable API keys</h2></div><p class="kpi-value">{{ usable_keys }}</p></section>
</div>
<div class="grid">
    <section class="card g-col-4 xl:g-col-2" aria-labelledby="life-h">
        <h2 id="life-h">Status</h2>
        <p>{{ ui.status(c.status, 'client_status') }} {{ c.status|label('client_status_meaning') }}</p>
        {% if c.status == 'pending_approval' and policy.blocks_approval %}
            <p class="warn">Approval needs an acceptance of policy version {{ policy.version_in_force }}: see <a href="{{ path('dashboard_operator_client', {id: c.id, tab: 'policy'}) }}">Policy &amp; opt-outs</a>.</p>
        {% endif %}
        {% if transitions is empty %}<p class="muted">A closed client is final: no further status change.</p>{% else %}
        <div class="actionrow">
        {% for t in transitions %}
            {% if t.allowed %}
            {% set destructive = t.to in ['closed', 'suspended'] %}
            <details class="actionform">
                <summary class="btn{{ destructive ? ' btn-stop' : (t.to == 'active' ? '' : ' btn-secondary') }}">{{ t.verb }}</summary>
                <form method="post" action="{{ path('dashboard_operator_client_status', {id: c.id}) }}" class="stack" data-controller="confirm" data-confirm-message-value="{{ t.verb }} {{ c.company_name }}?">
                    {{ ui.csrf() }}<input type="hidden" name="status" value="{{ t.to }}">
                    <label>Why? (kept in the audit log) <input type="text" name="note" required minlength="3" maxlength="1000"></label>
                    <button type="submit"{% if destructive %} class="danger"{% endif %}>{{ t.verb }} {{ c.company_name }}</button>
                </form>
            </details>
            {% else %}
            <span class="muted small">{{ t.verb }}: needs {{ t.permission }}</span>
            {% endif %}
        {% endfor %}
        </div>
        {% endif %}
    </section>

    <section class="card g-col-4 xl:g-col-2" aria-labelledby="acc-h">
        <div class="card-head"><h2 id="acc-h">Account</h2></div>
        <dl class="rows">
            <dt>Operational contact</dt><dd>{{ c.contact_email }}</dd>
            <dt>Billing contact</dt><dd>{{ c.billing_contact_email ?? 'same as operational' }}</dd>
            <dt>Abuse contact</dt><dd>{{ c.abuse_contact_email ?? '—' }}</dd>
            <dt>Created</dt><dd title="{{ c.created_at|ts }}">{{ c.created_at|when }}{% if c.approved_at %} · approved {{ c.approved_at|when }}{% endif %}{% if c.closed_at %} · closed {{ c.closed_at|when }}{% endif %}</dd>
            <dt>Client id</dt><dd><code>{{ c.id }}</code></dd>
        </dl>
        {% if is_granted('PLATFORM.CLIENT.MANAGE') %}
        <details class="actionform"><summary class="btn btn-secondary">Edit account details</summary>
            <form method="post" action="{{ path('dashboard_operator_client_account', {id: c.id}) }}" class="stack">
                {{ ui.csrf() }}
                <label>Organisation name <input type="text" name="company_name" value="{{ c.company_name }}" required maxlength="200"></label>
                <label>Operational contact <input type="email" name="contact_email" value="{{ c.contact_email }}" required></label>
                <label>Billing contact <input type="email" name="billing_contact_email" value="{{ c.billing_contact_email }}"></label>
                <label>Abuse/security contact <input type="email" name="abuse_contact_email" value="{{ c.abuse_contact_email }}"></label>
                <label>Plan <input type="text" name="plan" value="{{ c.plan }}" required maxlength="100"></label>
                <button type="submit">Save account details</button>
            </form>
        </details>
        {% endif %}
    </section>

    <section class="card g-col-4" aria-labelledby="notes-h">
        <div class="card-head"><h2 id="notes-h">Private notes</h2>{{ ui.tip('Operators only; never shown to the client.') }}</div>
        {% if notes is empty %}<p class="muted">No notes.</p>{% else %}
        <ol class="activity">{% for n in notes|slice(0, 3) %}
            <li><span><span class="act-line">{{ n.note }}</span><span class="act-meta">{{ n.author ?? 'console' }} · {{ n.created_at|when }}</span></span></li>
        {% endfor %}</ol>
        {% if notes|length > 3 %}<details><summary>{{ notes|length - 3 }} older note{{ notes|length - 3 == 1 ? '' : 's' }}</summary><ol class="activity">{% for n in notes|slice(3) %}<li><span><span class="act-line">{{ n.note }}</span><span class="act-meta">{{ n.author ?? 'console' }} · {{ n.created_at|when }}</span></span></li>{% endfor %}</ol></details>{% endif %}
        {% endif %}
        {% if is_granted('PLATFORM.CLIENT.MANAGE') %}
        <details class="actionform"><summary class="btn btn-secondary">Add a note</summary>
            <form method="post" action="{{ path('dashboard_operator_client_note', {id: c.id}) }}" class="stack">
                {{ ui.csrf() }}<label>Note <textarea name="note" required maxlength="4000" rows="2"></textarea></label><button type="submit">Add note</button>
            </form>
        </details>
        {% endif %}
    </section>
</div>
{% endif %}

{% if tab == 'limits' %}
<div class="grid">
    <section class="card card-flush g-col-4 xl:g-col-2" aria-labelledby="lim-h">
        <div class="card-head"><h2 id="lim-h">Limits</h2>{{ ui.tip('A client limit can only lower an installation ceiling. Volume quotas have no ceiling and apply only where set. Periods are calendar days and months in ' ~ time_zone_label() ~ '.') }}</div>
        <div class="scroll"><table class="list">
            <thead><tr><th scope="col">Limit</th><th scope="col" class="num">Client</th><th scope="col" class="num">Installation</th><th scope="col" class="num">In force</th></tr></thead>
            <tbody>{% for l in limits.limits %}<tr><td>{{ l.column|label('limit') }}</td><td class="num">{{ l.own ?? '—' }}</td><td class="num">{{ l.ceiling ?? 'none' }}</td><td class="num"><strong>{{ l.effective ?? 'unlimited' }}</strong></td></tr>{% endfor %}</tbody>
        </table></div>
        {% if is_granted('PLATFORM.CLIENT_LIMIT.MANAGE') %}
        <details class="card-foot actionform"><summary class="btn btn-secondary">Change limits</summary>
            <form method="post" action="{{ path('dashboard_operator_client_limits', {id: c.id}) }}" class="form-grid">
                {{ ui.csrf() }}
                {% for l in limits.limits %}
                    <label>{{ l.column|label('limit') }}{% if l.ceiling is not null %} (at most {{ l.ceiling }}){% endif %} <input type="number" min="0" name="{{ l.column }}" value="{{ l.own }}"></label>
                {% endfor %}
                <label class="span-all">Why? (kept in the audit log) <input type="text" name="note" required minlength="3"></label>
                <div class="form-actions span-all"><button type="submit">Save limits</button></div>
            </form>
        </details>
        {% endif %}
    </section>
    <section class="card card-flush g-col-4 xl:g-col-2" aria-labelledby="quo-h">
        <div class="card-head"><h2 id="quo-h">Quotas and usage</h2>{% if is_granted('PLATFORM.USAGE.VIEW') %}<a class="more" href="{{ path('dashboard_operator_usage') }}">Usage &amp; billing</a>{% endif %}</div>
        <div class="scroll"><table class="list">
            <thead><tr><th scope="col">Admitted work</th><th scope="col">Period</th><th scope="col" class="num">Used</th><th scope="col" class="num">Quota</th></tr></thead>
            <tbody>{% for q in limits.quotas %}<tr><td>{{ q.metric|label('quota_metric') }}</td><td>{{ q.period|label('quota_period') }}</td><td class="num">{{ q.used|number_format }}</td><td class="num">{{ q.limit is null ? '—' : q.limit|number_format }}</td></tr>{% endfor %}</tbody>
        </table></div>
        <div class="scroll"><table class="list">
            <thead><tr><th scope="col">Usage</th><th scope="col" class="num">Validation addresses</th><th scope="col" class="num">Messages</th></tr></thead>
            <tbody>{% for name, t in usage %}<tr><td>{{ name|replace({'_': ' '})|capitalize }}</td><td class="num">{{ t.validation_address.quantity|number_format }}</td><td class="num">{{ t.message_submitted.quantity|number_format }}</td></tr>{% endfor %}</tbody>
        </table></div>
    </section>
    {% if statements is not empty %}
    <section class="card card-flush g-col-4" aria-labelledby="st-h">
        <div class="card-head"><h2 id="st-h">Billing statements</h2></div>
        <div class="scroll"><table class="list"><thead><tr><th scope="col">Billing period</th><th scope="col">Statement</th><th scope="col">Reconciliation</th><th scope="col">Totals</th><th scope="col">External reference</th></tr></thead>
        <tbody>{% for s in statements %}<tr><td>{{ s.period_start }} – {{ s.period_end }}</td><td>{{ s.status|label('statement_status') }}</td><td>{{ s.reconciliation_status|label('reconciliation_status') }}</td><td>{% for k, v in s.totals %}{{ k|label('usage_type') }}: {{ v|number_format }}{% if not loop.last %}; {% endif %}{% endfor %}</td><td>{{ s.external_reference ?? '—' }}</td></tr>{% endfor %}</tbody></table></div>
    </section>
    {% endif %}
</div>
{% endif %}

{% if tab == 'reputation' %}
<section class="card card-flush" aria-labelledby="rep-h">
    <div class="card-head"><h2 id="rep-h">Last evaluation</h2>{{ ui.tip('Transport facts counted by event time in the window; rates are of the messages submitted in the window. Alerts are inferred risk and never act on the client by themselves.') }}
        {% if is_granted('PLATFORM.ABUSE.VIEW') %}<a class="more" href="{{ path('dashboard_operator_alerts', {client: c.id, state: 'all'}) }}">Every alert of this client</a>{% endif %}</div>
    {% if reputation.metrics is empty %}<p class="empty">Not evaluated yet.</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">Window</th><th scope="col" class="num">Submitted</th><th scope="col" class="num">Hard bounces</th><th scope="col" class="num">Complaints</th><th scope="col" class="num">Deferred</th><th scope="col" class="num">Suppressed</th><th scope="col"><span class="sr">More</span></th></tr></thead>
        <tbody>{% for m in reputation.metrics %}<tr>
            <td>{{ m.window_hours == 24 ? '24 hours' : '7 days' }}</td><td class="num">{{ m.messages_submitted|number_format }}</td>
            <td class="num">{{ m.hard_bounces }}{% if m.hard_bounce_rate is not null %} ({{ m.hard_bounce_rate }} %){% endif %}</td>
            <td class="num">{{ m.complaints }}{% if m.complaint_rate is not null %} ({{ m.complaint_rate }} %){% endif %}</td>
            <td class="num">{{ m.deferrals }}{% if m.deferral_rate is not null %} ({{ m.deferral_rate }} %){% endif %}</td>
            <td class="num">{{ m.suppressed }}{% if m.suppression_rate is not null %} ({{ m.suppression_rate }} %){% endif %}</td>
            <td class="tipcell">{{ ui.tip('Validation addresses ' ~ m.validation_addresses ~ ' · soft bounces ' ~ m.soft_bounces ~ ' · provider policy ' ~ m.provider_policy_failures ~ ' · outcome unknown ' ~ m.outcome_unknown ~ ' · webhook failures ' ~ m.webhook_failures ~ ' · computed ' ~ (m.computed_at|ts)) }}</td></tr>{% endfor %}</tbody>
    </table></div>
    {% endif %}
</section>
<section class="card card-flush" aria-labelledby="al-h">
    <div class="card-head"><h2 id="al-h">Alerts</h2></div>
    {% if reputation.alerts is empty %}<p class="empty">No alerts.</p>{% else %}
    <div class="scroll"><table class="list"><thead><tr><th scope="col">Alert</th><th scope="col">Severity</th><th scope="col" class="num">Value / threshold</th><th scope="col">Last observed</th><th scope="col">State</th></tr></thead>
    <tbody>{% for a in reputation.alerts %}<tr><td>{{ a.metric|label('alert_metric') }} <span class="muted">({{ a.window_hours == 24 ? '24 h' : '7 d' }})</span></td><td><span class="st st-sev-{{ a.severity }}">{{ a.severity|label('alert_severity') }}</span></td><td class="num">{{ a.value }} / {{ a.threshold }}</td><td title="first {{ a.first_observed_at|ts }}">{{ a.last_observed_at|when }}</td><td>{{ a.resolved_at ? 'Resolved ' ~ a.resolved_at|when : (a.acknowledged_at ? 'Acknowledged: ' ~ a.acknowledgement_note : 'Open') }}</td></tr>{% endfor %}</tbody></table></div>
    {% endif %}
</section>
{% endif %}

{% if tab == 'sending' %}
<section class="card card-flush" aria-labelledby="dom-h">
    <div class="card-head"><h2 id="dom-h">Sending domains</h2></div>
    {% if c.domains is empty %}<p class="empty">None.</p>{% else %}
    <div class="scroll"><table class="list"><thead><tr><th scope="col">Domain</th><th scope="col">Status</th><th scope="col">DKIM</th><th scope="col">Last check</th></tr></thead>
    <tbody>{% for d in c.domains %}<tr><td>{{ d.domain }}</td><td>{{ ui.status(d.status, 'domain_status') }}</td><td><span class="st st-dkim-{{ d.dkim_status }}">{{ d.dkim_status|label('dkim_status') }}</span>{% if d.dkim_selector %} <small>({{ d.dkim_selector }})</small>{% endif %}</td><td>{{ d.last_checked_at|when }}{% if d.last_check_error %} {{ ui.tip(d.last_check_error) }}{% endif %}</td></tr>{% endfor %}</tbody></table></div>
    {% endif %}
</section>
<section class="card card-flush" aria-labelledby="hook-h">
    <div class="card-head"><h2 id="hook-h">Webhook endpoints</h2>{{ ui.tip('Endpoints are never disabled automatically. A client admin (or an operator in the client workspace) enables, disables, edits, rotates and tests them.') }}</div>
    {% if endpoints is empty %}<p class="empty">None.</p>{% else %}
    <div class="scroll"><table class="list"><thead><tr><th scope="col">URL</th><th scope="col">Status</th><th scope="col" class="num">Delivered (7 d)</th><th scope="col" class="num">Failed (7 d)</th><th scope="col" class="num">Failing since last success</th><th scope="col"><span class="sr">More</span></th></tr></thead>
    <tbody>{% for w in endpoints %}<tr><td class="url">{{ w.url }}</td><td>{{ w.status|capitalize }}</td>
        <td class="num">{{ w.delivered_7d }}</td><td class="num">{{ w.failed_7d }}</td><td class="num">{% if w.failures_since_success > 0 %}<strong class="text-bad">{{ w.failures_since_success }}</strong>{% else %}0{% endif %}</td>
        <td class="tipcell">{{ ui.tip('Events: ' ~ (w.subscribed_event_types|json_counts|join(', ')) ~ ' · pending ' ~ w.pending ~ ' · last success ' ~ (w.last_delivered_at|ts) ~ ' · last failure ' ~ (w.last_failed_at|ts) ~ (w.rotation_overlap ? ' · secret rotation overlap' : '')) }}</td></tr>{% endfor %}</tbody></table></div>
    {% endif %}
</section>
{% endif %}

{% if tab == 'access' %}
<section class="card card-flush" aria-labelledby="keys-h">
    <div class="card-head"><h2 id="keys-h">API keys</h2>{{ ui.tip('Keys are stored as hashes and can never be shown again. Revoked and expired keys fail authentication.') }}</div>
    {% set shown = api_keys|filter(k => k.usable) %}
    {% set old = api_keys|filter(k => not k.usable) %}
    {% if shown is empty %}<p class="empty">No usable key.</p>{% else %}
    <div class="scroll"><table class="list"><thead><tr><th scope="col">Key</th><th scope="col">Name</th><th scope="col">Last used</th><th scope="col">Expires</th><th scope="col"><span class="sr">Actions</span></th></tr></thead>
    <tbody>{% for k in shown %}<tr><td><code>{{ k.key_prefix }}…</code></td><td>{{ k.name ?? '—' }}</td><td>{{ k.last_used_at|when }}</td><td>{{ k.expires_at ? k.expires_at|when : 'never' }}</td>
        <td>{% if is_granted('PLATFORM.CLIENT_KEY.MANAGE') %}<form method="post" action="{{ path('dashboard_operator_client_key_revoke', {id: c.id, keyId: k.id}) }}" class="inline" data-controller="confirm" data-confirm-message-value="Revoke {{ k.key_prefix }}…? Requests with it fail at once.">{{ ui.csrf() }}<button type="submit" class="secondary">Revoke</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div>
    {% endif %}
    {% if old is not empty %}<details class="card-foot"><summary>{{ old|length }} revoked or expired key{{ old|length == 1 ? '' : 's' }}</summary>
        <div class="scroll"><table class="list"><tbody>{% for k in old %}<tr><td><code>{{ k.key_prefix }}…</code></td><td>{{ k.name ?? '—' }}</td><td>{{ k.revoked_at ? 'revoked ' ~ k.revoked_at|when : 'expired' }}</td></tr>{% endfor %}</tbody></table></div></details>{% endif %}
    {% if is_granted('PLATFORM.CLIENT_KEY.MANAGE') and c.status != 'closed' %}
    <details class="card-foot actionform"><summary class="btn btn-secondary">Create an API key</summary>
        <form method="post" action="{{ path('dashboard_operator_client_key_create', {id: c.id}) }}" class="stack">
            {{ ui.csrf() }}
            <label>Descriptive name <input type="text" name="name" maxlength="100" placeholder="e.g. production server"></label>
            <label>Expires after (optional; the key stops working at the end of that day, {{ time_zone_abbreviation() }}) <input type="date" name="expires_on"></label>
            <button type="submit">Create key (shown once)</button>
        </form>
    </details>
    {% endif %}
</section>
<section class="card card-flush" aria-labelledby="mem-h">
    <div class="card-head"><h2 id="mem-h">Members</h2><a class="more" href="{{ path('dashboard_operator_users') }}">Manage on Users</a></div>
    {% if c.members is empty %}<p class="empty">None.</p>{% else %}
    <div class="scroll"><table class="list"><thead><tr><th scope="col">User</th><th scope="col">Role</th><th scope="col">Account</th><th scope="col">Last sign-in</th></tr></thead>
    <tbody>{% for m in c.members %}<tr><td>{{ m.display_name ? m.display_name ~ ' – ' : '' }}{{ m.email }}</td><td>{{ m.role|capitalize }}</td><td>{{ m.status|capitalize }}</td><td>{{ m.last_login_at|when }}</td></tr>{% endfor %}</tbody></table></div>
    {% endif %}
</section>
{% endif %}

{% if tab == 'policy' %}
<div class="grid">
    <section class="card g-col-4 xl:g-col-2" aria-labelledby="pol-h">
        <h2 id="pol-h">Service policy</h2>
        <dl class="rows">
            <dt>Version in force</dt><dd>{{ policy.version_in_force ?? 'none configured' }}</dd>
            <dt>Acceptance before approval</dt><dd>{{ policy.required ? 'Required' : 'Exempt (internal client)' }}</dd>
            <dt>Accepted (version in force)</dt><dd>{{ policy.accepted ? 'Yes, ' ~ policy.accepted_at|when : 'No' }}</dd>
        </dl>
        {% if policy.acceptances is not empty %}
        <details><summary>Every acceptance ({{ policy.acceptances|length }})</summary><div class="scroll"><table class="list"><thead><tr><th scope="col">Version</th><th scope="col">Accepted</th><th scope="col">How</th><th scope="col">By / reference</th></tr></thead>
        <tbody>{% for a in policy.acceptances %}<tr><td>{{ a.policy_version }}</td><td>{{ a.accepted_at|when }}</td><td>{{ a.source|label('policy_source') }}</td><td>{{ a.accepted_by ?? a.reference ?? '—' }}</td></tr>{% endfor %}</tbody></table></div></details>
        {% endif %}
        {% if is_granted('PLATFORM.CLIENT.MANAGE') %}
        <div class="actionrow">
        <details class="actionform"><summary class="btn btn-secondary">Record an acceptance made elsewhere</summary>
            <form method="post" action="{{ path('dashboard_operator_client_policy', {id: c.id}) }}" class="stack">
                {{ ui.csrf() }}<input type="hidden" name="action" value="record">
                <label>Policy version <input type="text" name="policy_version" value="{{ policy.version_in_force }}" required maxlength="64"></label>
                <label>Reference (e.g. signed agreement) <input type="text" name="reference" required maxlength="255"></label>
                <button type="submit">Record acceptance</button>
            </form>
        </details>
        <details class="actionform"><summary class="btn btn-secondary">{{ policy.required ? 'Exempt from policy acceptance' : 'Require policy acceptance' }}</summary>
            <form method="post" action="{{ path('dashboard_operator_client_policy', {id: c.id}) }}" class="stack">
                {{ ui.csrf() }}<input type="hidden" name="action" value="{{ policy.required ? 'exempt' : 'require' }}">
                <label>Why? (kept in the audit log) <input type="text" name="note" required minlength="3"></label>
                <button type="submit">{{ policy.required ? 'Exempt' : 'Require' }}</button>
            </form>
        </details>
        </div>
        {% endif %}
    </section>
    <section class="card g-col-4 xl:g-col-2" aria-labelledby="opt-h">
        <div class="card-head"><h2 id="opt-h">Recipient global opt-outs</h2>{{ ui.tip('A client with this capability may report an opt-out that blocks the address for every client of the installation.') }}</div>
        <p>{% if c.can_submit_global_suppressions %}<span class="st st-active">Permitted</span>{% else %}<span class="st">Not permitted</span>{% endif %}</p>
        {% if is_granted('PLATFORM.CLIENT.MANAGE') %}
        <details class="actionform"><summary class="btn btn-secondary">{{ c.can_submit_global_suppressions ? 'Withdraw the capability' : 'Grant the capability' }}</summary>
            <form method="post" action="{{ path('dashboard_operator_client_capability', {id: c.id}) }}" class="stack">
                {{ ui.csrf() }}
                <input type="hidden" name="setting" value="{{ c.can_submit_global_suppressions ? 'disable' : 'enable' }}">
                <label>Why? (kept in the audit log) <input type="text" name="note" required minlength="3"></label>
                <button type="submit">{{ c.can_submit_global_suppressions ? 'Withdraw' : 'Grant' }}</button>
            </form>
        </details>
        {% endif %}
    </section>
</div>
{% endif %}

{% if tab == 'history' %}
<section class="card card-flush" aria-labelledby="aud-h">
    <div class="card-head"><h2 id="aud-h">History</h2>{% if is_granted('PLATFORM.AUDIT.VIEW') %}<a class="more" href="{{ path('dashboard_operator_audit', {target_type: 'client', target_id: c.id}) }}">In the audit log</a>{% endif %}</div>
    {% if audit is empty %}<p class="empty">No entries.</p>{% else %}
    <div class="scroll"><table class="list"><thead><tr><th scope="col">When</th><th scope="col">What</th><th scope="col">Who</th><th scope="col"><span class="sr">Details</span></th></tr></thead>
    <tbody>{% for a in audit|slice(0, 20) %}<tr><td class="nowrap" title="{{ a.occurred_at|ts }}">{{ a.occurred_at|when }}</td><td><strong>{{ a.action|audit_label }}</strong></td><td>{{ a.actor_email ?? (a.actor_type ~ (a.actor_id ? ': ' ~ a.actor_id : '')) }}</td>
        <td class="tipcell">{% set lines = [a.action] %}{% for k, v in a.detail %}{% set lines = lines|merge([k ~ ': ' ~ (v is iterable ? v|json_encode : (v is same as(true) ? 'true' : (v is same as(false) ? 'false' : (v ?? 'null'))))]) %}{% endfor %}{{ ui.tip(lines|join(' · ')) }}</td></tr>{% endfor %}</tbody></table></div>
    {% endif %}
</section>
{% endif %}
{% endblock %}
