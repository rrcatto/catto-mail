{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Role {{ role.roleKey }}{% endblock %}
{% block crumb_tail %}{{ role.roleKey }}{% endblock %}
{% block body %}
{% set manage = is_granted('SYSTEM.ROLE.MANAGE') and not is_admin_role %}
<div class="pagehead">
    <div>
        <div class="titleline"><h1><code>{{ role.roleKey }}</code> {{ role.name }}</h1>{% if not role.builtin %}<span class="tag">custom</span>{% endif %}</div>
        <p class="lead">Held by <a href="{{ path('dashboard_operator_users', {role: role.roleKey}) }}">{{ holders }} user{{ holders == 1 ? '' : 's' }}</a>.{{ ui.tip((is_admin_role ? 'ADMIN always holds every permission and cannot be changed; the account whose email is APP_ADMIN_EMAIL receives it at every sign-in. ' : '') ~ 'System permissions (roles and ADMIN) belong to ADMIN alone. Client pages are governed by client memberships, except PLATFORM.CLIENT.VIEW and PLATFORM.CLIENT.MANAGE, which give access to every client.') }}</p>
    </div>
    {% if is_granted('SYSTEM.ROLE.MANAGE') and not role.builtin %}
    <details class="actionform"><summary class="btn btn-stop">Delete this role</summary>
        <form method="post" action="{{ path('dashboard_operator_role_delete', {id: role.id.toRfc4122}) }}" class="stack" data-controller="confirm" data-confirm-message-value="Delete the role {{ role.roleKey }}?">
            {{ ui.csrf() }}{% if holders > 0 %}<p class="small">Revoke it from every user first.</p>{% endif %}
            <button type="submit" class="danger"{% if holders > 0 %} disabled{% endif %}>Delete role</button>
        </form>
    </details>
    {% endif %}
</div>
<form method="post" action="{{ path('dashboard_operator_role_update', {id: role.id.toRfc4122}) }}" class="grid">
    {{ ui.csrf() }}
    <section class="card g-col-4 xl:g-col-1" aria-labelledby="role-details-h">
        <h2 id="role-details-h">Name and description</h2>
        <div class="form-grid">
            <label>Name <input type="text" name="name" value="{{ role.name }}" required maxlength="100"{% if not manage %} disabled{% endif %}></label>
            <label>Description <input type="text" name="description" value="{{ role.description }}" maxlength="300"{% if not manage %} disabled{% endif %}></label>
        </div>
    </section>
    <section class="card g-col-4 xl:g-col-3" aria-labelledby="role-perms-h">
        <h2 id="role-perms-h">Permissions</h2>
        <div class="grid">
        {% for group, permissions in groups %}
            <fieldset class="perms g-col-4 md:g-col-2 xl:g-col-1">
                <legend>{{ group }}</legend>
                {% for p in permissions %}
                    <label class="checkline"><input type="checkbox" name="permissions[]" value="{{ p.key }}"{% if p.key in granted %} checked{% endif %}{% if not manage %} disabled{% endif %}> <span><code>{{ p.key }}</code> – {{ p.description }}</span></label>
                {% endfor %}
            </fieldset>
        {% endfor %}
        </div>
        {% if manage %}<div class="form-actions"><button type="submit">Save role</button></div>{% endif %}
    </section>
</form>
{% endblock %}
