{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Address batches{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>Address batches</h1>
        <p class="lead">Upload a list, validate it, review it and, once approved, send to it in careful stages.{{ ui.tip('An operational tool for validation and for re-permission of an old list; the client application remains where subscribers are managed. At most ' ~ (max|number_format) ~ ' addresses per list.') }}</p>
    </div>
    <div class="actionrow">
        {{ ui.help('uploading-lists', 'Help: uploading lists') }}
        <a class="btn" href="{{ path('dashboard_operator_batch_new') }}">Upload a list</a>
    </div>
</div>

<section class="card card-flush" aria-labelledby="list-h">
    <div class="card-head"><h2 id="list-h">Batches</h2></div>
    {% if batches is empty %}<p class="empty">No batch yet.</p>{% else %}
    <div class="scroll"><table class="list">
    <thead><tr><th scope="col">Batch</th><th scope="col">Client</th><th scope="col">Purpose</th><th scope="col" class="num">Unique addresses</th><th scope="col">Uploaded</th><th scope="col">Approval</th><th scope="col" class="num">Sends</th><th scope="col"><span class="sr">Details</span></th></tr></thead>
    <tbody>{% for b in batches %}<tr><td><a href="{{ path('dashboard_operator_batch', {id: b.id}) }}"><strong>{{ b.name }}</strong></a></td>
    <td>{{ b.company_name }}</td><td><span class="tag">{{ b.purpose }}</span></td><td class="num">{{ b.imported_count|number_format }}</td><td>{{ b.created_at|when }}</td>
    <td>{% if b.compliance_approved_at %}<span class="st st-completed">approved</span>{% else %}<span class="muted">not yet</span>{% endif %}</td><td class="num">{{ b.sends }}</td>
    <td class="tipcell">{{ ui.tip(b.original_filename ~ ' · ' ~ (b.data_rows|number_format) ~ ' rows · ' ~ (b.duplicate_count|number_format) ~ ' duplicates · ' ~ (b.malformed_count|number_format) ~ ' malformed · uploaded by ' ~ (b.uploaded_by ?? '—')) }}</td></tr>
    {% endfor %}</tbody></table></div>
    {% endif %}
</section>
{% endblock %}
