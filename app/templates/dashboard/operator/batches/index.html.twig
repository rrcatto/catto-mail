{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Address batches{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>Address batches</h1>
        <p class="lead">Upload a list, validate it, review it and, once approved, send to it in careful stages.{{ ui.tip('An operational tool for validation and for re-permission of an old list; the client application remains where subscribers are managed. At most ' ~ (max|number_format) ~ ' addresses per list.') }}</p>
    </div>
    <div class="actionrow">
        {{ ui.help('uploading-lists', 'Help: uploading lists') }}
        <details class="actionform"><summary class="btn">Upload a list</summary>
            <form method="post" action="{{ path('dashboard_operator_batch_preview') }}" enctype="multipart/form-data" class="stack">
                {{ ui.csrf() }}
                <label>File: TXT (one address per line) or CSV (with a header row) — at most 10 MiB and {{ max|number_format }} addresses
                    <input type="file" name="file" accept=".txt,.csv,text/plain,text/csv" required></label>
                <label>On behalf of client (its quotas, sending domains and suppressions apply)
                    <select name="client" required><option value="">Choose…</option>{% for c in clients %}<option value="{{ c.id }}">{{ c.company_name }} ({{ c.status }})</option>{% endfor %}</select></label>
                <label>Batch name <input name="name" required maxlength="200"></label>
                <label>Purpose
                    <select name="purpose"><option value="validation">Validation (and test sends)</option><option value="repermission">Re-permission: ask an old list whether they still want mail</option></select></label>
                <label>List identifier (List-Id, e.g. <code>news.example.org</code>; needed for re-permission and any send beyond a seed test) <input name="list_id" maxlength="100" pattern="[A-Za-z0-9][A-Za-z0-9._-]{0,99}"></label>
                <label>Where the list comes from (optional) <input name="source" maxlength="500" placeholder="e.g. export of the 2019 newsletter list"></label>
                <label>Description (optional) <textarea name="description" maxlength="2000" rows="2"></textarea></label>
                <button type="submit">Preview</button>
                <p class="small muted">The preview shows what will be imported before anything is stored; duplicates and rows that are not addresses are listed, never dropped silently.</p>
            </form>
        </details>
    </div>
</div>

<section class="card card-flush" aria-labelledby="list-h">
    <div class="card-head"><h2 id="list-h">Batches</h2></div>
    {% if batches is empty %}<p class="empty">No batch yet.</p>{% else %}
    <div class="scroll"><table class="list">
    <thead><tr><th scope="col">Batch</th><th scope="col">Client</th><th scope="col">Purpose</th><th scope="col" class="num">Unique addresses</th><th scope="col">Uploaded</th><th scope="col">Approval</th><th scope="col" class="num">Sends</th><th scope="col"><span class="sr">Details</span></th></tr></thead>
    <tbody>{% for b in batches %}<tr><td><a href="{{ path('dashboard_operator_batch', {id: b.id}) }}"><strong>{{ b.name }}</strong></a></td>
    <td>{{ b.company_name }}</td><td><span class="tag">{{ b.purpose }}</span></td><td class="num">{{ b.imported_count|number_format }}</td><td>{{ b.created_at|when }}</td>
    <td>{% if b.compliance_approved_at %}<span class="st st-completed">approved</span>{% else %}<span class="muted">not yet</span>{% endif %}</td><td class="num">{{ b.sends }}</td>
    <td class="tipcell">{{ ui.tip(b.original_filename ~ ' · ' ~ (b.data_rows|number_format) ~ ' rows · ' ~ (b.duplicate_count|number_format) ~ ' duplicates · ' ~ (b.malformed_count|number_format) ~ ' malformed · uploaded by ' ~ (b.uploaded_by ?? '—')) }}</td></tr>
    {% endfor %}</tbody></table></div>
    {% endif %}
</section>
{% endblock %}
