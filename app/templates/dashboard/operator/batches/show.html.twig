{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% import _self as me %}
{% macro flink(batch, f, label, n) %}<li><a href="{{ path('dashboard_operator_batch_entries', {id: batch.id, filter: f}) }}">{{ label }}</a><span class="num">{{ n|number_format }}</span></li>{% endmacro %}
{% block title %}Batch {{ batch.name }}{% endblock %}
{% block crumb_tail %}{{ batch.name }}{% endblock %}
{% block body %}
{% set s = summary %}
<div class="pagehead">
    <div>
        <div class="titleline"><h1>{{ batch.name }}</h1><span class="tag">{{ batch.purpose == 'repermission' ? 'Re-permission' : 'Validation' }}</span></div>
        <p class="lead">For <strong>{{ batch.company_name }}</strong>, uploaded {{ batch.created_at|when }} by {{ batch.uploaded_by ?? '—' }}.{{ ui.tip('From ' ~ batch.original_filename ~ (batch.email_column ? ' (column ' ~ batch.email_column ~ ')' : '') ~ (batch.source ? ' · source: ' ~ batch.source : '') ~ (batch.description ? ' · ' ~ batch.description : '') ~ ' · client status ' ~ batch.client_status) }}</p>
    </div>
    <a class="btn" href="{{ path('dashboard_operator_batch_send', {id: batch.id, stage: 'seed'}) }}">Prepare a send</a>
</div>

<div class="kpis">
    <section class="card kpi"><div class="kpi-head"><h2>Unique addresses</h2>{{ ui.tip((batch.data_rows|number_format) ~ ' rows uploaded · ' ~ (s.duplicate|number_format) ~ ' duplicates · ' ~ (s.malformed|number_format) ~ ' malformed') }}</div><p class="kpi-value">{{ s.imported|number_format }}</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Valid</h2></div><p class="kpi-value">{{ s.valid|number_format }}</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Eligible to send</h2></div><p class="kpi-value">{{ s.eligible|number_format }}</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Needs review</h2></div><p class="kpi-value{{ s.pending_review ? ' text-warn' : '' }}">{{ s.pending_review|number_format }}</p></section>
</div>

<section class="card" aria-labelledby="val-h" {% if progress.running %}data-controller="progress" data-progress-url-value="{{ path('dashboard_operator_batch_progress', {id: batch.id}) }}"{% endif %}>
    <div class="card-head"><h2 id="val-h">Validation</h2>{{ ui.tip('The Email Validator does the work, as ordinary validation jobs of ' ~ batch.company_name ~ ' (its quotas apply).') }}{{ ui.help('validation', 'How validation works') }}</div>
    {% if progress.linked == 0 %}<p>Not validated yet.</p>{% else %}
    <p><progress data-progress-target="bar" max="100" value="{{ progress.percent }}">{{ progress.percent }} %</progress></p>
    <p data-progress-target="text">{{ progress.done|number_format }} of {{ progress.linked|number_format }} processed ({{ progress.percent }} %){% if progress.running %}; this page follows the validator and reloads when it has finished.{% endif %}</p>{% endif %}
    <form method="post" action="{{ path('dashboard_operator_batch_validate', {id: batch.id}) }}">{{ ui.csrf() }}
        <button type="submit"{% if progress.linked > 0 %} class="secondary"{% endif %}>{{ progress.linked == 0 ? 'Validate the batch' : 'Validate addresses without a result' }}</button>
    </form>
</section>

<section class="card" aria-labelledby="res-h">
    <div class="card-head"><h2 id="res-h">Results</h2>{{ ui.tip('Each line opens the addresses behind it.') }}<a class="more" href="{{ path('dashboard_operator_batch_entries', {id: batch.id}) }}">Every address</a></div>
    <div class="resultcols">
        <div><h3>Validation {{ ui.help('validation-results', '?') }}</h3><ul class="countlist">
            {% for f, label in {valid: 'Valid', invalid: 'Invalid', risky: 'Risky', unknown: 'Unknown', temporary_failure: 'Temporary failure', pending: 'Pending'} %}{{ me.flink(batch, f, label, attribute(s, f)) }}{% endfor %}
        </ul></div>
        <div><h3>Flags</h3><ul class="countlist">
            {% for f, label in {typo_suspected: 'Typo suspected', disposable: 'Disposable', role_account: 'Role accounts', accept_all: 'Accept-all domains'} %}{{ me.flink(batch, f, label, attribute(s, f)) }}{% endfor %}
        </ul></div>
        <div><h3>Sending {{ ui.help('suppressions', '?') }}</h3><ul class="countlist">
            {{ me.flink(batch, 'eligible', 'Eligible', s.eligible) }}{{ me.flink(batch, 'unsent_eligible', '… not sent yet', s.unsent_eligible) }}{{ me.flink(batch, 'pending_review', 'Needs review', s.pending_review) }}
            {{ me.flink(batch, 'suppressed', 'Suppressed', s.suppressed) }}{{ me.flink(batch, 'blocked', 'All blocked', s.blocked) }}{{ me.flink(batch, 'excluded', 'Excluded', s.excluded) }}
        </ul></div>
        {% if batch.purpose == 'repermission' or s.confirmed + s.unsubscribed + s.global_opt_out + s.unconfirmed > 0 %}
        <div><h3>Answers {{ ui.help('repermission', '?') }}</h3><ul class="countlist">
            {% for f, label in {unconfirmed: 'No answer yet', confirmed: 'Confirmed', unsubscribed: 'Unsubscribed', global_opt_out: 'Global opt-out'} %}{{ me.flink(batch, f, label, attribute(s, f)) }}{% endfor %}
        </ul></div>{% endif %}
    </div>
</section>

<section class="card" aria-labelledby="send-h">
    <div class="card-head"><h2 id="send-h">Sending</h2>{{ ui.tip('Sends go in stages: a seed test to your own addresses, a small controlled sample, rollout portions while you watch bounces and complaints, then the full remaining eligible list. A new server or IP must never start with the whole list.') }}{{ ui.help('sending', '?') }}</div>
    <p>Delivery is <span class="mode mode-{{ delivery.mode }}">{{ delivery.mode }}</span>.
        List identifier: {% if batch.list_id %}<code>{{ batch.list_id }}</code>{% else %}<strong class="text-warn">not set</strong>{% endif %}.
        Compliance approval: {% if batch.compliance_approved_at %}<span class="st st-completed">approved</span> {{ ui.tip((batch.compliance_approved_at|ts) ~ ' by ' ~ batch.approved_by ~ ': ' ~ batch.compliance_reference) }}{% else %}<strong class="text-warn">not approved</strong>{{ ui.tip('Technical validation is not consent. Before anything but a seed test is sent, record who approved mailing these people and on what basis.') }}{% endif %}</p>
    <div class="actionrow">
        <details class="actionform"><summary class="btn btn-secondary">{{ batch.list_id ? 'Change the list identifier' : 'Set the list identifier' }}</summary>
            <form method="post" action="{{ path('dashboard_operator_batch_list_id', {id: batch.id}) }}" class="stack">{{ ui.csrf() }}<label>List identifier <input name="list_id" placeholder="news.example.org" pattern="[A-Za-z0-9][A-Za-z0-9._-]{0,99}" required></label><button type="submit">Set</button></form>
        </details>
        {% if not batch.compliance_approved_at %}
        <details class="actionform"><summary class="btn btn-secondary">Record the approval</summary>
            <form method="post" action="{{ path('dashboard_operator_batch_approve', {id: batch.id}) }}" class="stack">{{ ui.csrf() }}
                <label>Approval (who, when, basis, reference) <textarea name="reference" required minlength="3" maxlength="1000" rows="2"></textarea></label>
                <button type="submit">Record the approval</button></form>
        </details>
        {% endif %}
    </div>
    {% if sends is not empty %}
    <h3>Sends from this batch</h3>
    <div class="scroll"><table class="list"><thead><tr><th scope="col">Created</th><th scope="col">Stage</th><th scope="col" class="num">Recipients</th><th scope="col">Subject</th><th scope="col">Status</th></tr></thead>
    <tbody>{% for x in sends %}<tr><td title="{{ x.created_at|ts }} by {{ x.created_by }}">{{ x.created_at|when }}</td><td><span class="tag">{{ x.stage }}</span></td><td class="num">{{ x.recipient_count|number_format }}</td><td>{{ x.subject }}</td>
    <td><a href="{{ path('dashboard_operator_batch_send_report', {id: batch.id, jobId: x.send_job_id}) }}">{{ ui.status(x.status, 'send_job_status') }}</a></td></tr>{% endfor %}</tbody></table></div>
    <details><summary>Every send together</summary>{% include 'dashboard/operator/batches/_report.html.twig' with {report: report} %}</details>
    {% endif %}
</section>

<details class="morefilters">
    <summary>Download CSV</summary>
    <p class="card">{% for f in ['all', 'valid', 'invalid', 'risky', 'unknown', 'temporary_failure', 'typo_suspected', 'eligible', 'pending_review', 'blocked', 'malformed', 'duplicate'] %}<a href="{{ path('dashboard_operator_batch_export', {id: batch.id, filter: f}) }}">{{ f|replace({'_': ' '}) }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
</details>
{% endblock %}
