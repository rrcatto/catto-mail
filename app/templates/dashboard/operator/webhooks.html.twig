{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Webhooks{% endblock %}
{% block body %}
{% set failed = summary.deliveries.failed ?? 0 %}
{% set outbox = filters.state != '' %}
{% set alive = summary.workers|filter(w => w.alive)|length %}
<div class="pagehead">
    <div>
        <h1>Webhooks</h1>
        <p class="lead">{% if failed %}<strong class="text-bad">{{ failed|number_format }} deliver{{ failed == 1 ? 'y' : 'ies' }} failed</strong> in the last 24 hours.{% else %}No delivery failed in the last 24 hours.{% endif %}
            {{ alive }} worker{{ alive == 1 ? '' : 's' }} running.</p>
    </div>
    <div class="actions">{{ ui.help('webhooks', 'Help: webhooks') }}</div>
</div>

<div class="kpis">
    <section class="card kpi"><div class="kpi-head"><h2>Failed (24 h)</h2>{{ ui.tip('A delivery fails after its last retry; the endpoint never answered 2xx. Delivery is at-least-once and signed.') }}</div><p class="kpi-value{{ failed ? ' text-bad' : '' }}">{{ failed|number_format }}</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Retrying</h2></div><p class="kpi-value">{{ (summary.deliveries.retrying ?? 0)|number_format }}</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Pending</h2>{{ ui.tip(summary.events_awaiting_fanout|number_format ~ ' outbox events are waiting to be turned into deliveries.') }}</div><p class="kpi-value">{{ (summary.deliveries.pending ?? 0)|number_format }}</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Delivered (24 h)</h2></div><p class="kpi-value">{{ (summary.deliveries.delivered ?? 0)|number_format }}</p></section>
</div>

<nav class="chips" aria-label="Views of the webhooks">
    {% for key, label in {failed: 'Failed', retrying: 'Retrying', pending: 'Pending', delivered: 'Delivered', '': 'Every delivery'} %}<a class="chip-link" href="{{ path('dashboard_operator_webhooks', key ? {status: key} : {}) }}"{% if not outbox and filters.status == key %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
    <a class="chip-link" href="{{ path('dashboard_operator_webhooks', {state: 'awaiting_fanout'}) }}"{% if outbox %} aria-current="page"{% endif %}>Outbox events</a>
</nav>

{% if not outbox %}
<details class="morefilters"{% if filters.event_type or filters.client %} open{% endif %}>
    <summary>More filters: event, client</summary>
    <form method="get" class="filters" role="search" aria-label="Filter deliveries">
        {% if filters.status %}<input type="hidden" name="status" value="{{ filters.status }}">{% endif %}
        {{ ui.select('event_type', 'Event', {'validation.completed': 'validation.completed', 'validation.failed': 'validation.failed', 'send.completed': 'send.completed', 'send.failed': 'send.failed', 'message.hard_bounced': 'message.hard_bounced', 'message.complained': 'message.complained', 'webhook.test': 'webhook.test'}, filters.event_type) }}
        <label>Client id <input type="text" name="client" value="{{ filters.client }}" pattern="[0-9a-fA-F-]{36}"></label>
        <button type="submit">Apply</button>
    </form>
</details>
<section class="card card-flush" aria-labelledby="deliveries">
    <div class="card-head"><h2 id="deliveries">{{ {failed: 'Failed deliveries', retrying: 'Retrying deliveries', pending: 'Pending deliveries', delivered: 'Delivered'}[filters.status] ?? 'Every delivery' }}</h2></div>
    {% include 'dashboard/_webhook_deliveries.html.twig' with {rows: page.rows, show_client: true} %}
</section>
{{ ui.pager(page, 'deliveries') }}
{% else %}
<nav class="seg" aria-label="Outbox events">
    <a href="{{ path('dashboard_operator_webhooks', {state: 'awaiting_fanout'}) }}"{% if filters.state == 'awaiting_fanout' %} aria-current="page"{% endif %}>Awaiting fan-out</a>
    <a href="{{ path('dashboard_operator_webhooks', {state: 'fanned_out'}) }}"{% if filters.state == 'fanned_out' %} aria-current="page"{% endif %}>Fanned out</a>
</nav>
<section class="card card-flush" aria-labelledby="outbox-h">
    <div class="card-head"><h2 id="outbox-h">Outbox events</h2>{{ ui.tip('The webhook worker turns each outbox event into one delivery per subscribed, enabled endpoint.') }}
        {% if events.next %}<a class="more" href="{{ path('dashboard_operator_webhooks', app.request.query.all|merge({events_cursor: events.next})) }}">More »</a>{% endif %}</div>
    {% if events.rows is empty %}<p class="empty">No outbox events match.</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">When</th><th scope="col">Client</th><th scope="col">Event</th><th scope="col">Fanned out</th><th scope="col" class="num">Deliveries</th></tr></thead>
        <tbody>{% for w in events.rows %}
            <tr><td class="nowrap" title="{{ w.created_at|ts }}">{{ w.created_at|when }}</td><td>{{ w.company_name }}</td><td><code>{{ w.event_type }}</code> {{ ui.tip(w.subject_type ~ ' ' ~ w.subject_id) }}</td><td>{{ w.fanned_out_at ? w.fanned_out_at|when : 'Waiting' }}</td><td class="num">{{ w.deliveries }}</td></tr>
        {% endfor %}</tbody>
    </table></div>
    {% endif %}
</section>
{% endif %}

<details class="morefilters">
    <summary>Workers ({{ summary.workers|length }})</summary>
    {% if summary.workers is empty %}<p class="warn" role="status">No webhook worker has reported in the last day.</p>{% else %}
    <div class="card card-flush"><div class="scroll"><table class="list">
        <thead><tr><th scope="col">Worker</th><th scope="col">State</th><th scope="col">Last seen</th><th scope="col" class="num">Delivered</th><th scope="col"><span class="sr">Details</span></th></tr></thead>
        <tbody>{% for w in summary.workers %}
            <tr><td><code>{{ w.worker_id }}</code></td>
                <td><span class="st st-{{ w.alive ? 'active' : (w.stopped_at ? 'disabled' : 'failed') }}">{{ w.alive ? 'Running' : (w.stopped_at ? 'Stopped' : 'Not responding') }}</span></td>
                <td>{{ w.last_seen_at|when }}</td><td class="num">{{ w.delivered|number_format }}</td>
                <td class="tipcell">{{ ui.tip('Version ' ~ w.version ~ ' · started ' ~ (w.started_at|ts) ~ ' · ' ~ w.attempts ~ ' attempts · ' ~ w.events_fanned_out ~ ' events fanned out') }}</td></tr>
        {% endfor %}</tbody>
    </table></div></div>
    {% endif %}
</details>
{% endblock %}
