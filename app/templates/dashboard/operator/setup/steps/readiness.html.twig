{% import 'dashboard/_macros.html.twig' as ui %}
{% set passing = readiness|filter(r => r.result == 'pass')|length %}
<section class="card card-flush" aria-labelledby="ready-h">
<div class="card-head"><div><h2 id="ready-h">Production readiness</h2>
<p class="muted small">One summary of every subsystem. PASS everywhere (WARN understood) means the installation is ready. <strong>Live delivery stays a separate, deliberate action</strong>
under <a href="{{ path('dashboard_operator_system') }}">Mail flow › Delivery</a>: it runs the activation preflight and is audited.</p></div>
<span class="big">{{ passing }} of {{ readiness|length }} <span>pass</span></span></div>
<div class="scroll"><table class="dense"><tbody>
{% for label, r in readiness %}<tr><th scope="row">{{ label }}</th><td>{{ ui.result(r.result) }}</td>
<td><small>{% set bad = r.checks|filter(c => c.result in ['fail', 'warn']) %}{% for c in bad|slice(0, 2) %}{{ c.title }}: {{ c.summary }}<br>{% else %}{% if r.checks is empty %}no check yet{% endif %}{% endfor %}</small></td></tr>{% endfor %}
<tr><th scope="row">Live delivery</th><td><span class="mode mode-{{ delivery.mode }}">{{ delivery.mode }}</span></td><td></td></tr>
</tbody></table></div>
</section>
<section class="card" aria-labelledby="accept-h">
<h2 id="accept-h">Real-server acceptance checklist</h2>
<p class="muted">The guide <code>docs/production/VPS-INSTALL.md</code> holds the complete checklist; each line maps to a row above or to the seed, bounce and reboot tests.</p>
</section>
