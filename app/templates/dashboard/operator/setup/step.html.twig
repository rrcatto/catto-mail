{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Setup {{ step.n }}: {{ title }}{% endblock %}
{% block crumb_tail %}Step {{ step.n }} of {{ steps|length }}{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <div class="titleline"><h1>{{ step.n }}. {{ title }}</h1><span class="setup-chip setup-chip-{{ step.state == 'done' ? 'done' : 'todo' }}">{{ step.state == 'done' ? 'Done' : (step.state == 'skipped' ? 'Skipped' : 'To do') }}</span></div>
        <p class="lead">{{ purpose }}</p>
    </div>
    <nav class="stepnav" aria-label="Other steps">
        {% if prev %}<a class="btn btn-secondary" href="{{ path('dashboard_operator_setup_step', {step: prev}) }}">« {{ steps[prev].title }}</a>{% endif %}
        {% if next %}<a class="btn btn-secondary" href="{{ path('dashboard_operator_setup_step', {step: next}) }}">{{ steps[next].title }} »</a>{% endif %}
    </nav>
</div>

<div class="step-main">
    {% include 'dashboard/operator/setup/steps/' ~ step.key ~ '.html.twig' %}

    {% if checks is not empty or step.key not in ['welcome', 'seed_test', 'bounce_test', 'readiness'] %}
    <section class="card card-flush" aria-labelledby="checks-h">
        <div class="card-head">
            <h2 id="checks-h">Checks</h2>{% if is_granted('SYSTEM.DIAGNOSTICS.RUN') %}{{ ui.tip('The host agent\'s results arrive within a minute after a run; reload the page.') }}
            <form method="post" action="{{ path('dashboard_operator_diagnostics_run') }}" class="inline">{{ ui.csrf() }}<input type="hidden" name="return_to" value="{{ path('dashboard_operator_setup_step', {step: step.key}) }}"><button type="submit" class="secondary">Run the checks again</button></form>{% endif %}
        </div>
        {{ ui.checks(checks) }}
    </section>
    {% endif %}

    <section class="card card-accent" aria-labelledby="this-h">
        <div class="card-head"><h2 id="this-h">{{ step.state == 'done' ? 'This step is done' : 'When the checks are satisfactory' }}</h2>{% for t in topics %}{{ ui.help(t, 'Help: ' ~ help_title(t)) }}{% endfor %}</div>
        {% if step.state %}<p class="muted">{{ step.state == 'done' ? 'Marked done' : 'Skipped' }} {{ step.updated_at|when }}{% if step.note %}: {{ step.note }}{% endif %}.</p>{% endif %}
        <form method="post" action="{{ path('dashboard_operator_setup_state', {step: step.key}) }}" class="stack">
            {{ ui.csrf() }}
            <label>Note (optional, kept with the step) <input name="note" maxlength="1000" value="{{ step.note }}"></label>
            <p class="form-actions">
                {% if step.state != 'done' %}<button type="submit" name="state" value="done">Mark done and continue</button>{% endif %}
                {% if step.state is null %}<button type="submit" name="state" value="skipped" class="secondary">Skip for now</button>{% endif %}
                {% if step.state %}<button type="submit" name="state" value="" class="secondary">Mark not done</button>{% endif %}
            </p>
        </form>
    </section>
</div>
{% endblock %}
