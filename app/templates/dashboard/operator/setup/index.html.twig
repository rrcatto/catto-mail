{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}System setup{% endblock %}
{% block body %}
<h1>System setup</h1>
<p>This wizard takes you through everything catto-mail needs, in the order the parts depend on each other. You can leave at any time and continue later:
    progress is saved. It stays here after setup as a checklist you can revisit. {{ ui.help('overview', 'What catto-mail is') }}</p>
{% if complete %}<p class="flash flash-success">Setup is complete. Live delivery is a separate decision: see <a href="{{ path('dashboard_operator_system') }}">Health &amp; delivery</a>.</p>
{% elseif current %}<p><a href="{{ path('dashboard_operator_setup_step', {step: current}) }}"><strong>Continue with step {{ steps[current].n }}: {{ steps[current].title }} »</strong></a></p>{% endif %}
{% if agent_age is null %}<p class="warn">The host agent has not reported yet, so the host, DNS, TLS, Postfix and backup checks are missing. It is installed by <code>smarthostctl prod install</code> and reports within a minute of starting.</p>{% endif %}
<ol class="steps">
{% for s in steps %}
    <li{% if s.key == current %} class="current" aria-current="step"{% endif %}>
        <span class="num">{{ s.n }}.</span>
        <span><a href="{{ path('dashboard_operator_setup_step', {step: s.key}) }}">{{ s.title }}</a><br><small class="muted">{{ s.purpose }}</small></span>
        <span>{% if s.state == 'done' %}{{ ui.result('pass') }} done{% elseif s.state == 'skipped' %}{{ ui.result('skipped') }} skipped{% else %}{{ ui.result('waiting') }} to do{% endif %}
            {% if s.checks != 'none' %}<small>· checks {{ ui.result(s.checks) }}</small>{% endif %}</span>
    </li>
{% endfor %}
</ol>
{% endblock %}
