{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% import 'dashboard/_icons.html.twig' as icon %}
{% block title %}System setup{% endblock %}
{% block body %}
{% set total = steps|length %}
{% set done = steps|filter(s => s.view == 'done')|length %}
{% set ready = steps|filter(s => s.view == 'ready')|length %}
<div class="pagehead">
    <div>
        <h1>System setup</h1>
        <p class="lead"><strong>{{ done }} of {{ total }}</strong> steps done.{% if not complete %} {% if ready %}<strong>{{ ready }}</strong> {{ ready == 1 ? 'is' : 'are' }} ready to mark done; {% endif %}<strong>{{ total - done - ready }}</strong> still need{{ total - done - ready == 1 ? 's' : '' }} something.{% endif %}</p>
        <progress class="setup-progress" max="{{ total }}" value="{{ done }}" aria-label="{{ done }} of {{ total }} steps done">{{ done }} of {{ total }}</progress>
    </div>
    {% if current and not complete %}<a class="btn" href="{{ path('dashboard_operator_setup_step', {step: current}) }}">Continue with step {{ steps[current].n }}: {{ steps[current].title }}</a>{% endif %}
</div>
{% if complete %}<p class="flash flash-success">Setup is complete. Live delivery is a separate decision: <a href="{{ path('dashboard_operator_system') }}">Mail flow › Delivery</a>.</p>{% endif %}
{% if agent_age is null %}<p class="warn">The host agent has not reported yet, so the host, DNS, TLS, Postfix and backup checks are missing.</p>{% endif %}

{% for group, keys in groups %}
<section class="card card-flush setup-group" aria-labelledby="sg-{{ loop.index }}">
    <div class="card-head"><h2 id="sg-{{ loop.index }}">{{ group }}</h2></div>
    {% for key in keys %}{% set s = steps[key] %}
    <details class="setup-step setup-{{ s.view }}{{ s.problem ? ' setup-problem' : '' }}" id="step-{{ key }}"{% if key == current and not complete %} open{% endif %}>
        <summary>
            <span class="setup-mark" aria-hidden="true">{{ s.view == 'todo' or s.problem ? '!' : '✓' }}</span>
            <span class="setup-text"><span class="setup-title">{{ s.n }}. {{ s.title }}</span>
                <span class="setup-line">{% if s.problem %}{{ s.problem.title }}: {{ s.problem.summary }}{% elseif s.view == 'ready' %}{{ s.check_rows is empty ? s.purpose : 'Every check passes.' }}{% if s.state == 'skipped' %} Skipped earlier.{% endif %}{% elseif s.view == 'todo' %}{{ s.purpose }}{% if s.state == 'skipped' %} Skipped earlier.{% endif %}{% endif %}</span></span>
            <span class="setup-chip setup-chip-{{ s.view }}">{{ s.view == 'done' ? 'Done' : (s.view == 'ready' ? 'Ready to mark done' : 'To do') }}</span>
        </summary>
        <div class="setup-body">
            {% if s.check_rows is not empty %}
            <ul class="plainlist setup-checks">{% for c in s.check_rows %}<li>{{ ui.result(c.result) }}<span><strong>{{ c.title }}</strong>: {{ c.summary }}</span></li>{% endfor %}</ul>
            {% endif %}
            <div class="form-actions">
                {% if s.view != 'done' %}
                <form method="post" action="{{ path('dashboard_operator_setup_state', {step: key}) }}" class="inline">{{ ui.csrf() }}<input type="hidden" name="return" value="index"><button type="submit" name="state" value="done"{% if s.view == 'todo' %} class="secondary"{% endif %}>Mark done</button></form>
                {% endif %}
                <a class="btn btn-secondary" href="{{ path('dashboard_operator_setup_step', {step: key}) }}">Open the step</a>
                {% if s.topic %}{{ ui.help(s.topic, 'Help: ' ~ s.topic|replace({'-': ' '})) }}{% endif %}
            </div>
        </div>
    </details>
    {% endfor %}
</section>
{% endfor %}
{% endblock %}
