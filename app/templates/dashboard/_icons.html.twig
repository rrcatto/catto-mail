    mail: '<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M3.8 7 12 12.8 20.2 7"/>',
    clients: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
    system: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
    access: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>',
