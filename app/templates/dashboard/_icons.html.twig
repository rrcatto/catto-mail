<svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ (paths[name] ?? paths.overview)|raw }}</svg>
{%- endmacro %}

{# The Catto Mail mark: an envelope with cat ears. #}
