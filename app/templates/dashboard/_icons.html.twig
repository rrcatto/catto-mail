{# Bootstrap Icons 1.13.2 (owner decision 2026-10-27), vendored through the import map and linked by
   _site.html.twig. `name` is a Bootstrap Icons name (icons.getbootstrap.com) or one of the short names
   below. Decorative: aria-hidden, the text next to an icon carries the meaning. The size is a class
   (icon-13 … icon-22 in app.css): the Content-Security-Policy allows no inline style. #}
{% macro i(name, size = 20, extra = '') %}
{%- set names = {
    overview: 'grid-1x2', mail: 'envelope', clients: 'people', system: 'hdd-rack', access: 'shield-lock',
    help: 'question-circle', switch: 'arrow-left-right', send: 'send', check: 'check2-circle', settings: 'sliders',
    usage: 'bar-chart-line', search: 'search', bell: 'bell', stop: 'sign-stop', plus: 'plus-lg', refresh: 'arrow-clockwise',
    arrow: 'arrow-right', up: 'arrow-up', down: 'arrow-down', flat: 'dash', chevron: 'chevron-right',
    'chevron-down': 'chevron-down', menu: 'list', info: 'info-circle', alert: 'exclamation-triangle', link: 'link-45deg',
    inbox: 'inbox', user: 'person', list: 'list-ul', activity: 'activity', copy: 'copy', globe: 'globe2',
} -%}
<i class="bi bi-{{ names[name] ?? name }} icon icon-{{ size }}{{ extra ? ' ' ~ extra : '' }}" aria-hidden="true"></i>
{%- endmacro %}

{# The Catto Mail mark: an envelope with cat ears. #}
{% macro logo(size = 44) %}
<svg class="logo" width="{{ size }}" height="{{ size }}" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><circle cx="16" cy="16" r="16" class="logo-disc"/><path d="M8.6 11.2 10.2 6.2 13.8 10.6M18.2 10.6 21.8 6.2 23.4 11.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><rect x="7" y="10.8" width="18" height="13.6" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8.2 12.6 16 18.2l7.8-5.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endmacro %}
