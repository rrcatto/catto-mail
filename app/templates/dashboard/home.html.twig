{% extends 'dashboard/layout.html.twig' %}
{% block title %}Home{% endblock %}
{% block body %}
<h1>Dashboard</h1>
{% if memberships is empty %}
    {% if app.user.platformUser %}
        <p>Use the Operator menu above.</p>
    {% else %}
        <p>Your account is not a member of any client yet. Ask an operator to add you to a client.</p>
    {% endif %}
{% else %}
    <h2>Your clients</h2>
    <table>
        <caption class="sr">Clients you are a member of</caption>
        <thead><tr><th scope="col">Client</th><th scope="col">Your role</th><th scope="col">Client status</th></tr></thead>
        <tbody>
        {% for m in memberships %}
            <tr>
                <td><a href="{{ path('dashboard_client_overview', {clientId: m.client.id.toRfc4122}) }}">{{ m.client.companyName }}</a></td>
                <td>{{ m.role.value|capitalize }}</td>
                <td>{{ m.client.status.value|label('client_status') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if is_granted('PLATFORM.OVERVIEW.VIEW') %}<p><a href="{{ path('dashboard_operator_overview') }}">Operator dashboard</a></p>{% endif %}
{% endif %}
{% endblock %}
