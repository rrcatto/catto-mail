{% extends 'dashboard/layout.html.twig' %}
{% block title %}Sign in{% endblock %}
{% block body %}
<section class="narrow" aria-labelledby="signin-h">
    <h1 id="signin-h">Sign in</h1>
    {% if error %}<p class="flash flash-error" role="alert">{{ error }}</p>{% endif %}
    {% set back = return_to|default(null) ? {return_to: return_to} : {} %}
    {% if back %}<p class="caveat">After you sign in, you continue connecting the application.</p>{% endif %}
    <p>Enter your email address and we will email you a sign-in link. There is no password.</p>
    <form method="post" action="{{ path('dashboard_login_request') }}" class="stack">
        {% if back %}<input type="hidden" name="return_to" value="{{ return_to }}">{% endif %}
        <label>Email address
            <input type="email" name="email" autocomplete="username" required autofocus maxlength="320">
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('login-link') }}">
        <button type="submit">Email me a sign-in link</button>
    </form>
    <p class="muted small">{% if public_sign_up_open() %}No account yet? <a href="{{ path('dashboard_sign_up', back) }}">Sign up</a>.{% else %}Accounts are opened by invitation.{% endif %} API keys cannot be used to sign in here.</p>
</section>
{% endblock %}
