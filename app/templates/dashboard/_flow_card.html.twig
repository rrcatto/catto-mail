{# Messages per bucket of the period (TrendCharts::flow). Variables: flow, period, flow_title. #}
<section class="card chart-card" aria-labelledby="flow-h">
    <div class="card-head">
        <h2 id="flow-h">{{ flow_title }}</h2>
        <p class="muted small">Messages per {{ period.unit }}, by the {{ period.unit }} their send job was created{% if flow.busiest %} · busiest: {{ flow.busiest.title }}, {{ flow.busiest.messages|number_format }}{% endif %}</p>
    </div>
    {% if flow.busiest is null %}
        <p class="empty">No send job was created in the period.</p>
    {% else %}
    <div class="chart chart-tall"><canvas data-controller="chart" data-chart-kind-value="flow" data-chart-config-value="{{ flow.chart|json_encode }}" role="img"
        aria-label="Bar chart of messages per {{ period.unit }} over the last {{ period.label }}; the table below has the figures."></canvas></div>
    {% endif %}
    <details class="figures">
        <summary>Figures</summary>
        <div class="scroll"><table class="dense">
            <thead><tr><th scope="col">{{ period.unit == 'hour' ? 'Hour' : 'Day' }} ({{ period.zoneAbbreviation }})</th><th scope="col" class="num">Messages</th><th scope="col" class="num">Remote accepted</th><th scope="col" class="num">Deferred or soft bounced</th><th scope="col" class="num">Hard bounced or complained</th><th scope="col" class="num">Suppressed</th></tr></thead>
            <tbody>{% for r in flow.rows %}<tr><td>{{ r.title }}</td><td class="num">{{ r.messages|number_format }}</td><td class="num">{{ r.accepted|number_format }}</td><td class="num">{{ r.deferred_soft|number_format }}</td><td class="num">{{ (r.hard + r.complained)|number_format }}</td><td class="num">{{ r.suppressed|number_format }}</td></tr>{% endfor %}</tbody>
        </table></div>
    </details>
</section>
