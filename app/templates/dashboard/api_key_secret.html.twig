{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}API key created{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>API key created</h1>
        <p class="sub">Account: {{ client_name }} · Name: {{ key.name ?? '—' }} · Prefix: <code>{{ key.keyPrefix }}…</code>{% if key.expiresAt %} · Expires {{ key.expiresAt|ts }}{% endif %}</p>
    </div>
</div>
<div class="grid">
<section class="card card-accent g-col-4 xl:g-col-2" aria-labelledby="secret-h">
    <h2 id="secret-h">Your new API key</h2>
    <p class="caveat"><strong>Copy this API key now.</strong> It is shown only this once: only a fingerprint of it is kept, so it cannot be shown again. Put it in your application's secret settings.</p>
    {{ ui.copy(raw, 'the API key', true) }}
    <p class="muted small">Rotation without downtime: deploy this key, check that its “last used” time appears, then revoke the previous key.</p>
    <div class="form-actions"><a class="btn" href="{{ back }}">Back</a></div>
</section>
</div>
{% endblock %}
