{% extends 'dashboard/layout.html.twig' %}
{% block title %}API key created{% endblock %}
{% block body %}
<h1>API key created</h1>
<p>Client: {{ client_name }} · Name: {{ key.name ?? '—' }} · Prefix: <code>{{ key.keyPrefix }}…</code>{% if key.expiresAt %} · Expires {{ key.expiresAt|ts }}{% endif %}</p>
<p class="caveat"><strong>Copy this API key now.</strong> It is shown only once and cannot be retrieved later: Smarthost stores only its SHA-256 hash. Store it in your application's secret store.</p>
<p><code class="token secret">{{ raw }}</code></p>
<p class="muted">Rotation without downtime: deploy this key, check that its “last used” time appears, then revoke the previous key.</p>
<p><a href="{{ back }}">Back</a></p>
{% endblock %}
