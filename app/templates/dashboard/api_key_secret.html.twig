{% extends 'dashboard/layout.html.twig' %}
{% block title %}API key created{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>API key created</h1>
        <p class="sub">Client: {{ client_name }} · Name: {{ key.name ?? '—' }} · Prefix: <code>{{ key.keyPrefix }}…</code>{% if key.expiresAt %} · Expires {{ key.expiresAt|ts }}{% endif %}</p>
    </div>
</div>
<section class="card card-accent" aria-labelledby="secret-h">
    <h2 id="secret-h">Your new API key</h2>
    <p class="caveat"><strong>Copy this API key now.</strong> It is shown only once and cannot be retrieved later: Smarthost stores only its SHA-256 hash. Store it in your application's secret store.</p>
    <p class="raw"><code class="token secret">{{ raw }}</code></p>
    <p class="muted small">Rotation without downtime: deploy this key, check that its “last used” time appears, then revoke the previous key.</p>
    <div class="form-actions"><a class="btn" href="{{ back }}">Back</a></div>
</section>
{% endblock %}
