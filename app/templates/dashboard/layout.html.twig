{% import 'dashboard/_macros.html.twig' as ui %}{% import 'dashboard/_icons.html.twig' as icon %}{% import '_site.html.twig' as site %}<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{ site.application_meta() }}
    <meta name="referrer" content="same-origin">
    <title>{% block title %}Dashboard{% endblock %} · {{ site_name() }}</title>
    {{ site.stylesheets() }}
    {{ importmap('app', {nonce: csp_nonce()}) }}
</head>
<body{% if not app.user %} class="bare"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
{% if app.user %}
{# The client workspace navigation only on client pages (some operator pages also pass a client). #}
{% set nav_client = client is defined and client and (app.request.attributes.get('_route') ?? '') starts with 'dashboard_client_' ? client : null %}
{% set nav = navigation(nav_client, section ?? '') %}
{% set platform = app.user.platformUser %}
{% set ds = platform and is_granted('PLATFORM.SYSTEM.VIEW') ? delivery_status() : null %}
<header class="topbar">
    <a class="brand" href="{{ path('dashboard_home') }}">{{ icon.logo(34) }}<span>{{ site_name() }}</span></a>
    {# The menu bar (owner decision, 2026-10-25): areas open their pages on hover or focus, pages open their views. #}
    {% if nav.menus is not empty %}
    <nav class="menubar" aria-label="Main" data-controller="navbar">
        <button type="button" class="menubar-toggle" aria-expanded="false" aria-controls="main-menu" data-navbar-target="toggle" data-action="navbar#toggle">{{ icon.i('menu', 20) }}Menu</button>
        <ul class="menubar-list" id="main-menu">
            {% for m in nav.menus %}
            <li class="menubar-item{{ loop.revindex <= 2 ? ' menubar-item-end' : '' }}">
                <a class="menubar-link" href="{{ m.href }}"{% if m.current %} aria-current="true"{% endif %}>{{ icon.i(m.icon, 18) }}<span class="menubar-label">{{ m.label }}</span>{% if m.badge %}<span class="count count-{{ m.badge[1] }}" aria-hidden="true">{{ m.badge[0] }}</span><span class="sr">, {{ m.badge[0] }} to look at</span>{% endif %}{{ icon.i('chevron-down', 14) }}</a>
                <ul class="menu-panel">
                    {% for p in m.items %}
                    <li class="menu-item{{ p.views is not empty ? ' has-views' : '' }}">
                        <a href="{{ p.href }}"{% if p.current %} aria-current="page"{% endif %}>{{ icon.i(p.icon, 16) }}<span class="menu-label">{{ p.label }}</span>{% if p.note %}<span class="menu-note">{{ p.note }}</span>{% endif %}{% if p.badge %}<span class="count count-{{ p.badge[1] }}" aria-hidden="true">{{ p.badge[0] }}</span><span class="sr">, {{ p.badge[0] }} to look at</span>{% endif %}{% if p.views is not empty %}{{ icon.i('chevron', 14) }}{% endif %}</a>
                        {% if p.views is not empty %}
                        <ul class="menu-flyout">
                            {% for v in p.views %}
                            {% if v.header %}<li class="menu-head">{{ v.label }}</li>{% else %}
                            <li><a href="{{ v.href }}">{% if v.icon %}{{ icon.i(v.icon, 16, v.state ? 'menu-state-' ~ v.state : '') }}{% endif %}<span class="menu-label">{{ v.label }}</span>{% if v.note %}<span class="menu-note">{{ v.note }}</span>{% endif %}</a></li>
                            {% endif %}
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </li>
                    {% endfor %}
                </ul>
            </li>
            {% endfor %}
        </ul>
    </nav>
    {% endif %}
    <div class="topright">
        {% set search_action = nav.context == 'client' ? path('dashboard_client_search', {clientId: nav_client.id.toRfc4122}) : (platform ? path('dashboard_search') : null) %}
        {% if search_action %}
            <details class="dropdown searchdrop" data-controller="dropdown">
                <summary class="iconbtn" aria-label="Search{{ nav.context == 'client' ? ' this account' : '' }}">{{ icon.i('search') }}</summary>
                <form class="dropdown-panel topsearch" role="search" method="get" action="{{ search_action }}">
                    <label for="top-search">{{ nav.context == 'client' ? 'Search ' ~ nav_client.companyName : 'Search the installation' }}</label>
                    <span class="topsearch-row"><input id="top-search" type="search" name="q" minlength="2" maxlength="200" placeholder="An ID, address, domain, reference or name"{% if (section ?? '') == 'search' %} value="{{ app.request.query.get('q') }}"{% endif %}><button type="submit">Search</button></span>
                </form>
            </details>
        {% endif %}
        {% if ds %}
            <a class="modepill mode-{{ ds.mode }}" href="{{ path('dashboard_operator_system') }}" title="{{ ds.explanation }}"><span class="dot" aria-hidden="true"></span><span><span class="modepill-word">Delivery </span>{{ ds.mode }}</span></a>
            {% if is_granted('SYSTEM.DELIVERY.CONTROL') and not ds.emergency_stop %}
            <details class="dropdown stopbox" data-controller="dropdown">
                <summary class="btn btn-stop">{{ icon.i('stop', 18) }}Stop sending</summary>
                <form method="post" action="{{ path('dashboard_operator_stop') }}" class="dropdown-panel stack" data-controller="confirm" data-confirm-message-value="Stop sending all email now? Nothing new is submitted and the Postfix queue is held until an administrator resumes.">
                    {{ ui.csrf() }}<input type="hidden" name="return_to" value="{{ app.request.pathInfo starts with '/dashboard/operator/' ? app.request.pathInfo : '' }}">
                    <p><strong>Stop sending all email now?</strong> Nothing new is submitted and the Postfix queue is held until an administrator resumes. Nothing is lost.</p>
                    <label>Reason (kept in the audit log)<input name="note" required minlength="3" maxlength="1000" autocomplete="off"></label>
                    <button type="submit" class="danger">STOP SENDING EMAIL NOW</button>
                </form>
            </details>
            {% endif %}
        {% endif %}
        {% if nav.context == 'client' %}
            <a class="chip" href="{{ nav.switch.href }}" title="{{ nav_client.companyName }}: {{ nav.switch.label|lower }}"><span class="avatar av-{{ nav_client.companyName|tone_slot }}" aria-hidden="true">{{ nav_client.companyName|initials }}</span><span class="chip-name">{{ nav_client.companyName }}</span>{{ icon.i('switch', 16) }}<span class="sr">: {{ nav.switch.label }}</span></a>
        {% endif %}
        <details class="dropdown account" data-controller="dropdown">
            <summary class="avatar-btn" aria-label="Account menu">{{ (app.user.displayName ?? (app.user.email|split('@')|first))|initials }}</summary>
            <div class="dropdown-panel">
                <p class="muted">Signed in as</p>
                <p class="account-name">{{ app.user.displayName ?? app.user.email }}</p>
                {% if app.user.roleKeys is not empty %}<p>{% for r in app.user.roleKeys %}<span class="tag">{{ r|lower }}</span>{% endfor %}</p>{% endif %}
                <form method="post" action="{{ path('dashboard_logout') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="secondary">{{ icon.i('box-arrow-right', 16) }}Sign out</button>
                </form>
            </div>
        </details>
    </div>
</header>
<main id="main" class="content">
    {# Where this page is, on a detail page only (owner decision 2026-10-27: a list page's title says it once): area › page › the item
       it shows (block crumb_tail, rendered by Twig and so already escaped). The menu bar marks the area of every page. #}
    {% set crumb_tail = block('crumb_tail') is defined ? block('crumb_tail')|trim : '' %}
    {% if nav.crumbs is not empty and crumb_tail is not empty %}
    <nav class="crumbs" aria-label="Breadcrumb">{% for c in nav.crumbs %}{% if not loop.first %}<span aria-hidden="true"> › </span>{% endif %}{% if c.href and (not loop.last or crumb_tail is not empty) %}<a href="{{ c.href }}">{{ c.label }}</a>{% else %}<span{% if loop.last %} aria-current="page"{% endif %}>{{ c.label }}</span>{% endif %}{% endfor %}{% if crumb_tail is not empty %}<span aria-hidden="true"> › </span><span class="crumb-tail">{{ crumb_tail|raw }}</span>{% endif %}</nav>
    {% endif %}
    {% if nav.context == 'client' and platform %}
        <p class="viewing">You are viewing the account of <strong>{{ nav_client.companyName }}</strong> as an operator. <a href="{{ nav.switch.href }}">Back to the operator console</a></p>
    {% endif %}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <p class="flash flash-{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}"><strong>{{ type == 'error' ? 'Error' : (type == 'success' ? 'Done' : 'Note') }}:</strong> {{ message }}</p>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
{{ site.footer() }}
{% else %}
<header class="topbar topbar-bare">
    <span class="brand">{{ icon.logo() }}<span>{{ site_name() }}</span></span>
</header>
<main id="main" class="content content-bare">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <p class="flash flash-{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}"><strong>{{ type == 'error' ? 'Error' : (type == 'success' ? 'Done' : 'Note') }}:</strong> {{ message }}</p>
        {% endfor %}
    {% endfor %}
    {% block body_bare %}{{ block('body') }}{% endblock %}
</main>
{{ site.footer() }}
{% endif %}
</body>
</html>
