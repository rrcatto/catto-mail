{% import 'dashboard/_macros.html.twig' as ui %}{% import 'dashboard/_icons.html.twig' as icon %}<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="same-origin">
    <title>{% block title %}Dashboard{% endblock %} · Catto Mail</title>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {{ importmap('app', {nonce: csp_nonce()}) }}
</head>
<body{% if not app.user %} class="bare"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
{% if app.user %}
{# The client workspace navigation only on client pages (some operator pages also pass a client). #}
{% set nav_client = client is defined and client and (app.request.attributes.get('_route') ?? '') starts with 'dashboard_client_' ? client : null %}
{% set nav = navigation(nav_client, section ?? '') %}
{% set platform = app.user.platformUser %}
{% set ds = platform and is_granted('PLATFORM.SYSTEM.VIEW') ? delivery_status() : null %}
<header class="topbar">
    <a class="brand" href="{{ path('dashboard_home') }}">{{ icon.logo() }}<span>Catto Mail</span></a>
    {% block pills %}
        {% if nav.pills|length > 0 %}
        <nav class="pills" aria-label="Pages in this area">
            {% for p in nav.pills %}<a class="pill" href="{{ p.href }}"{% if p.current %} aria-current="page"{% endif %}>{{ p.label }}{% if p.badge %} <span class="count count-{{ p.badge[1] }}">{{ p.badge[0] }}</span>{% endif %}</a>{% endfor %}
        </nav>
        {% endif %}
    {% endblock %}
    <div class="topright">
        {% set search_action = nav.context == 'client' ? path('dashboard_client_search', {clientId: nav_client.id.toRfc4122}) : (platform ? path('dashboard_search') : null) %}
        {% if search_action %}
            <details class="dropdown searchdrop" data-controller="dropdown">
                <summary class="iconbtn" aria-label="Search{{ nav.context == 'client' ? ' this client' : '' }}">{{ icon.i('search') }}</summary>
                <form class="dropdown-panel topsearch" role="search" method="get" action="{{ search_action }}">
                    <label for="top-search">{{ nav.context == 'client' ? 'Search ' ~ nav_client.companyName : 'Search the installation' }}</label>
                    <span class="topsearch-row"><input id="top-search" type="search" name="q" minlength="2" maxlength="200" placeholder="An ID, address, domain, reference or name"{% if (section ?? '') == 'search' %} value="{{ app.request.query.get('q') }}"{% endif %}><button type="submit">Search</button></span>
                </form>
            </details>
        {% endif %}
        {% if ds %}
            <a class="modepill mode-{{ ds.mode }}" href="{{ path('dashboard_operator_system') }}" title="{{ ds.explanation }}"><span class="dot" aria-hidden="true"></span>Delivery: {{ ds.mode }}</a>
            {% if is_granted('SYSTEM.DELIVERY.CONTROL') and not ds.emergency_stop %}
            <details class="dropdown stopbox" data-controller="dropdown">
                <summary class="btn btn-danger">{{ icon.i('stop', 18) }}Stop sending</summary>
                <form method="post" action="{{ path('dashboard_operator_stop') }}" class="dropdown-panel stack" data-controller="confirm" data-confirm-message-value="Stop sending all email now? Nothing new is submitted and the Postfix queue is held until an administrator resumes.">
                    {{ ui.csrf() }}<input type="hidden" name="return_to" value="{{ app.request.pathInfo starts with '/dashboard/operator/' ? app.request.pathInfo : '' }}">
                    <p><strong>Stop sending all email now?</strong> Nothing new is submitted and the Postfix queue is held until an administrator resumes. Nothing is lost.</p>
                    <label>Reason (kept in the audit log)<input name="note" required minlength="3" maxlength="1000" autocomplete="off"></label>
                    <button type="submit" class="danger">STOP SENDING EMAIL NOW</button>
                </form>
            </details>
            {% endif %}
        {% endif %}
        {% if nav.context == 'client' %}
            <a class="chip" href="{{ nav.switch.href }}" title="{{ nav.switch.label }}"><span class="avatar av-{{ nav_client.companyName|tone_slot }}" aria-hidden="true">{{ nav_client.companyName|initials }}</span>{{ nav_client.companyName }}{{ icon.i('switch', 16) }}<span class="sr">: {{ nav.switch.label }}</span></a>
        {% endif %}
        {% if platform and is_granted('PLATFORM.OVERVIEW.VIEW') %}
            <a class="iconbtn" href="{{ path('dashboard_operator_overview') }}#attention" aria-label="Needs attention: {{ nav.attention }}">{{ icon.i('bell') }}{% if nav.attention > 0 %}<span class="iconbtn-dot" aria-hidden="true"></span>{% endif %}</a>
        {% endif %}
        <details class="dropdown account" data-controller="dropdown">
            <summary class="avatar-btn" aria-label="Account menu">{{ (app.user.displayName ?? (app.user.email|split('@')|first))|initials }}</summary>
            <div class="dropdown-panel">
                <p class="muted">Signed in as</p>
                <p class="account-name">{{ app.user.displayName ?? app.user.email }}</p>
                {% if app.user.roleKeys is not empty %}<p>{% for r in app.user.roleKeys %}<span class="tag">{{ r|lower }}</span>{% endfor %}</p>{% endif %}
                <form method="post" action="{{ path('dashboard_logout') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="secondary">Sign out</button>
                </form>
            </div>
        </details>
    </div>
</header>
<div class="shell">
    {% if nav.areas is not empty or nav.help or nav.switch %}
    <nav class="orbs" aria-label="Main">
        <ul>
            {% for a in nav.areas %}
            <li><a class="orb" href="{{ a.href }}"{% if a.current %} aria-current="page"{% endif %}>{{ icon.i(a.icon, 24) }}<span class="orb-label">{{ a.label }}</span>{% if a.badge %}<span class="orb-badge count-{{ a.badge[1] }}" aria-hidden="true">{{ a.badge[0] }}</span><span class="sr">, {{ a.badge[0] }} to look at</span>{% endif %}</a></li>
            {% endfor %}
        </ul>
        <ul class="orbs-end">
            {% if nav.help %}<li><a class="orb" href="{{ nav.help }}"{% if (section ?? '') == 'help' %} aria-current="page"{% endif %}>{{ icon.i('help', 24) }}<span class="orb-label">Help</span></a></li>{% endif %}
            {% if nav.switch %}<li><a class="orb" href="{{ nav.switch.href }}">{{ icon.i('switch', 24) }}<span class="orb-label">{{ nav.switch.label }}</span></a></li>{% endif %}
        </ul>
    </nav>
    {% endif %}
    <main id="main" class="content">
        {% if nav.context == 'client' and platform %}
            <p class="viewing">You are viewing the workspace of <strong>{{ nav_client.companyName }}</strong> as an operator. <a href="{{ nav.switch.href }}">Back to the operator console</a></p>
        {% endif %}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p class="flash flash-{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}"><strong>{{ type == 'error' ? 'Error' : (type == 'success' ? 'Done' : 'Note') }}:</strong> {{ message }}</p>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
        <footer class="foot">catto-mail v{{ app_version() }} · Times are shown in {{ time_zone_label() }}</footer>
    </main>
</div>
{% else %}
<header class="topbar topbar-bare">
    <span class="brand">{{ icon.logo() }}<span>Catto Mail</span></span>
</header>
<main id="main" class="content content-bare">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <p class="flash flash-{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}"><strong>{{ type == 'error' ? 'Error' : (type == 'success' ? 'Done' : 'Note') }}:</strong> {{ message }}</p>
        {% endfor %}
    {% endfor %}
    {% block body_bare %}{{ block('body') }}{% endblock %}
</main>
{% endif %}
</body>
</html>
