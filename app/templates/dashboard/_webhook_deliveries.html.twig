{# Webhook deliveries table (operator Mail flow › Webhooks and the client's Settings › Webhooks). Variables: rows, show_client.
   The response, error, ids and times are behind ⓘ on each row. #}
{% import 'dashboard/_macros.html.twig' as ui %}
{% if rows is empty %}<p class="empty">No deliveries match.</p>{% else %}
<div class="scroll">
<table class="list">
    <thead><tr><th scope="col">When</th>{% if show_client %}<th scope="col">Client</th>{% endif %}<th scope="col">Event</th><th scope="col">Endpoint</th><th scope="col">State</th><th scope="col" class="num">Attempts</th><th scope="col"><span class="sr">Details</span></th></tr></thead>
    <tbody>{% for d in rows %}
        {% set state = d.status == 'pending' and d.attempt_count > 0 ? 'retrying' : d.status %}
        <tr><td class="nowrap" title="{{ d.created_at|ts }}">{{ d.created_at|when }}</td>{% if show_client %}<td>{{ d.company_name }}</td>{% endif %}
            <td><code>{{ d.event_type }}</code></td>
            <td class="url">{{ d.url }}</td>
            <td><span class="st st-{{ state == 'delivered' ? 'completed' : (state == 'failed' ? 'failed' : 'deferred') }}">{{ state|capitalize }}</span></td>
            <td class="num">{{ d.attempt_count }}</td>
            <td class="tipcell">{{ ui.tip('Last response: ' ~ (d.last_response_status ?? '—') ~ (d.last_error ? ' · ' ~ d.last_error : '') ~ ' · next attempt ' ~ (d.next_attempt_at|ts) ~ ' · delivered ' ~ (d.delivered_at|ts) ~ ' · event ' ~ d.event_id) }}</td></tr>
    {% endfor %}</tbody>
</table>
</div>
{% endif %}
