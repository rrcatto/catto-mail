{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Webhooks{% endblock %}
{% block body %}
{% set cid = client.id.toRfc4122 %}
{% set failing = endpoints|filter(e => e.failures_since_success > 0) %}
<div class="pagehead">
    <div>
        <h1>Webhooks</h1>
        <p class="lead">Where your application is told what happened to its jobs and messages.{% if failing is not empty %} <strong class="text-bad">{{ failing|length }} endpoint{{ failing|length == 1 ? ' is' : 's are' }} failing.</strong>{% endif %}{{ ui.tip('Signed HTTPS POST requests when your validation jobs, send jobs and messages change state. Each carries a Smarthost-Signature (HMAC-SHA256 over <t>.<body> with the endpoint\'s signing secret) and a Smarthost-Event-Id. Delivery is at-least-once: de-duplicate on the event id. Failed requests are retried with backoff; endpoints are never disabled automatically.') }}</p>
    </div>
    {% if may_manage %}<div class="actions"><a class="btn" href="{{ path('dashboard_client_webhook_new', {clientId: cid}) }}">Add an endpoint</a></div>{% endif %}
</div>

<section class="card card-flush" aria-labelledby="ep-h">
    <div class="card-head"><h2 id="ep-h">Endpoints</h2></div>
    {% if endpoints is empty %}<p class="empty">No webhook endpoints yet.</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">URL</th><th scope="col">Status</th><th scope="col" class="num">Delivered (7 d)</th><th scope="col" class="num">Failed (7 d)</th><th scope="col">Last success</th><th scope="col"><span class="sr">Details</span></th>{% if may_manage %}<th scope="col"><span class="sr">Actions</span></th>{% endif %}</tr></thead>
        <tbody>{% for e in endpoints %}<tr>
            <td class="url">{{ e.url }}{% if e.failures_since_success > 0 %}<br><strong class="text-bad small">{{ e.failures_since_success }} failed since the last success</strong>{% endif %}</td>
            <td><span class="st st-{{ e.status == 'enabled' ? 'active' : 'disabled' }}">{{ e.status|capitalize }}</span></td>
            <td class="num">{{ e.delivered }}</td><td class="num">{{ e.failed }}</td><td>{{ e.last_delivered_at ? e.last_delivered_at|when : 'never' }}</td>
            <td class="tipcell">{{ ui.tip('Events: ' ~ (e.subscribed_event_types|json_counts|join(', ')) ~ ' · ' ~ e.pending ~ ' pending or retrying · signing secret created ' ~ (e.signing_secret_created_at|ts) ~ (e.rotation_overlap ? ' (the previous secret still signs until ' ~ (e.previous_signing_secret_expires_at|ts) ~ ')' : '')) }}</td>
            {% if may_manage %}<td><details class="actionform rowaction"><summary class="btn btn-secondary">Actions</summary><div class="stack">
                <form method="post" action="{{ path('dashboard_client_webhook_test', {clientId: cid, id: e.id}) }}">{{ ui.csrf() }}<button type="submit" class="secondary">Send test event</button></form>
                <form method="post" action="{{ path('dashboard_client_webhook_rotate', {clientId: cid, id: e.id}) }}" data-controller="confirm" data-confirm-message-value="Rotate the signing secret? The new secret is shown once; the old one keeps signing during the overlap period.">{{ ui.csrf() }}<button type="submit" class="secondary">Rotate signing secret</button></form>
                <form method="post" action="{{ path('dashboard_client_webhook_update', {clientId: cid, id: e.id}) }}" class="stack">
                    {{ ui.csrf() }}
                    <label>URL <input type="url" name="url" value="{{ e.url }}" required maxlength="2000"></label>
                    <fieldset class="perms"><legend>Events</legend>
                        {% for t in event_types %}<label class="checkline"><input type="checkbox" name="event_types[]" value="{{ t }}"{% if t in e.subscribed_event_types|json_counts %} checked{% endif %}> <code>{{ t }}</code></label>{% endfor %}
                    </fieldset>
                    <label>Status <select name="status"><option value="enabled"{% if e.status == 'enabled' %} selected{% endif %}>Enabled</option><option value="disabled"{% if e.status == 'disabled' %} selected{% endif %}>Disabled</option></select></label>
                    <button type="submit">Save</button>
                </form>
            </div></details></td>{% endif %}
        </tr>{% endfor %}</tbody>
    </table></div>
    {% endif %}
</section>

<div class="sectionhead"><h2 id="deliveries">Deliveries</h2></div>
<nav class="chips" aria-label="Views of the deliveries">
    {% for key, label in {failed: 'Failed', retrying: 'Retrying', pending: 'Pending', delivered: 'Delivered', '': 'Every delivery'} %}<a class="chip-link" href="{{ path('dashboard_client_webhooks', (key ? {clientId: cid, status: key} : {clientId: cid})|merge(filters.endpoint ? {endpoint: filters.endpoint} : {})) }}#deliveries"{% if filters.status == key %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
</nav>
{% if endpoints|length > 1 %}
<details class="morefilters"{% if filters.endpoint %} open{% endif %}>
    <summary>More filters: endpoint</summary>
    <form method="get" class="filters" role="search" aria-label="Filter deliveries" action="#deliveries">
        <input type="hidden" name="status" value="{{ filters.status }}">
        <label>Endpoint <select name="endpoint"><option value="">All</option>{% for e in endpoints %}<option value="{{ e.id }}"{% if filters.endpoint == e.id %} selected{% endif %}>{{ e.url }}</option>{% endfor %}</select></label>
        <button type="submit">Apply</button>
    </form>
</details>
{% endif %}
<section class="card card-flush" aria-labelledby="deliveries">
    {% include 'dashboard/_webhook_deliveries.html.twig' with {rows: deliveries.rows, show_client: false} %}
</section>
{{ ui.pager(deliveries, 'deliveries') }}
{% endblock %}
