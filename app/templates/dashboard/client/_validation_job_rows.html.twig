{# Validation job rows (the job list, inside a card-flush card). Variables: rows, listing (or null). #}
{% import 'dashboard/_macros.html.twig' as ui %}
{% if rows is empty %}<p class="empty">No validation jobs match.</p>{% else %}
<div class="scroll">
<table class="list">
    <thead><tr>
        <th scope="col">{% if listing %}{{ ui.sort(listing, 'submitted', 'Submitted') }}{% else %}Submitted{% endif %}</th>
        <th scope="col">Reference</th>
        <th scope="col" class="num">{% if listing %}{{ ui.sort(listing, 'total', 'Addresses') }}{% else %}Addresses{% endif %}</th>
        <th scope="col">Status</th>
        <th scope="col">Result</th>
    </tr></thead>
    <tbody>
    {% for j in rows %}
        {% set c = j.classification_counts_json|json_counts %}
        {% set ok = (c.deliverable ?? 0) + (c.probably_deliverable ?? 0) %}
        {% set mid = (c.risky ?? 0) + (c.unknown ?? 0) + (c.temporarily_unverifiable ?? 0) %}
        {% set bad = c.undeliverable ?? 0 %}
        <tr>
            <td class="nowrap"><a href="{{ path('dashboard_client_validation_job', {clientId: client.id.toRfc4122, jobId: j.id}) }}" title="{{ j.submitted_at|ts }}">{{ j.submitted_at|when }}</a></td>
            <td>{{ j.external_reference ?? '—' }}</td>
            <td class="num">{{ j.total_addresses|number_format }}{% if j.processed_count < j.total_addresses %} <span class="muted small">({{ j.processed_count|number_format }} checked)</span>{% endif %}</td>
            <td>{{ ui.status(j.status, 'validation_job_status') }}</td>
            <td>{% set parts = [] %}{% if ok %}{% set parts = parts|merge([ok|number_format ~ ' deliverable']) %}{% endif %}{% if mid %}{% set parts = parts|merge([mid|number_format ~ ' risky or unknown']) %}{% endif %}{% if bad %}{% set parts = parts|merge([bad|number_format ~ ' undeliverable']) %}{% endif %}{{ parts is empty ? '—' : parts|join(' · ') }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% endif %}
