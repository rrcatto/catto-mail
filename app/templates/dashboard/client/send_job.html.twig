{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Send job{% endblock %}
{% block crumb_tail %}Job{% endblock %}
{% block body %}
{% set cid = client.id.toRfc4122 %}
{% set s = job.summary_counts_json|json_counts %}
{% set e = job.engagement %}
{% set acc = s.remote_accepted ?? 0 %}
{% set fly = (s.created ?? 0) + (s.queued ?? 0) + (s.submitted ?? 0) + (s.deferred ?? 0) + (s.outcome_unknown ?? 0) %}
{% set bad = (s.soft_bounced ?? 0) + (s.hard_bounced ?? 0) + (s.complained ?? 0) + (s.failed ?? 0) %}
{% set sup = s.suppressed ?? 0 %}
<div class="pagehead">
    <div>
        <div class="titleline"><h1>Send job “{{ job.external_reference }}”</h1>{{ ui.status(job.status, 'send_job_status') }}</div>
        <p class="lead">{{ job.total_recipients|number_format }} recipients · {{ job.message_class }} · from {{ job.sender_email }} · created {{ job.created_at|when }}.</p>
    </div>
</div>

<div class="kpis">
    <section class="card kpi"><div class="kpi-head"><h2>Remote accepted</h2>{{ ui.tip('The receiving server accepted responsibility; it is not proof of inbox delivery.') }}</div><p class="kpi-value">{{ acc|number_format }}</p><p class="kpi-delta muted">{{ acc|percent(job.total_recipients) }} of the recipients</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>In flight</h2>{{ ui.tip('Created, queued, submitted to Postfix, deferred or outcome unknown. Outcome unknown is not a success.') }}</div><p class="kpi-value">{{ fly|number_format }}</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Bounced or failed</h2>{{ ui.tip('Soft and hard bounces, complaints and failures.') }}</div><p class="kpi-value{{ bad ? ' text-bad' : '' }}">{{ bad|number_format }}</p>{% if sup %}<p class="kpi-delta muted">{{ sup|number_format }} suppressed (not sent)</p>{% endif %}</section>
    <section class="card kpi"><div class="kpi-head"><h2>Recorded opens</h2>{% include 'dashboard/_engagement_tip.html.twig' %}</div><p class="kpi-value">{{ (job.track_opens ? e.opened_messages : '—')|number_format }}</p><p class="kpi-delta muted">{{ job.track_clicks ? e.clicked_messages|number_format ~ ' with a recorded click' : 'click tracking off' }}</p></section>
</div>

<form method="get" class="searchline" role="search" aria-label="Find a recipient">
    <label class="sr" for="rcpt-q">Recipient (exact)</label>
    <input id="rcpt-q" type="search" name="recipient" value="{{ filters.recipient }}" placeholder="Find a recipient (exact address)" autocomplete="off">
    <input type="hidden" name="status" value="{{ filters.status }}">
    <button type="submit">Find</button>
</form>
<nav class="chips" aria-label="Views of the messages">
    {% for key, label in {'': 'Every message', remote_accepted: 'Accepted', deferred: 'Deferred', hard_bounced: 'Hard bounced', soft_bounced: 'Soft bounced', complained: 'Complained', suppressed: 'Suppressed', outcome_unknown: 'Outcome unknown'} %}<a class="chip-link" href="{{ path('dashboard_client_send_job', key ? {clientId: cid, jobId: job.id, status: key} : {clientId: cid, jobId: job.id}) }}"{% if not filters.recipient and filters.status == key %} aria-current="page"{% endif %}>{{ label }}{% if key and (s[key] ?? 0) %} <span class="muted">{{ s[key]|number_format }}</span>{% endif %}</a>{% endfor %}
</nav>
<section class="card card-flush" aria-labelledby="msg-h">
    <div class="card-head"><h2 id="msg-h">Messages</h2></div>
    {% if page.rows is empty %}<p class="empty">No messages match.</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr>
            <th scope="col">{{ ui.sort(listing, 'recipient', 'Recipient') }}</th>
            <th scope="col">{{ ui.sort(listing, 'status', 'Status') }}</th>
            <th scope="col">Submitted</th>
            <th scope="col" class="num">Opens</th>
            <th scope="col" class="num">Clicks</th>
            <th scope="col"><span class="sr">Details</span></th>
        </tr></thead>
        <tbody>
        {% for m in page.rows %}
            <tr>
                <td><a href="{{ path('dashboard_client_message', {clientId: cid, messageId: m.id}) }}">{{ m.recipient_address }}</a></td>
                <td>{{ ui.status(m.current_status, 'message_status') }}</td>
                <td>{{ m.submitted_at ? m.submitted_at|when : '—' }}</td>
                <td class="num">{{ m.opens }}</td>
                <td class="num">{{ m.clicks }}</td>
                <td class="tipcell">{{ ui.tip('Reference ' ~ (m.external_recipient_reference ?: '—') ~ ' · Postfix queue id ' ~ (m.postfix_queue_id ?? '—') ~ ' · created ' ~ (m.created_at|ts) ~ ' · resolved ' ~ (m.resolved_at|ts) ~ ' · ' ~ m.events ~ ' events') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table></div>
    {% endif %}
</section>
{{ ui.pager(page, 'messages') }}

<details class="morefilters">
    <summary>Everything about this job</summary>
    <div class="grid">
        <section class="card g-col-4 lg:g-col-2" aria-labelledby="job-h">
            <h2 id="job-h">Job</h2>
            <dl class="rows">
                <dt>Job id</dt><dd><code>{{ job.id }}</code></dd>
                <dt>Sender</dt><dd>{{ job.sender_name ? job.sender_name ~ ' ' : '' }}&lt;{{ job.sender_email }}&gt; via {{ job.sending_domain }}</dd>
                {% if job.reply_to_email %}<dt>Reply-To</dt><dd>{{ job.reply_to_email }}</dd>{% endif %}
                <dt>Class</dt><dd>{{ job.message_class|capitalize }}{% if job.list_id %} (List-Id {{ job.list_id }}){% endif %}</dd>
                <dt>Tracking</dt><dd>Opens {{ job.track_opens ? 'on' : 'off' }}, clicks {{ job.track_clicks ? 'on' : 'off' }}</dd>
                <dt>Queued</dt><dd>{{ job.queued_at|ts }}</dd>
                <dt>Started</dt><dd>{{ job.started_at|ts }}</dd>
                <dt>Dispatched to Postfix</dt><dd>{{ job.dispatch_completed_at|ts }}</dd>
                <dt>Completed</dt><dd>{{ job.completed_at|ts }}</dd>
            </dl>
        </section>
        <section class="card g-col-4 lg:g-col-2" aria-labelledby="out-h">
            <h2 id="out-h">Messages by status</h2>
            <table class="kv"><tbody>
                {% for key in ['submitted', 'remote_accepted', 'deferred', 'soft_bounced', 'hard_bounced', 'complained', 'suppressed', 'outcome_unknown', 'failed', 'queued', 'created'] %}
                <tr><th scope="row">{{ key|label('message_status') }}</th><td class="num">{{ (s[key] ?? 0)|number_format }}</td><td class="num muted">{{ (s[key] ?? 0)|percent(job.total_recipients) }}</td></tr>
                {% endfor %}
            </tbody></table>
            <dl class="rows">
                <dt>Recorded open events</dt><dd>{{ e.open_events|number_format }} ({{ e.first_open|ts }} – {{ e.last_open|ts }})</dd>
                <dt>Recorded click events</dt><dd>{{ e.click_events|number_format }} ({{ e.first_click|ts }} – {{ e.last_click|ts }})</dd>
            </dl>
        </section>
        {% if e.links is not empty %}
        <section class="card card-flush g-col-4" aria-labelledby="links-h">
            <div class="card-head"><h2 id="links-h">Recorded clicks by link</h2></div>
            <div class="scroll"><table class="list">
                <thead><tr><th scope="col" class="num">Link</th><th scope="col">Target</th><th scope="col" class="num">Click events</th><th scope="col" class="num">Messages</th></tr></thead>
                <tbody>{% for l in e.links %}
                    <tr><td class="num">{{ l.link_index }}</td><td class="url">{{ l.target_url ?? '—' }}{% if l.targets > 1 %} <small>(differs between messages)</small>{% endif %}</td><td class="num">{{ l.clicks|number_format }}</td><td class="num">{{ l.messages|number_format }}</td></tr>
                {% endfor %}</tbody>
            </table></div>
        </section>
        {% endif %}
    </div>
</details>
{% endblock %}
