{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% import 'dashboard/_icons.html.twig' as icon %}
{% block title %}{{ client.companyName }} – Overview{% endblock %}
{% block body %}
{% set cid = client.id.toRfc4122 %}
{% set near = limits.quotas|filter(q => q.limit and q.used >= 0.75 * q.limit) %}
<div class="pagehead">
    <div>
        <div class="titleline"><h1>{{ client.companyName }}</h1>{{ ui.status(client.status.value, 'client_status') }}</div>
        <p class="lead">{{ client.approvedAt ? 'Open since ' ~ client.approvedAt|date('j M Y', time_zone()) ~ '.' : 'Not open yet.' }}
            {% if near is empty %}Within every limit.{% else %}<span class="text-warn">Close to a limit: {% for q in near %}{{ q.metric|label('quota_metric')|lower }} {{ q.period|label('quota_period')|lower }} ({{ q.used|number_format }} of {{ q.limit|number_format }}){% if not loop.last %}, {% endif %}{% endfor %}.</span> <a href="{{ path('dashboard_client_usage', {clientId: cid}) }}">Usage &amp; limits</a>{% endif %}
            The last {{ period.label }}.</p>
    </div>
    <div class="actions">
        <nav class="seg" aria-label="Period">{% for key, label in periods %}<a href="{{ path('dashboard_client_overview', {clientId: cid, period: key}) }}"{% if key == period.key %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</nav>
        <a class="btn btn-secondary" href="{{ path('docs_api') }}">API reference</a>
    </div>
</div>

{% if client.status.value != 'active' and not (client.status.value == 'pending_approval' and client.opensOnPolicyAcceptance) %}
<section class="banner banner-client-{{ client.status.value }}" aria-label="Account status">
    <div class="banner-text"><h2>{{ client.status.value|label('client_status') }}</h2><p>{{ client.status.value|label('client_status_meaning') }}</p></div>
</section>
{% endif %}

{% if not steps.done %}
{# The account's start page (owner decision 2026-10-27): the steps to the first message, one at a time. #}
{% set order = (steps.policy is null ? [] : ['policy'])|merge(['domain', 'connected', 'sent']) %}
{% set current = order|filter(k => not steps[k])|first %}
{% set done = order|filter(k => steps[k])|length %}
<section class="card guide-card" aria-labelledby="start-h">
    <div class="card-head"><h2 id="start-h">Get ready to send</h2><span class="muted">{{ done }} of {{ order|length }} done</span></div>
    {% if not may_admin %}<p class="muted small">An admin of this account takes these steps; you can follow them here.</p>{% endif %}
    <ol class="checklist">
        {% if steps.policy is not null %}
        <li class="{{ steps.policy ? 'done' : (current == 'policy' ? 'current') }}"><div class="checklist-text">
            <span class="checklist-title">Accept the service policy</span>
            {% if steps.policy %}<p>Accepted.</p>{% else %}
            <p>The rules for what may be sent through {{ site_name() }}: <a href="{{ path('acceptable_use_policy') }}" target="_blank" rel="noopener">read the service policy</a> (version {{ policy.version_in_force }}).{% if client.status.value == 'pending_approval' %} Your account opens when you accept it.{% endif %}</p>
            {% if may_admin %}
            <form method="post" action="{{ path('dashboard_client_policy_accept', {clientId: cid}) }}" class="stack">
                {{ ui.csrf() }}<input type="hidden" name="policy_version" value="{{ policy.version_in_force }}">
                <label class="checkline"><input type="checkbox" required> I accept the service policy version {{ policy.version_in_force }} on behalf of {{ client.companyName }}.</label>
                <button type="submit">Accept the policy</button>
            </form>
            {% endif %}{% endif %}
        </div></li>
        {% endif %}
        <li class="{{ steps.domain ? 'done' : (current == 'domain' ? 'current') }}"><div class="checklist-text">
            <span class="checklist-title">Make your sending domain ready</span>
            {% if steps.domain %}<p>Ready: your messages can be sent from it.</p>{% else %}
            <p>Your messages come from your own domain, the part after @ in your From address. You add two records to its DNS, one to prove it is yours and one with its signing key, and this page checks them for you.</p>
            {% if current == 'domain' and may_admin %}<p class="form-actions">{% if steps.domain_next %}<a class="btn" href="{{ path('dashboard_client_domain', {clientId: cid, domainId: steps.domain_next.id}) }}">Continue with {{ steps.domain_next.domain }}</a>{% else %}<a class="btn" href="{{ path('dashboard_client_domain_new', {clientId: cid}) }}">Add your domain</a>{% endif %}</p>{% endif %}
            {% endif %}
        </div></li>
        <li class="{{ steps.connected ? 'done' : (current == 'connected' ? 'current') }}"><div class="checklist-text">
            <span class="checklist-title">Connect your application</span>
            {% if steps.connected %}<p>Connected.{% if not steps.by_hand %} <a href="{{ path('dashboard_client_connections', {clientId: cid}) }}">Connected applications</a>{% endif %}</p>{% else %}
            <p>Open the application that sends your mail, for example your mailing-list site, and choose Connect there. It brings you back here to approve; it then gets its own key and is told what happens to its mail. Nothing to copy.</p>
            <details class="figures"><summary>For developers: connect by hand instead</summary>
                <p>Make an <a href="{{ path('dashboard_client_api_keys', {clientId: cid}) }}">API key</a> and a <a href="{{ path('dashboard_client_webhooks', {clientId: cid}) }}">webhook</a> for your own code; the <a href="{{ path('docs_api') }}">API documentation</a> explains both.</p>
            </details>
            {% endif %}
        </div></li>
        <li class="{{ steps.sent ? 'done' : (current == 'sent' ? 'current') }}"><div class="checklist-text">
            <span class="checklist-title">Send a test message</span>
            {% if steps.sent %}<p>Sent: see <a href="{{ path('dashboard_client_send_jobs', {clientId: cid}) }}">Sending</a>.</p>{% else %}
            <p>From your application, send a test message to yourself. It appears here under Sending, with what happened to it.</p>
            {% endif %}
        </div></li>
    </ol>
</section>
{% endif %}

{% include 'dashboard/_kpis.html.twig' %}

<div class="grid">
    <section class="card g-col-4 xl:g-col-3" aria-labelledby="rs-h">
        <div class="card-head"><h2 id="rs-h">Latest send jobs</h2><a class="more" href="{{ path('dashboard_client_send_jobs', {clientId: cid}) }}">All send jobs</a></div>
        {% if o.recent_send_jobs is empty %}<p class="empty">No send jobs yet.</p>{% else %}
        <div class="scroll"><table class="list">
            <thead><tr><th scope="col">Created</th><th scope="col">Reference</th><th scope="col" class="num">Recipients</th><th scope="col">Result</th></tr></thead>
            <tbody>{% for j in o.recent_send_jobs|slice(0, 5) %}
                {% set c = j.summary_counts_json|json_counts %}
                {% set acc = c.remote_accepted ?? 0 %}
                {% set fly = (c.created ?? 0) + (c.queued ?? 0) + (c.submitted ?? 0) + (c.deferred ?? 0) + (c.outcome_unknown ?? 0) %}
                {% set bad = (c.soft_bounced ?? 0) + (c.hard_bounced ?? 0) + (c.complained ?? 0) + (c.failed ?? 0) %}
                {% set sup = c.suppressed ?? 0 %}
                <tr>
                    <td class="nowrap"><a href="{{ path('dashboard_client_send_job', {clientId: cid, jobId: j.id}) }}" title="{{ j.created_at|ts }}">{{ j.created_at|when }}</a></td>
                    <td>{{ j.external_reference ?: '—' }}</td>
                    <td class="num">{{ j.total_recipients|number_format }}</td>
                    <td>{% if j.status not in ['completed', 'dispatched'] %}{{ ui.status(j.status, 'send_job_status') }} {% endif %}
                        {% if acc + fly + bad + sup == 0 %}<span class="muted">—</span>
                        {% elseif fly + bad + sup == 0 %}<span class="rate-ok">all accepted</span>
                        {% else %}{% set parts = [] %}{% if acc %}{% set parts = parts|merge([acc|number_format ~ ' accepted']) %}{% endif %}{% if fly %}{% set parts = parts|merge([fly|number_format ~ ' in flight']) %}{% endif %}{% if bad %}{% set parts = parts|merge([bad|number_format ~ ' bounced or failed']) %}{% endif %}{% if sup %}{% set parts = parts|merge([sup|number_format ~ ' suppressed']) %}{% endif %}{{ parts|join(' · ') }}{% endif %}</td>
                </tr>
            {% endfor %}</tbody>
        </table></div>
        {% endif %}
    </section>
    <section class="card g-col-4 xl:g-col-1" aria-labelledby="dom-h">
        <div class="card-head"><h2 id="dom-h">Sending domains</h2><a class="more" href="{{ path('dashboard_client_domains', {clientId: cid}) }}">Manage</a></div>
        {% if o.domains is empty %}<p class="empty">No sending domains yet.</p>{% else %}
        <ul class="domainlist">{% for d in o.domains %}
            {% set st = d.status != 'verified' ? (d.status == 'disabled' ? ['Disabled', 'bad', 'The domain is disabled.'] : ['Not verified', 'none', 'Its verification TXT record has not been found yet.'])
                : (d.dkim_status == 'active' ? ['Sending', 'ok', 'Verified, and its DKIM key is active.'] : (d.dkim_status == 'pending_dns' ? ['DKIM record missing', 'warn', 'Verified; its DKIM record is not in DNS yet.'] : ['No DKIM key', 'warn', 'Verified; it has no active DKIM key yet.'])) %}
            <li><span class="domain-name">{{ d.domain }}</span><span class="dstate dstate-{{ st[1] }}" title="{{ st[2] }}">{{ st[0] }}</span></li>
        {% endfor %}</ul>
        {% endif %}
    </section>
</div>
{% endblock %}
