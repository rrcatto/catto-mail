{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Make an API key{% endblock %}
{% block crumb_tail %}Make a key{% endblock %}
{% block body %}
<div class="formpage">
    <h1>Make an API key</h1>
    <p class="lead">For a developer connecting their own code by hand. An application with a Connect button gets its key by itself: you need none here.</p>
    {% if error %}<p class="flash flash-error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="{{ path('dashboard_client_api_key_create', {clientId: client.id.toRfc4122}) }}" class="card">
        {{ ui.csrf() }}
        <label class="field"><span class="field-label">Name <span class="muted">(optional)</span></span>
            <span class="field-help">So you can tell your keys apart, for example "production server".</span>
            <input type="text" name="name" value="{{ name }}" maxlength="100" autocomplete="off" autofocus></label>
        <label class="field"><span class="field-label">Stops working after <span class="muted">(optional)</span></span>
            <span class="field-help">The end of that day, {{ time_zone_abbreviation() }}. Empty: until you revoke it.</span>
            <input type="date" name="expires_on" value="{{ expires_on }}"></label>
        <p class="field-help">The key is shown once, on the next page: copy it into your application's secret settings then.</p>
        <div class="form-actions"><button type="submit">Make the key</button> <a class="btn btn-secondary" href="{{ path('dashboard_client_api_keys', {clientId: client.id.toRfc4122}) }}">Cancel</a></div>
    </form>
</div>
{% endblock %}
