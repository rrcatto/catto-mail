{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Validation job{% endblock %}
{% block crumb_tail %}Job{% endblock %}
{% block body %}
{% set cid = client.id.toRfc4122 %}
{% set c = job.classification_counts_json|json_counts %}
{% set ok = (c.deliverable ?? 0) + (c.probably_deliverable ?? 0) %}
{% set mid = (c.risky ?? 0) + (c.unknown ?? 0) + (c.temporarily_unverifiable ?? 0) %}
{% set bad = c.undeliverable ?? 0 %}
{% set tot = ok + mid + bad %}
{% set waiting = (job.processing.pending ?? 0) + (job.processing.claimed ?? 0) + (job.processing.retry_scheduled ?? 0) %}
<div class="pagehead">
    <div>
        <div class="titleline"><h1>Validation job {{ job.external_reference ? '“' ~ job.external_reference ~ '”' : '' }}</h1>{{ ui.status(job.status, 'validation_job_status') }}</div>
        <p class="lead">{{ job.total_addresses|number_format }} addresses submitted {{ job.submitted_at|when }}{% if job.processed_count < job.total_addresses %}, {{ job.processed_count|number_format }} checked so far{% endif %}.{{ ui.tip('Job ' ~ job.id ~ ' · started ' ~ (job.started_at|ts) ~ ' · completed ' ~ (job.completed_at|ts) ~ '. Validation results estimate deliverability; delivery certainty comes only from sending.') }}</p>
    </div>
    <a class="btn btn-secondary" href="{{ path('dashboard_client_validation_export', {clientId: cid, jobId: job.id}|merge(filters|filter(v => v != ''))) }}" download>Download CSV</a>
</div>

<div class="kpis">
    <section class="card kpi"><div class="kpi-head"><h2>Deliverable</h2>{{ ui.tip('Deliverable or probably deliverable.') }}</div><p class="kpi-value">{{ ok|number_format }}</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Risky or unknown</h2>{{ ui.tip('Risky, unknown or temporarily unverifiable.') }}</div><p class="kpi-value">{{ mid|number_format }}</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Undeliverable</h2></div><p class="kpi-value{{ bad ? ' text-bad' : '' }}">{{ bad|number_format }}</p></section>
    <section class="card kpi"><div class="kpi-head"><h2>Still being checked</h2>{% if job.processing.retry_scheduled ?? 0 %}{{ ui.tip(job.processing.retry_scheduled|number_format ~ ' waiting to retry after a temporary failure.') }}{% endif %}</div><p class="kpi-value">{{ waiting|number_format }}</p></section>
</div>

<section aria-labelledby="addr-h">
    <nav class="chips" aria-label="Views of the addresses">
        {% for key, label in {'': 'Every address'}|merge(label_options('classification')) %}<a class="chip-link" href="{{ path('dashboard_client_validation_job', key ? {clientId: cid, jobId: job.id, classification: key} : {clientId: cid, jobId: job.id}) }}"{% if filters.classification == key %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
    </nav>
    <details class="morefilters"{% if filters.syntax or filters.domain or filters.smtp or filters.confidence or filters.role or filters.disposable or filters.catch_all or filters.typo %} open{% endif %}>
        <summary>More filters: checks, flags, order</summary>
    <form method="get" class="filters" role="search" aria-label="Filter address results">
        {{ ui.select('classification', 'Classification', label_options('classification'), filters.classification) }}
        {{ ui.select('syntax', 'Syntax', {valid: 'Valid', invalid: 'Invalid'}, filters.syntax) }}
        {{ ui.select('domain', 'Domain', {mx: 'MX', null_mx: 'Null MX', address_fallback: 'Address fallback', no_mail_host: 'No mail host', nxdomain: 'NXDOMAIN', temporary_failure: 'Temporary failure', invalid_response: 'Invalid response', skipped: 'Skipped'}, filters.domain) }}
        {{ ui.select('smtp', 'SMTP', {accepted: 'Accepted', rejected: 'Rejected', temporary_failure: 'Temporary failure', blocked: 'Blocked', timeout: 'Timeout', connection_failed: 'Connection failed', inconclusive: 'Inconclusive', skipped: 'Skipped'}, filters.smtp) }}
        {{ ui.select('confidence', 'Confidence', {low: 'Low', medium: 'Medium', high: 'High'}, filters.confidence) }}
        {{ ui.yesno('role', 'Role', filters.role) }}
        {{ ui.yesno('disposable', 'Disposable', filters.disposable) }}
        {{ ui.yesno('catch_all', 'Catch-all', filters.catch_all) }}
        {{ ui.yesno('typo', 'Typo suspected', filters.typo) }}
        <label>Order
            <select name="sort">
                {% for value, text in {input: 'Input order', address: 'Original address', classification: 'Classification'} %}<option value="{{ value }}"{% if listing.sort == value %} selected{% endif %}>{{ text }}</option>{% endfor %}
            </select>
        </label>
        <input type="hidden" name="dir" value="{{ listing.dir }}">
        <button type="submit">Apply</button>
        <a href="{{ path('dashboard_client_validation_job', {clientId: cid, jobId: job.id}) }}">Reset</a>
    </form>
    </details>
    <div class="card card-flush">
        <div class="card-head"><h2 id="addr-h">Addresses</h2></div>
        {% if page.rows is empty %}<p class="empty">No addresses match.</p>{% else %}
        <div class="scroll">
        <table class="list">
            <thead><tr>
                <th scope="col">{{ ui.sort(listing, 'address', 'Address') }}</th>
                <th scope="col">{{ ui.sort(listing, 'classification', 'Result') }}</th>
                <th scope="col">Confidence</th>
                <th scope="col">Suggestion</th>
                <th scope="col"><span class="sr">Details</span></th>
            </tr></thead>
            <tbody>
            {% for a in page.rows %}
                {% set flags = [] %}{% if a.is_role %}{% set flags = flags|merge(['role account']) %}{% endif %}{% if a.is_disposable %}{% set flags = flags|merge(['disposable']) %}{% endif %}{% if a.is_catch_all_or_accept_all %}{% set flags = flags|merge(['catch-all domain']) %}{% endif %}{% if a.is_domain_typo_suspected %}{% set flags = flags|merge(['typo suspected']) %}{% endif %}
                <tr>
                    <td>{{ a.original_address }}{% for f in flags %} <span class="tag tag-warn">{{ f }}</span>{% endfor %}</td>
                    <td>{% if a.overall_classification %}{{ ui.status(a.overall_classification, 'classification') }}{% else %}<span class="st">Not checked yet</span>{% endif %}</td>
                    <td>{{ a.confidence|default('—')|capitalize }}</td>
                    <td>{% if a.suggested_address %}{{ a.suggested_address }} <small class="muted">({{ a.suggestion_confidence }})</small>{% else %}—{% endif %}</td>
                    <td class="tipcell">{{ ui.tip('Normalised ' ~ (a.normalized_address ?? '—') ~ ' · syntax ' ~ (a.syntax_status ?? '—') ~ ' · domain ' ~ (a.domain_status ?? '—') ~ ' · SMTP ' ~ (a.smtp_status ?? '—') ~ (a.diagnostic_code ? ' · ' ~ a.diagnostic_code : '') ~ (a.diagnostic_text ? ' ' ~ a.diagnostic_text : '') ~ (a.external_address_reference ? ' · ref ' ~ a.external_address_reference : '') ~ ' · checked ' ~ (a.checked_at|ts)) }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        {% endif %}
    </div>
    {{ ui.pager(page, 'addresses') }}
</section>
{% endblock %}
