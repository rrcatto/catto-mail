{% extends 'dashboard/layout.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
<h1>{{ title }}</h1>
<p>Endpoint: <code class="url">{{ endpoint.url }}</code></p>
<p class="caveat"><strong>Copy this signing secret now.</strong> It is shown only once and cannot be retrieved later; Smarthost stores it encrypted. If you lose it, rotate the secret.</p>
<p><code class="token secret">{{ secret }}</code></p>
<p><a href="{{ path('dashboard_client_webhooks', {clientId: client.id.toRfc4122}) }}">Back to webhooks</a></p>
{% endblock %}
