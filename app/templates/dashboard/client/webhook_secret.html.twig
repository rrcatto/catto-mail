{% extends 'dashboard/layout.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>{{ title }}</h1>
        <p class="sub">Endpoint: <code class="url">{{ endpoint.url }}</code></p>
    </div>
</div>
<div class="grid">
<section class="card card-accent g-col-4 xl:g-col-2" aria-labelledby="secret-h">
    <h2 id="secret-h">Signing secret</h2>
    <p class="caveat"><strong>Copy this signing secret now.</strong> It is shown only once and cannot be retrieved later; Smarthost stores it encrypted. If you lose it, rotate the secret.</p>
    <p class="raw"><code class="token secret">{{ secret }}</code></p>
    <div class="form-actions"><a class="btn" href="{{ path('dashboard_client_webhooks', {clientId: client.id.toRfc4122}) }}">Back to webhooks</a></div>
</section>
</div>
{% endblock %}
