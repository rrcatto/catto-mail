{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}{{ title }}{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>{{ title }}</h1>
        <p class="sub">Endpoint: {{ ui.copy(endpoint.url, 'the endpoint address') }}</p>
    </div>
</div>
<div class="grid">
<section class="card card-accent g-col-4 xl:g-col-2" aria-labelledby="secret-h">
    <h2 id="secret-h">Signing secret</h2>
    <p class="caveat"><strong>Copy this signing secret now.</strong> It is shown only this once; it is kept encrypted and cannot be shown again. If you lose it, make a new one (Rotate the secret).</p>
    {{ ui.copy(secret, 'the signing secret', true) }}
    <div class="form-actions"><a class="btn" href="{{ path('dashboard_client_webhooks', {clientId: client.id.toRfc4122}) }}">Back to webhooks</a></div>
</section>
</div>
{% endblock %}
