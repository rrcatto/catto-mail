{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Validation jobs{% endblock %}
{% block body %}
<div class="pagehead">
    <div>
        <h1>Validation jobs</h1>
        <p class="sub">The address lists your application submitted for validation, newest first. Validation estimates deliverability; it does not prove that a mailbox will accept a message.</p>
    </div>
</div>
<form method="get" class="filters" role="search" aria-label="Filter validation jobs">
    {{ ui.select('status', 'Status', label_options('validation_job_status'), filters.status) }}
    <label>External reference <input type="text" name="external_reference" value="{{ filters.external_reference }}"></label>
    <label>Submitted from <input type="date" name="from" value="{{ filters.from }}"></label>
    <label>to <input type="date" name="to" value="{{ filters.to }}"></label>
    <input type="hidden" name="sort" value="{{ listing.sort }}"><input type="hidden" name="dir" value="{{ listing.dir }}">
    <button type="submit">Apply</button>
    <a href="{{ path('dashboard_client_validation_jobs', {clientId: client.id.toRfc4122}) }}">Reset</a>
</form>
<section class="card card-flush" aria-labelledby="vj-h">
    <div class="card-head"><h2 id="vj-h">Jobs</h2><span class="muted small">Dates are days in {{ time_zone_label() }}</span></div>
    {% include 'dashboard/client/_validation_job_rows.html.twig' with {rows: page.rows} %}
</section>
{{ ui.pager(page, 'jobs') }}
{% endblock %}
