{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}API keys{% endblock %}
{% block body %}
{% set cid = client.id.toRfc4122 %}
{% set max = limits.limits|filter(l => l.column == 'max_api_keys')|first %}
<div class="pagehead">
    <div>
        <h1>API keys</h1>
        <p class="lead">{{ keys|filter(k => k.usable)|length }} usable key{{ keys|filter(k => k.usable)|length == 1 ? '' : 's' }} of at most {{ max.effective }}.{{ ui.tip('Your applications authenticate with these keys (Authorization: Bearer shk_…). Only a hash is stored: a key is shown once, when it is created. Revoked and expired keys fail with 401. To rotate without downtime: create the replacement, deploy it, check that its last-used time appears, then revoke the old key.') }}</p>
    </div>
    <div class="actionrow">
        <a class="btn btn-secondary" href="{{ path('docs_api') }}">API reference</a>
        {% if may_manage and client.status.value != 'closed' %}
        <details class="actionform"><summary class="btn">Create an API key</summary>
            <form method="post" action="{{ path('dashboard_client_api_key_create', {clientId: cid}) }}" class="stack">
                {{ ui.csrf() }}
                <label>Descriptive name <input type="text" name="name" maxlength="100" placeholder="e.g. production server, rotation 2026-10"></label>
                <label>Expires after (optional; the key stops working at the end of that day, {{ time_zone_abbreviation() }}) <input type="date" name="expires_on"></label>
                <button type="submit">Create key (shown once)</button>
            </form>
        </details>
        {% endif %}
    </div>
</div>
{% set usable = keys|filter(k => k.usable) %}{% set old = keys|filter(k => not k.usable) %}
<section class="card card-flush" aria-labelledby="keys-h">
    <div class="card-head"><h2 id="keys-h">Keys</h2>{% if not may_manage %}{{ ui.tip('Client admins create and revoke keys.') }}{% endif %}</div>
    {% if usable is empty %}<p class="empty">No usable API key yet.</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">Name</th><th scope="col">Key</th><th scope="col">Last used</th><th scope="col">Expires</th>{% if may_manage %}<th scope="col"><span class="sr">Action</span></th>{% endif %}</tr></thead>
        <tbody>{% for k in usable %}<tr><td><strong>{{ k.name ?? '—' }}</strong></td><td><code>{{ k.key_prefix }}…</code></td><td>{{ k.last_used_at ? k.last_used_at|when : 'never' }}</td><td>{{ k.expires_at ? k.expires_at|when : 'never' }}</td>
            {% if may_manage %}<td><form method="post" action="{{ path('dashboard_client_api_key_revoke', {clientId: cid, keyId: k.id}) }}" class="inline" data-controller="confirm" data-confirm-message-value="Revoke {{ k.key_prefix }}…? Requests with it fail at once.">{{ ui.csrf() }}<button type="submit" class="secondary">Revoke</button></form></td>{% endif %}</tr>{% endfor %}</tbody>
    </table></div>
    {% endif %}
    {% if old is not empty %}<details class="card-foot"><summary>{{ old|length }} revoked or expired key{{ old|length == 1 ? '' : 's' }}</summary>
        <div class="scroll"><table class="list"><tbody>{% for k in old %}<tr><td>{{ k.name ?? '—' }}</td><td><code>{{ k.key_prefix }}…</code></td><td>{{ k.revoked_at ? 'revoked ' ~ k.revoked_at|when : 'expired ' ~ k.expires_at|when }}</td></tr>{% endfor %}</tbody></table></div></details>{% endif %}
</section>
{% endblock %}
