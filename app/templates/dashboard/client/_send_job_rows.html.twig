{# Send job rows (the job list, inside a card-flush card). Variables: rows, listing (or null).
   The result says what became of the messages in words; the times are behind ⓘ. #}
{% import 'dashboard/_macros.html.twig' as ui %}
{% if rows is empty %}<p class="empty">No send jobs match.</p>{% else %}
<div class="scroll">
<table class="list">
    <thead><tr>
        <th scope="col">{% if listing %}{{ ui.sort(listing, 'created', 'Created') }}{% else %}Created{% endif %}</th>
        <th scope="col">Reference</th>
        <th scope="col" class="num">{% if listing %}{{ ui.sort(listing, 'recipients', 'Recipients') }}{% else %}Recipients{% endif %}</th>
        <th scope="col">Status</th>
        <th scope="col">Result</th>
        <th scope="col"><span class="sr">Details</span></th>
    </tr></thead>
    <tbody>
    {% for j in rows %}
        {% set c = j.summary_counts_json|json_counts %}
        {% set acc = c.remote_accepted ?? 0 %}
        {% set fly = (c.created ?? 0) + (c.queued ?? 0) + (c.submitted ?? 0) + (c.deferred ?? 0) + (c.outcome_unknown ?? 0) %}
        {% set bad = (c.soft_bounced ?? 0) + (c.hard_bounced ?? 0) + (c.complained ?? 0) + (c.failed ?? 0) %}
        {% set sup = c.suppressed ?? 0 %}
        <tr>
            <td class="nowrap"><a href="{{ path('dashboard_client_send_job', {clientId: client.id.toRfc4122, jobId: j.id}) }}" title="{{ j.created_at|ts }}">{{ j.created_at|when }}</a></td>
            <td>{{ j.external_reference ?: '—' }} <span class="muted small">{{ j.message_class }}</span></td>
            <td class="num">{{ j.total_recipients|number_format }}</td>
            <td>{{ ui.status(j.status, 'send_job_status') }}</td>
            <td>{% if acc + fly + bad + sup == 0 %}<span class="muted">—</span>
                {% elseif fly + bad + sup == 0 %}<span class="rate-ok">all accepted</span>
                {% else %}{% set parts = [] %}{% if acc %}{% set parts = parts|merge([acc|number_format ~ ' accepted']) %}{% endif %}{% if fly %}{% set parts = parts|merge([fly|number_format ~ ' in flight']) %}{% endif %}{% if bad %}{% set parts = parts|merge([bad|number_format ~ ' bounced or failed']) %}{% endif %}{% if sup %}{% set parts = parts|merge([sup|number_format ~ ' suppressed']) %}{% endif %}{{ parts|join(' · ') }}{% endif %}</td>
            <td class="tipcell">{{ ui.tip('Queued ' ~ (j.queued_at|ts) ~ ' · dispatched ' ~ (j.dispatch_completed_at|ts) ~ ' · completed ' ~ (j.completed_at|ts)) }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% endif %}
