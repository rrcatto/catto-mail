{% extends 'dashboard/layout.html.twig' %}
{% import 'dashboard/_macros.html.twig' as ui %}
{% block title %}Sending domains{% endblock %}
{% block body %}
{% set cid = client.id.toRfc4122 %}
{% set stage_label = {added: 'Step 1: prove it is yours', verified: 'Step 2: signing key', key_requested: 'Step 2: signing key being made',
    key_failed: 'Step 2: signing key not made', pending_dns: 'Step 2: publish the signing key', activating: 'Step 3: switching on signing', active: 'Ready to send',
    dkim_disabled: 'Signing switched off', disabled: 'Disabled'} %}
{% set stage_class = {added: 'pending', verified: 'pending', key_requested: 'pending', key_failed: 'failed', pending_dns: 'pending',
    activating: 'pending', active: 'active', dkim_disabled: 'disabled', disabled: 'disabled'} %}
<div class="pagehead">
    <div>
        <h1>Sending domains</h1>
        <p class="lead">Your messages come from these domains. {{ domains|length }} of at most {{ max_domains }}.{{ ui.tip('Each domain goes through three steps: prove it is yours, publish its signing key, ready to send. Open a domain to see its next step.') }}</p>
    </div>
    {% if may_admin and may_add and domains|length < max_domains %}<div class="actions"><a class="btn" href="{{ path('dashboard_client_domain_new', {clientId: cid}) }}">Add a domain</a></div>{% endif %}
</div>
{% if not client.mayCreateWork %}<p class="warn">This account is {{ client.status.value|label('client_status')|lower }}, so nothing new is sent at the moment.</p>{% endif %}
<section class="card card-flush" aria-labelledby="dom-h">
    <div class="card-head"><h2 id="dom-h">Domains</h2></div>
    {% if domains is empty %}<p class="empty">No sending domain yet.{% if may_admin and may_add %} <a href="{{ path('dashboard_client_domain_new', {clientId: cid}) }}">Add your domain</a>.{% endif %}</p>{% else %}
    <div class="scroll"><table class="list">
        <thead><tr><th scope="col">Domain</th><th scope="col">Where it stands</th><th scope="col">Last looked</th></tr></thead>
        <tbody>
        {% for d in domains %}
            <tr>
                <td><a href="{{ path('dashboard_client_domain', {clientId: cid, domainId: d.id}) }}"><strong>{{ d.domain }}</strong></a></td>
                <td><span class="st st-{{ stage_class[d.stage] }}">{{ stage_label[d.stage] }}</span></td>
                <td>{{ d.last_checked_at ? d.last_checked_at|when : '—' }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table></div>
    {% endif %}
</section>
{% endblock %}
