{# What every HTML page carries (owner decision, 2026-10-10): the software name and version in the
   head, and the footer saying what the application is, how to reach the administrator
   (APP_ADMIN_EMAIL), which time zone the times are in and a link to the acceptable use policy; and
   the stylesheets. Used by the dashboard layout, the front page, the error page, the API documentation,
   the policy page and the re-permission page. #}
{% macro application_meta() %}<meta name="application-name" content="catto-mail v{{ app_version() }}">{% endmacro %}

{# Bootstrap 6 is the base (owner decision, 2026-10-10): its compiled CSS sits in cascade layers, so
   the application's stylesheet, loaded after it and unlayered, always takes precedence. #}
{% macro stylesheets() %}<link rel="stylesheet" href="{{ asset('vendor/bootstrap/dist/css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">{% endmacro %}

{# with_contact false: the acceptable use policy page, which names one address only, abuse@ the
   installation's domain, and never the administrator's (owner decision, 2026-10-12). #}
{% macro footer(with_contact = true) %}
{% set admin = admin_email() %}
<footer class="sitefoot">
    <p><strong>catto-mail v{{ app_version() }}</strong> · Self-hosted email validation and tracked delivery, with bounce, complaint and suppression handling, for the client applications of this installation.</p>
    {% if with_contact %}<p>Questions about this service or the mail it sends, sign-in problems or access requests: {% if admin %}email the administrator at <a href="mailto:{{ admin }}">{{ admin }}</a>.{% else %}contact the administrator of this installation.{% endif %}</p>{% endif %}
    <p>Times are shown in {{ time_zone_label() }}.</p>
    <p><a href="{{ path('acceptable_use_policy') }}">Acceptable use policy</a></p>
</footer>
{% endmacro %}
