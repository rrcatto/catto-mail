    {
      "name": "BACKUP_KEEP",
      "label": "Backups kept",
      "kind": "integer",
      "min": 1,
      "max": 1000,
      "production_only": true,
      "group": "Backups"
    },
    {
      "name": "BACKUP_SCHEDULE",
      "label": "Backup time (systemd calendar, e.g. *-*-* 03:15:00)",
      "kind": "text",
      "pattern": "^[A-Za-z0-9*:.,/ -]{1,60}$",
      "production_only": true,
      "group": "Backups"
