      "kind": "integer",
      "min": 1,
      "max": 8760,
      "group": "API and client limits"
    },
    {
      "name": "APP_ACCEPTABLE_USE_POLICY_VERSION",
      "label": "Acceptable-use policy version clients must accept (empty = none)",
      "kind": "text",
      "pattern": "^([A-Za-z0-9][A-Za-z0-9._-]{0,63})?$",
      "group": "API and client limits"
    },
    {
      "name": "APP_REPERMISSION_RESPONSE_DAYS",
      "label": "Days a re-permission link stays valid",
      "kind": "integer",
      "min": 1,
      "max": 365,
      "group": "API and client limits"
    },
    {
      "name": "APP_WEBHOOK_MAX_ATTEMPTS",
      "label": "Delivery attempts per event",
      "kind": "integer",
      "min": 1,
      "max": 100,
      "group": "Webhooks"
    },
    {
      "name": "APP_WEBHOOK_TIMEOUT_SECONDS",
      "label": "Request timeout (seconds)",
      "kind": "integer",
      "min": 1,
      "max": 120,
      "group": "Webhooks"
    },
    {
      "name": "APP_WEBHOOK_CONNECT_TIMEOUT_SECONDS",
      "label": "Connect timeout (seconds, at most the request timeout)",
      "kind": "integer",
      "min": 1,
      "max": 120,
      "group": "Webhooks"
    },
    {
      "name": "APP_WEBHOOK_POLL_INTERVAL_SECONDS",
      "label": "Poll interval (seconds)",
      "kind": "integer",
      "min": 1,
      "max": 3600,
      "group": "Webhooks"
    },
    {
      "name": "APP_WEBHOOK_LEASE_SECONDS",
      "label": "Lease on a claimed delivery (seconds)",
      "kind": "integer",
      "min": 5,
      "max": 86400,
      "group": "Webhooks"
    },
    {
      "name": "APP_WEBHOOK_RETRY_BASE_SECONDS",
      "label": "First retry delay (seconds)",
      "kind": "integer",
      "min": 1,
      "max": 86400,
      "group": "Webhooks"
    },
    {
      "name": "APP_WEBHOOK_RETRY_MAX_SECONDS",
      "label": "Longest retry delay (seconds)",
      "kind": "integer",
      "min": 1,
      "max": 604800,
      "group": "Webhooks"
    },
    {
      "name": "APP_WEBHOOK_SECRET_OVERLAP_HOURS",
      "label": "Hours the previous signing secret stays valid",
      "kind": "integer",
      "min": 0,
      "max": 720,
      "group": "Webhooks"
    },
    {
      "name": "APP_REPUTATION_MIN_MESSAGES",
      "label": "Messages a client needs before rates are judged",
      "kind": "integer",
      "min": 1,
      "max": 1000000,
      "group": "Reputation alerts"
    },
    {
