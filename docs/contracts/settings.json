      "group": "Reputation alerts"
    },
    {
      "name": "APP_REPUTATION_VOLUME_INCREASE_WARNING_FACTOR",
      "label": "Volume increase warning (times the usual)",
      "kind": "decimal",
      "min": 1,
      "max": 1000,
      "group": "Reputation alerts"
    },
    {
      "name": "APP_REPUTATION_VOLUME_INCREASE_CRITICAL_FACTOR",
      "label": "Volume increase critical (times the usual)",
      "kind": "decimal",
      "min": 1,
      "max": 1000,
      "group": "Reputation alerts"
    },
    {
      "name": "APP_RETENTION_STAGED_CONTENT_DAYS",
      "label": "Days unsent message content is kept",
      "kind": "integer",
      "min": 1,
      "max": 3650,
      "group": "Data retention"
    },
    {
      "name": "APP_RETENTION_TRACKING_DAYS",
      "label": "Days tracking links stay valid (empty = always)",
      "kind": "integer",
      "min": 1,
      "max": 3650,
      "empty": true,
      "group": "Data retention"
    },
    {
      "name": "DELIVERY_DSN_RETENTION_DAYS",
      "label": "Days processed bounce files are kept",
      "kind": "integer",
      "min": 1,
      "max": 3650,
      "group": "Data retention"
    },
    {
      "name": "POSTFIX_LOG_RETENTION_DAYS",
      "label": "Days rotated Postfix logs are kept",
      "kind": "integer",
      "min": 1,
      "max": 3650,
      "group": "Data retention"
    },
    {
      "name": "ACME_RENEW_DAYS",
